[Description("Interfaz interna: ucList notifica a su propietario (ucSelect)")]
Class IUcListNotify

    '-------------------------
    ' Interfaz usada por ucList para avisar directamente a un control que lo
    ' contiene (ucSelect) de ItemClick (EventId = 1) e IndexChange (EventId = 2).
    ' Se implementa con: Implements IUcListNotify
    '-------------------------

    Option Explicit

    Public Sub ListNotify(ByVal EventId As Long)
    End Sub

End Class
