    Private Const DT_VCENTER        As Long = &H4
    Private Const DT_CENTER         As Long = &H1
    Private Const DT_RIGHT          As Long = &H2
    Private Const DT_WORD_ELLIPSIS  As Long = &H40000
    Private Const DT_CALCRECT       As Long = &H400
    Private Const DT_NOPREFIX       As Long = &H800

    Private Const LOGPIXELSY        As Long = 90
    Private Const FW_BOLD           As Long = 700
    Private Const TRANSPARENT_BK    As Long = 1
    Private Const OBJ_BITMAP        As Long = 7
    Private Const GMEM_MOVEABLE     As Long = &H2
    Private Const SmoothingModeAntiAlias As Long = 4
    Private Const UnitPixel         As Long = 2
    Private Const PixelFormat32bppPARGB As Long = &HE200B
    Private Const CombineModeIntersect As Long = 1
    Private Const LinearGradientModeVertical As Long = 1
    Private Const WrapModeTileFlipXY As Long = 3

    ' uxtheme - SCROLLBAR
    Private Const SBP_ARROWBTN          As Long = 1
    Private Const SBP_THUMBBTNVERT      As Long = 3
    Private Const SBP_LOWERTRACKVERT    As Long = 5
    Private Const SBP_GRIPPERVERT       As Long = 9
    Private Const ABS_UPNORMAL          As Long = 1
    Private Const ABS_DOWNNORMAL        As Long = 5
    Private Const DFC_SCROLL            As Long = 3
    Private Const DFCS_SCROLLUP         As Long = &H0
    Private Const DFCS_SCROLLDOWN       As Long = &H1
    Private Const DFCS_PUSHED           As Long = &H200
    Private Const EDGE_RAISED           As Long = &H5
    Private Const BF_RECT_MIDDLE        As Long = &H80F

    ' Partes de la barra de desplazamiento
    Private Const SBP_NONE      As Long = 0
    Private Const SBP_UP        As Long = 1
    Private Const SBP_DOWN      As Long = 2
    Private Const SBP_PAGEUP    As Long = 3
    Private Const SBP_PAGEDOWN  As Long = 4
    Private Const SBP_THUMB     As Long = 5

    '======================================================================
    ' Estado
    '======================================================================
    ' Propiedades
    Private m_ListStyle         As eListStyle
    Private m_SubTitleVisible   As Boolean
    Private m_ShowFilter        As Boolean
    Private m_ItemHeight        As Long
    Private m_MaxListHeight     As Long
    Private m_MaxVisibleItems   As Long
    Private m_ListWidth         As Long
    Private m_ListDesign        As eListDesign
    Private m_MultiSelect       As Boolean
    Private m_UseMonocromeIcons As Boolean
    Private m_BorderRadius      As Long
    Private m_BorderColor       As OLE_COLOR
    Private m_DrawSeparatorLine As Boolean
    Private m_ImagesRadius      As Long
    Private m_SelectionRadius   As Long
    Private m_FindTextColor     As OLE_COLOR
    Private m_SelectionColor    As OLE_COLOR
    Private m_LineColor         As OLE_COLOR
    Private m_BorderVisible     As Boolean

    ' Elementos
    Private m_Items()           As tItem
    Private mListCount          As Long
    Private m_Index             As Long
    Private m_HotItem           As Long
    Private GroupIsOpen         As Boolean
    Private VisibleItemsCount   As Long
    Private m_Filter            As String

    ' Medidas (pixeles)
    Private DpiFactor           As Single
    Private IH                  As Long     'alto de elemento
    Private BR                  As Long     'radio del borde
    Private lMargin             As Long
    Private lCheckSize          As Long
    Private ListTop             As Long     'alto de la cabecera
    Private ListHeight          As Long     'alto util de la lista
    Private m_ClientW           As Long
    Private m_ClientH           As Long
    Private m_EditL             As Long
    Private m_EditT             As Long
    Private m_EditW             As Long
    Private m_EditH             As Long
    Private m_LayoutDirty       As Boolean

    ' Barra de desplazamiento interna
    Private sbVisible       As Boolean
    Private sbLeft          As Long
    Private sbTop           As Long
    Private sbWidth         As Long
    Private sbHeight        As Long
    Private sbValue         As Long
    Private sbMax           As Long
    Private sbSmall         As Long
    Private sbLarge         As Long
    Private sbWheel         As Long
    Private sbButtons       As Boolean
    Private sbThemed        As Boolean
    Private sbHot           As Long
    Private sbPressed       As Long
    Private sbDragOffset    As Long
    Private sbRepeating     As Boolean

    ' Ventanas
    Private m_hList         As LongPtr  'ventana de la lista (hija o emergente)
    Private m_bPopupWnd     As Boolean  'm_hList es emergente
    Private m_hOwner        As LongPtr  'formulario propietario de la emergente
    Private m_hOwnerSub     As LongPtr  'formulario subclasificado mientras esta abierta
    Private m_hPrevFocus    As LongPtr  'ventana con el foco al abrir la emergente
    Private m_hEdit         As LongPtr  'filtro
    Private m_hUC           As LongPtr  'UserControl.hWnd subclasificado
    Private m_hSrc          As LongPtr  'TextBox de AutoCompleteTextBox
    Private m_rcSrcOffset   As RECT
    Private m_SrcLastText   As String
    Private m_bSettingSrc   As Boolean
    Private m_bSettingEdit  As Boolean
    Private m_hEditBrush    As LongPtr
    Private m_EditBrushColor As Long

    ' Fuentes
    Private m_hFontBold     As LongPtr
    Private m_hFontSmall    As LongPtr
    Private m_hFontArrow    As LongPtr
    Private m_hFontCheck    As LongPtr
    Private m_hFontGlass    As LongPtr
    Private isSegoeFontInstaled As Boolean
    Private m_TextHeight    As Long

    ' Estado de la lista emergente
    Private bShow           As Boolean
    Private m_ShowGen       As Long
    Private m_BtnTop        As Long
    Private m_SubPending    As Long     '>=0: abrir submenu de ese elemento; -2: cerrar el submenu abierto

    ' Raton / teclado
    Private bMouseDown      As Boolean
    Private bTracking       As Boolean
    Private bHasFocus       As Boolean
    Private m_EditSkipChar  As Boolean
    Private m_LastKeyTime   As Long
    Private m_LastKeyCode   As Long
    Private m_KeySwallowed(0 To 255) As Boolean

    ' Imagenes
    Private cImageList      As Collection
    Private ImgLstWidth     As Long
    Private ImgLstHeight    As Long

    Private cShadow         As ClsShadow

    ' Menus (publicos en el original)
    Public ParentMenu       As ucList
    Public ChildMenu        As ucList

    '======================================================================
    ' Ciclo de vida del UserControl
    '======================================================================
    Private Sub UserControl_Initialize()
        UCL_GdipStart
        Set cImageList = New Collection
        Set cShadow = New ClsShadow
        DpiFactor = cShadow.GetWindowsDPI
        lMargin = 8 * DpiFactor
        lCheckSize = 16 * DpiFactor
        m_Index = -1
        m_HotItem = -1
        m_SubPending = -1
        ReDim m_Items(0)
        m_LayoutDirty = True
    End Sub

    Private Sub UserControl_InitProperties()
        m_ListWidth = 250
        Me.ItemHeight = 32
        Me.BorderRadius = 10
        m_SelectionColor = vbHighlight
        m_LineColor = vbActiveBorder
        m_BorderColor = vbActiveBorder
        m_FindTextColor = vbHighlight
        m_BorderVisible = True
        cShadow.BackColor = UserControl.BackColor
        cShadow.BorderColor = m_BorderColor
        BuildFonts

        If Ambient.UserMode Then
            ' Creado sin propiedades guardadas: lista desplegable vacia y oculta.
            UserControl.Extender.Visible = False
            EnsureRuntime
        Else
            DesignRender
        End If
    End Sub

    Private Sub UserControl_ReadProperties(PropBag As PropertyBag)
        With PropBag
            Set UserControl.Font = .ReadProperty("Font", Ambient.Font)
            m_SubTitleVisible = .ReadProperty("SubTitleVisible", False)
            m_ShowFilter = .ReadProperty("ShowFilter", False)
            m_ItemHeight = .ReadProperty("ItemHeight", 32)
            m_MaxListHeight = .ReadProperty("MaxListHeight", 0)
            m_ListWidth = .ReadProperty("ListWidth", 250)
            m_ListDesign = .ReadProperty("ListDesign", GoogleDesign)
            m_MultiSelect = .ReadProperty("MultiSelect", False)
            m_UseMonocromeIcons = .ReadProperty("UseMonocromeIcons", False)
            m_BorderRadius = .ReadProperty("BorderRadius", 10)
            m_DrawSeparatorLine = .ReadProperty("DrawSeparatorLine", False)
            m_ImagesRadius = .ReadProperty("ImagesRadius", 0)
            m_SelectionRadius = .ReadProperty("SelectionRadius", 0)
            UserControl.BackColor = .ReadProperty("BackColor", UserControl.BackColor)
            m_FindTextColor = .ReadProperty("FindTextColor", vbHighlight)
            m_SelectionColor = .ReadProperty("SelectionColor", vbHighlight)
            m_MaxVisibleItems = .ReadProperty("MaxVisibleItems", 0)
            m_LineColor = .ReadProperty("LineColor", vbActiveBorder)
            m_BorderColor = .ReadProperty("BorderColor", vbActiveBorder)
            m_BorderVisible = .ReadProperty("BorderVisible", True)
            UserControl.Enabled = .ReadProperty("Enabled", True)
            m_ListStyle = .ReadProperty("ListStyle", StyleDropDown)
            UserControl.OLEDropMode = .ReadProperty("OLEDropMode", OLEDropModeNone)
            UserControl.MousePointer = .ReadProperty("MousePointer", vbDefault)
            Set UserControl.MouseIcon = .ReadProperty("MouseIcon", Nothing)
        End With

        If m_ItemHeight < 1 Then m_ItemHeight = 1
        IH = m_ItemHeight * DpiFactor
        BR = m_BorderRadius * DpiFactor
        cShadow.BorderRadius = m_BorderRadius
        cShadow.BackColor = UserControl.BackColor
        cShadow.BorderColor = m_BorderColor
        BuildFonts
        m_LayoutDirty = True

        If Ambient.UserMode Then
            If m_ListStyle <> StyleListBox Then UserControl.Extender.Visible = False
            EnsureRuntime
        Else
            DesignRender
        End If
    End Sub

    Private Sub UserControl_WriteProperties(PropBag As PropertyBag)
        With PropBag
            .WriteProperty "Font", UserControl.Font, Ambient.Font
            .WriteProperty "SubTitleVisible", m_SubTitleVisible, False
            .WriteProperty "ShowFilter", m_ShowFilter, False
            .WriteProperty "ItemHeight", m_ItemHeight, 32
            .WriteProperty "MaxListHeight", m_MaxListHeight, 0
            .WriteProperty "ListWidth", m_ListWidth, 250
            .WriteProperty "ListDesign", m_ListDesign, GoogleDesign
            .WriteProperty "MultiSelect", m_MultiSelect, False
            .WriteProperty "UseMonocromeIcons", m_UseMonocromeIcons, False
            .WriteProperty "BorderRadius", m_BorderRadius, 10
            .WriteProperty "DrawSeparatorLine", m_DrawSeparatorLine, False
            .WriteProperty "ImagesRadius", m_ImagesRadius, 0
            .WriteProperty "SelectionRadius", m_SelectionRadius, 0
            .WriteProperty "BackColor", UserControl.BackColor
            .WriteProperty "FindTextColor", m_FindTextColor, vbHighlight
            .WriteProperty "SelectionColor", m_SelectionColor, vbHighlight
            .WriteProperty "MaxVisibleItems", m_MaxVisibleItems, 0
            .WriteProperty "LineColor", m_LineColor, vbActiveBorder
            .WriteProperty "BorderColor", m_BorderColor, vbActiveBorder
            .WriteProperty "BorderVisible", m_BorderVisible, True
            .WriteProperty "Enabled", UserControl.Enabled, True
            .WriteProperty "ListStyle", m_ListStyle, StyleDropDown
            .WriteProperty "OLEDropMode", UserControl.OLEDropMode, OLEDropModeNone
            .WriteProperty "MousePointer", UserControl.MousePointer, vbDefault
            .WriteProperty "MouseIcon", UserControl.MouseIcon, Nothing
        End With
    End Sub

    Private Sub UserControl_Show()
        If Ambient.UserMode Then
            EnsureRuntime
            If m_ListStyle = StyleListBox And m_BorderVisible Then ShowListBoxBorder
        Else
            DesignRender
        End If
    End Sub

    Private Sub UserControl_Hide()
        If m_ListStyle = StyleListBox Then cShadow.HideBorders
    End Sub

    Private Sub UserControl_Resize()
        Dim rc As RECT
        If Ambient.UserMode Then
            If m_ListStyle = StyleListBox And m_hList <> 0 And Not m_bPopupWnd Then
                GetClientRect UserControl.hWnd, rc
                MoveWindow m_hList, 0, 0, rc.Right, rc.Bottom, 1
                ApplyRegion UserControl.hWnd, rc.Right, rc.Bottom
                m_LayoutDirty = True
                InvalidateRect m_hList, 0, 0
            End If
        Else
            ' En diseno no se fuerza el tamano: los formularios sin propiedades
            ' guardadas (estilo por codigo) conservan su geometria.
            DesignRender
        End If
    End Sub

    Private Sub UserControl_EnterFocus()
        ' El foco del UserControl pasa a la ventana de la lista (o al filtro).
        If m_ListStyle = StyleListBox And m_hList <> 0 Then SetFocusAPI FocusTarget()
    End Sub

    Private Sub UserControl_AmbientChanged(PropertyName As String)
        If PropertyName = "BackColor" Then
            cShadow.ContainerBkColor = Ambient.BackColor
            If m_ListStyle = StyleListBox And m_BorderVisible Then cShadow.Refresh
        End If
    End Sub

    Private Sub UserControl_KeyDown(KeyCode As Integer, Shift As Integer)
        ' Solo si el host entrega aqui la tecla en lugar de a la ventana de la
        ' lista; se evita procesar dos veces el mismo mensaje.
        If KeyAlreadyHandled(KeyCode) Then Exit Sub
        HandleKeyDownWithEvent KeyCode, Shift
    End Sub

    Private Sub UserControl_KeyUp(KeyCode As Integer, Shift As Integer)
        RaiseEvent KeyUp(KeyCode, Shift)
    End Sub

    Private Sub UserControl_KeyPress(KeyAscii As Integer)
        If KeyAlreadyHandled(-CLng(KeyAscii)) Then Exit Sub
        KeyPressLogic KeyAscii
    End Sub

    Private Sub UserControl_DblClick()
        RaiseEvent DblClick
    End Sub

    Private Sub UserControl_Terminate()
        Dim i As Long
        On Error Resume Next
        If bShow Then HideList
        DestroyRuntime
        If Not cImageList Is Nothing Then
            For i = 1 To cImageList.Count
                GdipDisposeImage CLngPtr(cImageList(i))
            Next
        End If
        Set cImageList = Nothing
        FreeFonts
        Set ParentMenu = Nothing
        Set ChildMenu = Nothing
        Set cShadow = Nothing
        UCL_GdipStop
    End Sub

    '======================================================================
    ' OLE (del UserControl, como el original)
    '======================================================================
    Private Sub UserControl_OLECompleteDrag(Effect As Long)
        RaiseEvent OLECompleteDrag(Effect)
    End Sub

    Private Sub UserControl_OLEDragDrop(Data As DataObject, Effect As Long, Button As Integer, Shift As Integer, X As Single, Y As Single)
        RaiseEvent OLEDragDrop(Data, Effect, Button, Shift, UserControl.ScaleX(X, vbPixels, vbContainerPosition), UserControl.ScaleY(Y, vbPixels, vbContainerPosition))
    End Sub

    Private Sub UserControl_OLEDragOver(Data As DataObject, Effect As Long, Button As Integer, Shift As Integer, X As Single, Y As Single, State As Integer)
        RaiseEvent OLEDragOver(Data, Effect, Button, Shift, UserControl.ScaleX(X, vbPixels, vbContainerPosition), UserControl.ScaleY(Y, vbPixels, vbContainerPosition), State)
    End Sub

    Private Sub UserControl_OLEGiveFeedback(Effect As Long, DefaultCursors As Boolean)
        RaiseEvent OLEGiveFeedback(Effect, DefaultCursors)
    End Sub

    Private Sub UserControl_OLESetData(Data As DataObject, DataFormat As Integer)
        RaiseEvent OLESetData(Data, DataFormat)
    End Sub

    Private Sub UserControl_OLEStartDrag(Data As DataObject, AllowedEffects As Long)
        RaiseEvent OLEStartDrag(Data, AllowedEffects)
    End Sub

    Public Sub OLEDrag()
        UserControl.OLEDrag
    End Sub

    '======================================================================
    ' Ventanas en tiempo de ejecucion
    '======================================================================
    Private Sub EnsureRuntime()
        If Not Ambient.UserMode Then Exit Sub
        If m_hUC = 0 Then
            If UserControl.hWnd <> 0 Then
                If UCL_SubclassList(UserControl.hWnd, ObjPtr(Me)) Then m_hUC = UserControl.hWnd
            End If
        End If
        If m_ListStyle = StyleListBox Then
            If m_hList <> 0 And m_bPopupWnd Then DestroyListWindow
            If m_hList = 0 Then CreateListWindow False
        Else
            If m_hList <> 0 And Not m_bPopupWnd Then DestroyListWindow
        End If
    End Sub

    Private Sub DestroyRuntime()
        DestroyListWindow
        SetSourceTextBox 0
        If m_hUC <> 0 Then
            UCL_UnsubclassList m_hUC, ObjPtr(Me)
            m_hUC = 0
        End If
    End Sub

    Private Function CreateListWindow(ByVal bPopup As Boolean) As Boolean
        Dim sClass As String
        Dim rc As RECT
        If Not UCL_RegisterClass(App.hInstance) Then Exit Function
        sClass = UCL_CLASSNAME
        If bPopup Then
            m_hOwner = GetAncestor(UserControl.ContainerHwnd, GA_ROOT)
            m_hList = CreateWindowExW(WS_EX_TOOLWINDOW Or WS_EX_TOPMOST Or WS_EX_NOACTIVATE, StrPtr(sClass), 0, _
                                      WS_POPUP Or WS_CLIPCHILDREN, 0, 0, 10, 10, m_hOwner, 0, App.hInstance, 0)
        Else
            GetClientRect UserControl.hWnd, rc
            m_hList = CreateWindowExW(0, StrPtr(sClass), 0, WS_CHILD Or WS_VISIBLE Or WS_CLIPCHILDREN Or WS_CLIPSIBLINGS, _
                                      0, 0, rc.Right, rc.Bottom, UserControl.hWnd, 0, App.hInstance, 0)
        End If
        If m_hList = 0 Then Exit Function
        m_bPopupWnd = bPopup
        UCL_SubclassList m_hList, ObjPtr(Me)
        If Not UserControl.Enabled Then EnableWindow m_hList, 0
        EnsureEdit
        m_LayoutDirty = True
        If Not bPopup Then
            ApplyRegion UserControl.hWnd, rc.Right, rc.Bottom
            Layout
            InvalidateRect m_hList, 0, 0
        End If
        CreateListWindow = True
    End Function

    Private Sub DestroyListWindow()
        If m_hList = 0 Then Exit Sub
        KillTimer m_hList, TIMER_SUBMENU
        KillTimer m_hList, TIMER_SCROLL
        If GetCapture() = m_hList Then ReleaseCapture
        If m_hEdit <> 0 Then
            UCL_UnsubclassList m_hEdit, ObjPtr(Me)
            DestroyWindow m_hEdit
            m_hEdit = 0
        End If
        UCL_UnsubclassList m_hList, ObjPtr(Me)
        DestroyWindow m_hList
        m_hList = 0
        m_bPopupWnd = False
        If m_hEditBrush <> 0 Then DeleteObject m_hEditBrush: m_hEditBrush = 0
    End Sub

    ' Filtro: EDIT hijo de la ventana de la lista (solo si ShowFilter).
    Private Sub EnsureEdit()
        Dim sClass As String
        If m_hList = 0 Then Exit Sub
        If m_ShowFilter Then
            If m_hEdit = 0 Then
                sClass = "EDIT"
                m_hEdit = CreateWindowExW(0, StrPtr(sClass), 0, WS_CHILD Or WS_VISIBLE Or ES_AUTOHSCROLL Or ES_NOHIDESEL, _
                                          0, 0, 10, 10, m_hList, 0, App.hInstance, 0)
                If m_hEdit <> 0 Then
                    UCL_SubclassList m_hEdit, ObjPtr(Me)
                    ApplyEditFont
                End If
            End If
        ElseIf m_hEdit <> 0 Then
            If GetFocus() = m_hEdit Then SetFocusAPI m_hList
            UCL_UnsubclassList m_hEdit, ObjPtr(Me)
            DestroyWindow m_hEdit
            m_hEdit = 0
        End If
    End Sub

    Private Sub ApplyEditFont()
        Dim oFont As IFont
        If m_hEdit = 0 Then Exit Sub
        Set oFont = UserControl.Font
        SendMessageW m_hEdit, WM_SETFONT, oFont.hFont, 1
    End Sub

    Private Function FocusTarget() As LongPtr
        If m_hEdit <> 0 And m_ShowFilter Then
            FocusTarget = m_hEdit
        Else
            FocusTarget = m_hList
        End If
    End Function

    ' Borde y sombra del modo ListBox. La sombra es una ventana hija del
    ' contenedor: se le pasa su color de fondo para pintar lo que queda fuera
    ' del borde (sin esto se veria el fondo por defecto, blanco).
    Private Sub ShowListBoxBorder()
        On Error Resume Next
        cShadow.ContainerBkColor = Ambient.BackColor
        On Error GoTo 0
        cShadow.BackColor = UserControl.BackColor
        cShadow.ShowBorders UserControl.hWnd, True
    End Sub

    ' Region redondeada (como el original)
    Private Sub ApplyRegion(ByVal hWnd As LongPtr, ByVal W As Long, ByVal H As Long)
        If hWnd = 0 Or W <= 0 Or H <= 0 Then Exit Sub
        SetWindowRgn hWnd, CreateRoundRectRgn(0, 0, W + 1, H + 1, BR, BR), 1
    End Sub

    '======================================================================
    ' Metodos publicos: elementos
    '======================================================================
    Public Function AddItem(Optional ByVal Text As String, Optional ByVal Icon As Long = -1, Optional ByVal ItemData As Variant, Optional ByVal SubText As String, Optional Checked As Boolean, Optional Disabled As Boolean, Optional ByVal Index As Long = -1)
        Dim i As Long
        ReDim Preserve m_Items(mListCount)

        If Index > -1 And Index < mListCount Then
            For i = mListCount To Index + 1 Step -1
                m_Items(i) = m_Items(i - 1)
            Next
            If m_Index >= Index Then m_Index = m_Index + 1
        Else
            Index = mListCount
        End If

        With m_Items(Index)
            .Text = Text
            .Icon = Icon
            If IsObject(ItemData) Then Set .Data = ItemData Else .Data = ItemData
            .SubText = SubText
            .Separator = (Text = "-")
            .Checked = Checked
            .IsChild = GroupIsOpen
            .IsGroup = False
            .Disabled = Disabled
            .Visible = True
            Set .SubMenu = Nothing
            .TextColor = CLR_NONE
            .SubTextColor = CLR_NONE
            .BackColor = CLR_NONE
            .ItemBold = False
        End With
        mListCount = mListCount + 1
        ItemsChanged
    End Function

    Public Sub AddSubMenu(SubMenuTitle As String, GList As ucList, Optional ByVal Icon As Long = -1, Optional ByVal ItemData As Variant)
        AddItem SubMenuTitle, Icon, ItemData
        Set m_Items(mListCount - 1).SubMenu = GList
    End Sub

    Public Sub OpenGroup(GropuTitle As String, Optional ByVal Icon As Long = -1, Optional ByVal ItemData As Variant)
        GroupIsOpen = False
        AddItem GropuTitle, Icon, ItemData
        With m_Items(mListCount - 1)
            .IsGroup = True
            .Separator = False
        End With
        GroupIsOpen = True
    End Sub

    Public Sub CloseGroup()
        GroupIsOpen = False
    End Sub

    Public Function RemoveItem(Index As Long)
        Dim i As Long
        If Index < 0 Or Index > mListCount - 1 Then Exit Function
        For i = Index To mListCount - 2
            m_Items(i) = m_Items(i + 1)
        Next
        mListCount = mListCount - 1
        If mListCount > 0 Then
            ReDim Preserve m_Items(mListCount - 1)
        Else
            ReDim m_Items(0)
        End If
        If m_Index >= Index Then m_Index = m_Index - 1
        If m_Index > mListCount - 1 Then m_Index = mListCount - 1
        m_HotItem = -1
        ItemsChanged
    End Function

    Public Sub Clear()
        GroupIsOpen = False
        m_Index = -1
        m_HotItem = -1
        mListCount = 0
        ReDim m_Items(0)
        sbValue = 0
        ItemsChanged
    End Sub

    ' Marca la disposicion como pendiente y pide repintar (asincrono).
    Private Sub ItemsChanged()
        m_LayoutDirty = True
        If m_hList <> 0 Then
            InvalidateRect m_hList, 0, 0
        ElseIf Not Ambient.UserMode Then
            DesignRender
        End If
    End Sub

    Public Sub BSort(SortOrder As eSortOrder)
        Dim i As Long
        Dim bSwap As Boolean, Sorted As Boolean
        Dim Item As tItem
        If mListCount > 1 Then
            Do
                Sorted = True
                For i = 0 To mListCount - 2
                    If SortOrder = SortAscendant Then
                        bSwap = StrComp(m_Items(i).Text, m_Items(i + 1).Text, vbTextCompare) > 0
                    Else
                        bSwap = StrComp(m_Items(i).Text, m_Items(i + 1).Text, vbTextCompare) < 0
                    End If
                    If bSwap Then
                        Item = m_Items(i + 1)
                        m_Items(i + 1) = m_Items(i)
                        m_Items(i) = Item
                        Sorted = False
                    End If
                Next
            Loop Until Sorted
        End If
        m_LayoutDirty = True
        Redraw
    End Sub

    Public Sub QSort(SortOrder As eSortOrder)
        If mListCount > 1 Then QuickSort 0, mListCount - 1, (SortOrder = SortAscendant)
        m_LayoutDirty = True
        Redraw
    End Sub

    Private Sub QuickSort(ByVal First As Long, ByVal Last As Long, ByVal bAsc As Boolean)
        Dim Low As Long, High As Long
        Dim MidValue As String
        Dim Item As tItem
        Low = First
        High = Last
        MidValue = m_Items((First + Last) \ 2).Text
        Do
            If bAsc Then
                Do While StrComp(m_Items(Low).Text, MidValue, vbTextCompare) < 0
                    Low = Low + 1
                Loop
                Do While StrComp(MidValue, m_Items(High).Text, vbTextCompare) < 0
                    High = High - 1
                Loop
            Else
                Do While StrComp(MidValue, m_Items(Low).Text, vbTextCompare) < 0
                    Low = Low + 1
                Loop
                Do While StrComp(m_Items(High).Text, MidValue, vbTextCompare) < 0
                    High = High - 1
                Loop
            End If
            If Low <= High Then
                Item = m_Items(Low)
                m_Items(Low) = m_Items(High)
                m_Items(High) = Item
                Low = Low + 1
                High = High - 1
            End If
        Loop While Low <= High
        If First < High Then QuickSort First, High, bAsc
        If Low < Last Then QuickSort Low, Last, bAsc
    End Sub

    '======================================================================
    ' Propiedades de elementos
    '======================================================================
    Private Function ValidIndex(ByVal Index As Long) As Boolean
        If Index >= 0 And Index < mListCount Then
            ValidIndex = True
        Else
            Err.Raise 381       'indice de matriz de propiedades no valido
        End If
    End Function

    Public Property Get ItemIsChild(ByVal Index As Long) As Boolean
        If ValidIndex(Index) Then ItemIsChild = m_Items(Index).IsChild
    End Property

    Public Property Get ItemIsGroup(ByVal Index As Long) As Boolean
        If ValidIndex(Index) Then ItemIsGroup = m_Items(Index).IsGroup
    End Property

    Public Function GetItemParentGroup(ByVal Index As Long) As Long
        Dim i As Long
        If Not ValidIndex(Index) Then Exit Function
        If m_Items(Index).IsGroup Or Not m_Items(Index).IsChild Then
            GetItemParentGroup = Index
            Exit Function
        End If
        For i = Index To 0 Step -1
            If m_Items(i).IsGroup Then
                GetItemParentGroup = i
                Exit Function
            End If
        Next
        GetItemParentGroup = -1
    End Function

    Public Function GetGroupChildCounts(ByVal Index As Long) As Long
        Dim i As Long, lCount As Long
        If Not ValidIndex(Index) Then Exit Function
        If m_Items(Index).IsGroup And Index < mListCount - 1 Then
            For i = Index + 1 To mListCount - 1
                If m_Items(i).IsChild Then
                    lCount = lCount + 1
                Else
                    Exit For
                End If
            Next
            GetGroupChildCounts = lCount
        Else
            GetGroupChildCounts = -1
        End If
    End Function

    Public Property Let ItemText(ByVal Index As Long, ByVal New_Value As String)
        If ValidIndex(Index) Then
            m_Items(Index).Text = New_Value
            m_Items(Index).Separator = (New_Value = "-") And Not m_Items(Index).IsGroup
            m_LayoutDirty = True
            Redraw
        End If
    End Property

