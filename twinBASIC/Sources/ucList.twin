    ' Posicion vertical (pixeles, coordenadas de la lista) del elemento Index.
    Public Function GetItemTop(ByVal Index As Long) As Long
        Dim i As Long, lTop As Long
        If m_LayoutDirty Then Layout
        lTop = ListTop - sbValue
        If Index > mListCount Then Index = mListCount
        For i = 0 To Index - 1
            If m_Items(i).Visible Then lTop = lTop + ItemH(i)
        Next
        GetItemTop = lTop
    End Function

    ' Elemento seleccionable bajo la coordenada Y (pixeles de la lista) o -1.
    Public Function ItemHitest(ByVal Y As Long) As Long
        If m_LayoutDirty Then Layout
        ItemHitest = HitTestY(Y)
    End Function

