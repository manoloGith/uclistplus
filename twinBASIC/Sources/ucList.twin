    '======================================================================
    ' Notificacion directa a un control propietario (ucSelect)
    '======================================================================
    ' ucSelect contiene un ucList. En lugar de depender de que los eventos de un
    ' UserControl anidado lleguen al UserControl que lo contiene, el propietario se
    ' registra con zzSetNotify y recibe la llamada IUcListNotify.ListNotify justo
    ' antes de cada RaiseEvent ItemClick / IndexChange. Se guarda una referencia
    ' debil (solo el puntero) para no crear un ciclo de referencias.
    Public Sub zzSetNotify(ByVal Sink As Object)
        Dim oNotify As IUcListNotify
        If Sink Is Nothing Then
            m_pNotify = 0
        Else
            Set oNotify = Sink
            m_pNotify = ObjPtr(oNotify)
        End If
    End Sub

    Private Sub NotifyOwner(ByVal EventId As Long)
        Dim oNotify As IUcListNotify
        Dim pZero As LongPtr
        If m_pNotify = 0 Then Exit Sub
        CopyMemory oNotify, m_pNotify, LenB(m_pNotify)      'referencia sin AddRef
        oNotify.ListNotify EventId
        CopyMemory oNotify, pZero, LenB(pZero)              'soltarla sin Release
    End Sub

    Private Sub RaiseItemClick()
        NotifyOwner UCL_NOTIFY_ITEMCLICK
        RaiseEvent ItemClick
    End Sub

    Private Sub RaiseIndexChange()
        NotifyOwner UCL_NOTIFY_INDEXCHANGE
        RaiseEvent IndexChange
    End Sub

    '======================================================================
    ' Metodos publicos
    '======================================================================
    Public Sub SetKeyPress(KeyAscii As Integer)
        Call UserControl_KeyPress(KeyAscii)
    End Sub

    Public Sub SetKeyDown(KeyCode As Integer)
        Call Text1_KeyDown(KeyCode, 0)
    End Sub

    Public Function AutoCompleteTextBox(ByVal oTextBox As LongPtr, Optional ByVal OffsetLeft As Long, Optional ByVal OffsetTop As Long, Optional ByVal OffsetRight As Long, Optional ByVal OffsetBottom As Long)

        If m_SrcSubclassed <> 0 Then
            UCL_UnsubclassList m_SrcSubclassed, ObjPtr(Me) + 1
            m_SrcSubclassed = 0
        End If

        SrcTextBox = oTextBox

        If oTextBox = 0 Then Exit Function

        Edit_SetText vbNullString

        SetRect m_OffsetTextBox, OffsetLeft, OffsetTop, OffsetRight, OffsetBottom
        If UCL_SubclassList(SrcTextBox, ObjPtr(Me) + 1, ObjPtr(Me)) Then
            m_SrcSubclassed = SrcTextBox
        End If
    End Function

    Private Sub SrcTextBox_Change()
        Dim tR As RECT, i As Long
        Dim bFound As Boolean

        If bTimerSkipRoutines Then Exit Sub

        GetWindowRect SrcTextBox, tR
        If bShow = False Then
            For i = 0 To mListCount - 1
                If Not m_Items(i).IsGroup Then
                    If InStr(UCase$(m_Items(i).Text), UCase$(TextBox_GetText(SrcTextBox))) Then
                        With m_OffsetTextBox
                            Me.ListWidth = ((tR.Right + .Right) - (tR.Left + .Left)) / DpiFactor
                            ShowList tR.Left + .Left, tR.Bottom + .Top, 0, tR.Top + .Bottom
                        End With
                        bFound = True
                        Exit For
                    End If
                End If
            Next
            If Not bFound Then Exit Sub
        Else
            If Len(TextBox_GetText(SrcTextBox)) = 0 Then HideList
        End If

        'Filtro
        Edit_SetText TextBox_GetText(SrcTextBox)
        If VisibleItemsCount = 0 Then
            HideList
        End If
    End Sub

    Public Sub AddSubMenu(SubMenuTitle As String, GList As ucList, Optional ByVal Icon As Long = -1, Optional ByVal ItemData As Variant)
        ReDim Preserve m_Items(mListCount)

        With m_Items(mListCount)
            .Text = SubMenuTitle
            .Icon = Icon
            .Data = ItemData
            .Visible = True
            .TextColor = CLR_NONE
            .SubTextColor = CLR_NONE
            .BackColor = CLR_NONE
            Set .SubMenu = GList
        End With

        mListCount = mListCount + 1

    End Sub

    Public Sub OpenGroup(GropuTitle As String, Optional ByVal Icon As Long = -1, Optional ByVal ItemData As Variant)
        ReDim Preserve m_Items(mListCount)

        With m_Items(mListCount)
            .Text = GropuTitle
            .Icon = Icon
            .Data = ItemData
            .IsGroup = True
            .Visible = True
            .TextColor = CLR_NONE
            .SubTextColor = CLR_NONE
            .BackColor = CLR_NONE
        End With

        mListCount = mListCount + 1
        GroupIsOpen = True
    End Sub

    Public Sub CloseGroup()
        GroupIsOpen = False
    End Sub

    Public Function RemoveItem(Index As Long)
        Dim i As Long
        If Index < 0 Or Index > mListCount - 1 Then Exit Function
        If m_Items(Index).Separator Then SeparatorsCount = SeparatorsCount - 1
        If m_Index = Index Then m_Index = m_Index - 1
        mListCount = mListCount - 1

        For i = Index To mListCount - 1
            m_Items(i) = m_Items(i + 1)
        Next

        If mListCount > 0 Then
            ReDim Preserve m_Items(mListCount - 1)
        Else
            ReDim m_Items(0)
        End If
    End Function

    Public Function AddItem(Optional ByVal Text As String, Optional ByVal Icon As Long = -1, Optional ByVal ItemData As Variant, Optional ByVal SubText As String, Optional Checked As Boolean, Optional Disabled As Boolean, Optional ByVal Index As Long = -1)
        Dim i As Long
        ReDim Preserve m_Items(mListCount)

        If Index > -1 Then
            If Index > mListCount Then
                Index = mListCount
            Else
                For i = mListCount To Index + 1 Step -1
                    m_Items(i) = m_Items(i - 1)
                Next
            End If
        Else
            Index = mListCount
        End If

        With m_Items(Index)
            .Text = Text
            .Icon = Icon
            .Data = ItemData
            .SubText = SubText
            .Separator = (Text = "-")
            .Checked = Checked
            .IsChild = GroupIsOpen
            .IsGroup = False
            .Disabled = Disabled
            .Visible = True
            .TextColor = CLR_NONE
            .SubTextColor = CLR_NONE
            .BackColor = CLR_NONE
            .ItemBold = False
            Set .SubMenu = Nothing
            If .Separator Then SeparatorsCount = SeparatorsCount + 1
            mListCount = mListCount + 1
        End With
    End Function

    Public Function GetItemTop(ByVal Index As Long) As Long
        Dim i As Long, lTop As Long

        If m_ShowFilter Then
            Edit_SetHeight UserControl.Font.Size * 1.5 * DpiFactor
            lTop = m_EditH + lMargin * 4
        Else
            lTop = lMargin
        End If

        lTop = lTop - SB.Value

        If Index < 0 Or Index > mListCount - 1 Then
            GetItemTop = lTop
            Exit Function
        End If

        For i = 0 To mListCount - 1
            With m_Items(i)
                If Index = i Then
                    GetItemTop = lTop
                    Exit Function
                End If
                If .Separator Then
                    lTop = lTop + IH / 2
                Else
                    lTop = lTop + IH
                End If
            End With
        Next
    End Function

    '======================================================================
    ' Dibujo
    '======================================================================
    Private Sub SetFore(ByVal Color As Long)
        UserControl.ForeColor = Color
        SetTextColor UserControl.hDC, TranslateColor(Color)
    End Sub

    Private Sub SyncFont()
        ' Asegura que la fuente actual del control esta seleccionada en el lHdc
        Dim oFont As IFont
        Set oFont = UserControl.Font
        SelectObject UserControl.hDC, oFont.hFont
    End Sub

    Private Sub Draw()
        Dim i As Long
        Dim lTop As Long, lLeft As Long
        Dim rc As RECT
        Dim lWidth As Long
        Dim TextHeight As Long
        Dim oColor As Long
        Dim HotItembckColor As Long
        Dim HighlightTextColor As Long
        Dim NormalTextColor As Long
        Dim mFontSize As Single
        Dim sText As String, sShortcut As String
        Dim lPos As Long
        Dim PrevForeColor As Long
        Dim TempStr As String, TempRect As RECT
        Dim lHdc As LongPtr

        UserControl.Cls
        lHdc = UserControl.hDC
        SetBkMode lHdc, TRANSPARENT_BK
        SyncFont

        If IsDarkColor(m_SelectionColor) Then
            HighlightTextColor = vbWhite
        Else
            HighlightTextColor = vbBlack
        End If

        If IsDarkColor(UserControl.BackColor) Then
            HotItembckColor = ShiftColor(UserControl.BackColor, vbWhite, 200)
            NormalTextColor = vbWhite
        Else
            HotItembckColor = ShiftColor(UserControl.BackColor, vbBlack, 240)
            NormalTextColor = vbBlack
        End If

        m_LineColor = ShiftColor(NormalTextColor, UserControl.BackColor, 50)

        TextHeight = UserControl.TextHeight(ChrW$(192) & "j")

        lWidth = UserControl.ScaleWidth
        If SB.Visible Then
            lWidth = SB.Left - 2 * DpiFactor
        Else
            If m_SelectionRadius > 0 Then
                lWidth = lWidth - lMargin
                lLeft = lMargin
            End If
        End If

        lTop = ListTop - SB.Value

        For i = 0 To mListCount - 1
            With m_Items(i)
                If .Visible Then
                    If lTop + IH > 0 Then

                        SetRect rc, 0, lTop, lWidth, lTop + IH

                        If i = m_HotItem Or i = m_Index Then
                            If bMouseDown Or i = m_Index Then
                                oColor = m_SelectionColor
                            Else
                                If .BackColor <> CLR_NONE Then
                                    If IsDarkColor(.BackColor) Then
                                        oColor = ShiftColor(.BackColor, vbWhite, 150)
                                    Else
                                        oColor = ShiftColor(.BackColor, vbBlack, 200)
                                    End If
                                Else
                                    oColor = HotItembckColor
                                End If
                            End If

                            If m_SelectionRadius = 0 Then
                                FillRectangle lHdc, rc, oColor
                            Else
                                RoundRectPlus lHdc, rc.Left + lMargin / 2, rc.Top, _
                                    rc.Right - rc.Left - lMargin / 2, rc.Bottom - rc.Top, _
                                    RGBtoARGB(oColor, 100), 0, m_SelectionRadius * DpiFactor
                            End If
                        Else
                            If .BackColor <> CLR_NONE Then
                                FillRectangle lHdc, rc, .BackColor
                            End If
                        End If

                        If .Separator Then
                            DrawLine lHdc, lLeft, lTop + IH / 4, lWidth, lTop + IH / 4, m_LineColor
                            lTop = lTop + IH / 2
                        Else

                            If .TextColor <> CLR_NONE Then
                                SetFore .TextColor
                            Else
                                If .Disabled Then
                                    SetFore ShiftColor(NormalTextColor, UserControl.BackColor, 120)
                                Else
                                    If (i = m_HotItem And bMouseDown) Or i = m_Index Then
                                        SetFore HighlightTextColor
                                    Else
                                        SetFore NormalTextColor
                                    End If
                                End If
                            End If

                            If Not .SubMenu Is Nothing Then
                                DrawArrow lHdc, (i = m_HotItem And bMouseDown) Or i = m_Index, rc.Right - lCheckSize, lTop + IH / 2 - lCheckSize / 2, rc.Right, lTop + IH / 2 + lCheckSize / 2
                            End If

                            If m_UseMonocromeIcons Then
                                oColor = UserControl.ForeColor
                            Else
                                oColor = CLR_NONE
                            End If

                            If m_DrawSeparatorLine Then
                                DrawLine lHdc, 0, lTop + IH, lWidth, lTop + IH, m_LineColor
                            End If

                            If .IsGroup Then

                                rc.Left = lMargin * 2

                                If cImageList.Count > 0 And .Icon > -1 Then
                                    ImageListDraw lHdc, .Icon + 1, rc.Left, lTop + IH / 2 - ImgLstHeight / 2, ImgLstWidth, ImgLstHeight, oColor, .Disabled
                                    rc.Left = rc.Left + ImgLstWidth + lMargin
                                End If

                                UserControl.FontBold = True
                                SyncFont
                                DrawText lHdc, StrPtr(.Text), -1, rc, DT_SINGLELINE Or DT_VCENTER Or DT_WORD_ELLIPSIS
                                UserControl.FontBold = False
                                SyncFont
                                RaiseEvent ItemCustomDraw(i, lHdc, 0, lTop, lWidth, IH)
                            Else
                                rc.Left = lMargin * 2
                                If .IsChild Then rc.Left = rc.Left + lMargin * 2

                                If m_MultiSelect Then
                                    If .SubMenu Is Nothing Then
                                        DrawCheckBox lHdc, .Checked, (i = m_HotItem And bMouseDown) Or i = m_Index, rc.Left, lTop + IH / 2 - lCheckSize / 2, rc.Left + lCheckSize, lTop + IH / 2 + lCheckSize / 2
                                    End If
                                    rc.Left = rc.Left + lCheckSize + lMargin
                                End If

                                If cImageList.Count > 0 Then
                                    If .Icon > -1 Then ImageListDraw lHdc, .Icon + 1, rc.Left, lTop + IH / 2 - ImgLstHeight / 2, ImgLstWidth, ImgLstHeight, oColor, .Disabled
                                    rc.Left = rc.Left + ImgLstWidth + lMargin
                                End If

                                lPos = InStr(.Text, vbTab)
                                If lPos Then
                                    sText = Left$(.Text, lPos)
                                    sShortcut = Mid$(.Text, lPos)
                                Else
                                    sText = .Text
                                End If

                                rc.Right = rc.Right - lMargin - lCheckSize / 2
                                If Len(.SubText) > 0 And m_SubTitleVisible Then
                                    rc.Bottom = rc.Bottom - TextHeight
                                    DrawText lHdc, StrPtr(sText), -1, rc, DT_SINGLELINE Or DT_VCENTER Or DT_WORD_ELLIPSIS

                                    If .SubTextColor <> CLR_NONE Then
                                        SetFore .SubTextColor
                                    Else
                                        If i <> m_Index Then SetFore ShiftColor(UserControl.ForeColor, UserControl.BackColor, 120)
                                    End If
                                    If lPos Then DrawText lHdc, StrPtr(sShortcut), -1, rc, DT_SINGLELINE Or DT_VCENTER Or DT_RIGHT
                                    rc.Bottom = rc.Bottom + TextHeight * 2

                                    mFontSize = UserControl.Font.Size
                                    UserControl.Font.Size = mFontSize - 1
                                    SyncFont
                                    DrawText lHdc, StrPtr(.SubText), -1, rc, DT_SINGLELINE Or DT_VCENTER Or DT_WORD_ELLIPSIS
                                    UserControl.Font.Size = mFontSize
                                    SyncFont
                                Else
                                    If .ItemBold Then UserControl.FontBold = True: SyncFont
                                    DrawText lHdc, StrPtr(sText), -1, rc, DT_SINGLELINE Or DT_VCENTER Or DT_WORD_ELLIPSIS
                                    If lPos Then
                                        PrevForeColor = UserControl.ForeColor
                                        If .SubTextColor <> CLR_NONE Then
                                            SetFore .SubTextColor
                                        Else
                                            SetFore ShiftColor(PrevForeColor, UserControl.BackColor, 120)
                                        End If
                                        DrawText lHdc, StrPtr(sShortcut), -1, rc, DT_SINGLELINE Or DT_VCENTER Or DT_RIGHT
                                        SetFore PrevForeColor
                                    End If

                                    If Len(m_EditText) > 0 And i <> m_Index Then
                                        lPos = InStr(UCase$(sText), UCase$(m_EditText))

                                        If lPos Then
                                            TempStr = Left$(sText, lPos - 1)
                                            SetFore m_FindTextColor
                                            TempRect = rc
                                            DrawText lHdc, StrPtr(TempStr), -1, TempRect, DT_SINGLELINE Or DT_VCENTER Or DT_CALCRECT

                                            TempStr = Mid$(sText, lPos, Len(m_EditText))
                                            rc.Left = rc.Left + TempRect.Right - TempRect.Left
                                            DrawText lHdc, StrPtr(TempStr), -1, rc, DT_SINGLELINE Or DT_VCENTER Or DT_WORD_ELLIPSIS
                                        End If
                                    End If
                                    If .ItemBold Then UserControl.FontBold = False: SyncFont
                                End If

                            End If
                            RaiseEvent ItemCustomDraw(i, lHdc, 0, lTop, lWidth, IH)
                            lTop = lTop + IH

                        End If
                    Else
                        If .Separator Then
                            lTop = lTop + IH / 2
                        Else
                            lTop = lTop + IH
                        End If
                    End If
                End If

                If lTop > UserControl.ScaleHeight Then Exit For
            End With
        Next

        'Header
        SetRect rc, 0, 0, UserControl.ScaleWidth, ListTop
        FillRectangle lHdc, rc, UserControl.BackColor
        'optional
        If SB.Value > 0 Then
            SetRect rc, 0, ListTop, UserControl.ScaleWidth, lMargin / 2
            FillRectGradient lHdc, rc, RGBtoARGB(UserControl.BackColor, 100), 0
        End If

        'Footer
        SetRect rc, 0, UserControl.ScaleHeight - lMargin, UserControl.ScaleWidth, UserControl.ScaleHeight
        FillRectangle lHdc, rc, UserControl.BackColor
        'optional
        If SB.Value < SB.Max Then
            SetRect rc, 0, UserControl.ScaleHeight - lMargin * 1.5, UserControl.ScaleWidth, lMargin / 2
            FillRectGradient lHdc, rc, 0, RGBtoARGB(UserControl.BackColor, 100)
        End If

        If m_ShowFilter Then
            If isSegoeFontInstaled Then
                RoundRectPlus lHdc, m_EditL - lMargin, m_EditT - lMargin, m_EditW + lMargin * 2 + lCheckSize, m_EditH + lMargin * 2, RGBtoARGB(UserControl.BackColor, 100), RGBtoARGB(m_SelectionColor, 100), BR / 2
                SetRect rc, m_EditL + m_EditW, m_EditT - lMargin, UserControl.ScaleWidth, m_EditT + m_EditH + lMargin
                DrawGlass lHdc, rc, NormalTextColor
            Else
                RoundRectPlus lHdc, m_EditL - lMargin, m_EditT - lMargin, m_EditW + lMargin * 2 + lCheckSize, m_EditH + lMargin * 2, RGBtoARGB(UserControl.BackColor, 100), RGBtoARGB(m_SelectionColor, 100), BR / 2
            End If
        End If

        ' Barra de desplazamiento (antes era un control aparte)
        SB_Paint lHdc

        RaiseEvent PostPaint(lHdc)

        UserControl.Refresh
    End Sub

    ' Icono que se muestra en tiempo de diseno para los estilos DropDown/Menu
    ' (en VB6 era la imagen guardada en ucList.ctx)
    Private Sub DrawDesignIcon()
        Dim rc As RECT, i As Long, lW As Long, lH As Long
        Dim lHdc As LongPtr

        If cShadow Is Nothing Then Exit Sub
        UserControl.Cls
        lHdc = UserControl.hDC
        lW = UserControl.ScaleWidth
        lH = UserControl.ScaleHeight
        RoundRectPlus lHdc, 1, 1, lW - 3, lH - 3, RGBtoARGB(vbWindowBackground, 100), RGBtoARGB(vbActiveBorder, 100), 6
        For i = 0 To 2
            SetRect rc, 6, 6 + i * ((lH - 12) \ 3), lW - 6, 6 + i * ((lH - 12) \ 3) + ((lH - 12) \ 3) - 3
            If i = 1 Then
                FillRectangle lHdc, rc, vbHighlight
            Else
                FillRectangle lHdc, rc, ShiftColor(vbWindowText, vbWindowBackground, 60)
            End If
        Next
        UserControl.Refresh
    End Sub

    Private Sub FillRectGradient(ByVal lHdc As LongPtr, ByRef rc As RECT, ByVal Color1 As Long, ByVal Color2 As Long)
        Dim hBrush As LongPtr, hGraphics As LongPtr
        If rc.Bottom <= 0 Or rc.Right <= 0 Then Exit Sub
        GdipCreateFromHDC lHdc, hGraphics
        GdipCreateLineBrushFromRectWithAngleI rc, Color1, Color2, 90, 0, &H3, hBrush
        GdipFillRectangleI hGraphics, hBrush, rc.Left, rc.Top, rc.Right, rc.Bottom
        GdipDeleteBrush hBrush
        GdipDeleteGraphics hGraphics
    End Sub

    Private Sub FillRectangle(ByVal lHdc As LongPtr, ByRef rc As RECT, ByVal Color As Long)
        Dim hBrush As LongPtr
        hBrush = CreateSolidBrush(TranslateColor(Color))
        FillRect lHdc, rc, hBrush
        Call DeleteObject(hBrush)
    End Sub

    Private Sub DrawGlass(ByVal lHdc As LongPtr, ByRef rc As RECT, ByVal Color As Long)
        Dim oFont As IFont
        Dim hPrevFont As LongPtr
        Dim PrevForeColor As Long

        Set oFont = m_SegoeFont
        m_SegoeFont.Size = 18 / 1.5
        hPrevFont = SelectObject(lHdc, oFont.hFont)
        PrevForeColor = UserControl.ForeColor
        SetFore Color
        DrawText lHdc, StrPtr(ChrW2(&HE094)), 1, rc, DT_SINGLELINE Or DT_VCENTER
        Call SelectObject(lHdc, hPrevFont)
        SetFore PrevForeColor
    End Sub

    Private Sub DrawArrow(ByVal lHdc As LongPtr, ByVal bHighlight As Boolean, ByVal X1 As Long, ByVal Y1 As Long, ByVal X2 As Long, ByVal Y2 As Long)
        Dim oFont As IFont
        Dim hPrevFont As LongPtr
        Dim rc As RECT
        Dim sChr As String

        If isSegoeFontInstaled Then
            m_SegoeFont.Size = UserControl.Font.Size
            Set oFont = m_SegoeFont
            sChr = ChrW2(&HE970)
        Else
            m_Wingdings3.Size = UserControl.Font.Size
            Set oFont = m_Wingdings3
            sChr = ChrW2(&H7D)
        End If

        hPrevFont = SelectObject(lHdc, oFont.hFont)
        SetRect rc, X1, Y1, X2, Y2
        DrawText lHdc, StrPtr(sChr), 1, rc, DT_SINGLELINE Or DT_VCENTER Or DT_CENTER
        Call SelectObject(lHdc, hPrevFont)

    End Sub

    Private Sub DrawCheckBox(ByVal lHdc As LongPtr, ByVal Value As Boolean, ByVal bHighlight As Boolean, ByVal X1 As Long, ByVal Y1 As Long, ByVal X2 As Long, ByVal Y2 As Long)
        Dim oFont As IFont
        Dim hPrevFont As LongPtr
        Dim rc As RECT
        Dim PrevForeColor As Long
        Dim sChr As String

        PrevForeColor = UserControl.ForeColor

        If isSegoeFontInstaled Then
            m_SegoeFont.Size = 12
            Set oFont = m_SegoeFont
            If Value Then
                If bHighlight = False Then SetFore m_SelectionColor
                sChr = ChrW2(&HE005)
            Else
                sChr = ChrW2(&HE003)
            End If
        Else
            m_Wingdings2.Size = 14
            Set oFont = m_Wingdings2
            If Value Then
                If bHighlight = False Then SetFore m_SelectionColor
                sChr = ChrW2(&H52)
            Else
                sChr = ChrW2(&HA3)
            End If
        End If

        SetRect rc, X1, Y1, X2, Y2
        hPrevFont = SelectObject(lHdc, oFont.hFont)
        DrawText lHdc, StrPtr(sChr), 1, rc, DT_SINGLELINE Or DT_VCENTER Or DT_CENTER
        SetFore PrevForeColor
        Call SelectObject(lHdc, hPrevFont)

    End Sub

    Public Function GetWindowDpi() As Single
        GetWindowDpi = DpiFactor
    End Function

    Public Function ChrW2(ByVal CharCode As Long) As String
        Const POW10 As Long = 2 ^ 10
        If CharCode <= &HFFFF& Then
            ChrW2 = ChrW$(CharCode)
        Else
            ChrW2 = ChrW$(&HD800& + (CharCode And &HFFFF&) \ POW10) & _
                    ChrW$(&HDC00& + (CharCode And (POW10 - 1)))
        End If
    End Function

    '======================================================================
    ' Mostrar / ocultar la lista desplegable
    '======================================================================
    Public Sub ShowList(Left As Long, Top As Long, Optional BtnLeft As Long, Optional BtnTop As Long)
        Dim i As Long, WinHeight As Long
        Dim ScreenHeight As Long, ScreenWidth As Long
        Dim oCtl As Object

        If isWinChild Then Exit Sub
        If bShow Then HideList

        EnsureSubclass

        bHideSubMenu = False
        bShowSubMenu = False
        m_TimerTag = -1
        m_HotItem = -1
        bKillFocus = False
        m_BtnTop = 0
        m_BtnLeft = 0

        PrevFocus = GetFocus
        m_PhWnd = UserControl.ContainerHwnd
        hAnsestor = GetAncestor(m_PhWnd, GA_ROOT)
        If SrcTextBox = 0 Then
            PutFocus UserControl.hWnd
        End If
        Edit_SetText vbNullString

        On Error Resume Next '---------Busca el formulario para capturar los eventos Unload y Resize
            Set oCtl = UserControl.Extender.Container
            Do
                If TypeOf oCtl Is Form Then
                    Set Frm = oCtl
                    Exit Do
                Else
                    Set oCtl = oCtl.Parent
                    If Err.Number Then Exit Do
                End If
            Loop
        On Error GoTo 0 '----------------

        If m_ShowFilter Then
            Edit_SetFont
            Edit_SetVisible True
            If m_hEdit <> 0 Then PutFocus m_hEdit
            Edit_SetHeight UserControl.Font.Size * 1.5 * DpiFactor
            lHeadHeight = m_EditH + lMargin * 4
            m_EditBack = UserControl.BackColor
            If IsDarkColor(m_EditBack) Then
                m_EditFore = vbWhite
            Else
                m_EditFore = vbBlack
            End If
        Else
            Edit_SetVisible False
            lHeadHeight = lMargin
        End If

        ScreenHeight = Screen.Height / Screen.TwipsPerPixelY
        ScreenWidth = Screen.Width / Screen.TwipsPerPixelX

        Call RegisterHotsKeys

        WinHeight = lHeadHeight + lMargin '< footer

        For i = 0 To mListCount - 1 'Calcula el alto
            With m_Items(i)
                If .Separator Then
                    WinHeight = WinHeight + IH / 2
                Else
                    WinHeight = WinHeight + IH
                End If
                If WinHeight > ScreenHeight Then
                    WinHeight = ScreenHeight
                    Exit For
                End If
            End With
        Next

        If m_MaxVisibleItems > 0 Then
            m_MaxListHeight = (lHeadHeight + IH * m_MaxVisibleItems + lMargin)
        End If

        '---
        If m_MaxListHeight > 0 Then If WinHeight > m_MaxListHeight Then WinHeight = m_MaxListHeight
        If Top + WinHeight > ScreenHeight Then
            If BtnTop > 0 Then
                m_BtnTop = BtnTop
                Top = (m_BtnTop - WinHeight)
            Else
                Top = (ScreenHeight - WinHeight)
            End If
        End If
        If Top < 0 Then Top = 0

        '----
        If Left + (m_ListWidth * DpiFactor) > ScreenWidth Then
            If BtnLeft > 0 Then
                m_BtnLeft = BtnLeft
                Left = BtnLeft - (m_ListWidth * DpiFactor)
            Else
                Left = ScreenWidth - (m_ListWidth * DpiFactor)
            End If
        End If
        If Left < 0 Then Left = 0
        '----

        m_Left = Left
        SetParent UserControl.hWnd, 0
        SetWindowPos UserControl.hWnd, HWND_TOPMOST, Left, Top, m_ListWidth * DpiFactor, WinHeight, SWP_NOACTIVATE Or SWP_SHOWWINDOW
        PutFocus UserControl.hWnd
        ' En VB6 el UserControl pasaba el foco a su TextBox Text1; el EDIT creado por
        ' codigo no lo recibe solo, asi que se le da aqui cuando hay filtro.
        If m_ShowFilter And m_hEdit <> 0 Then PutFocus m_hEdit

        If m_ShowFilter Then
            Edit_Move lMargin * 2, lMargin * 2, UserControl.ScaleWidth - lMargin * 4 - 16 * DpiFactor
        End If

        ListTop = lHeadHeight
        ListHeight = UserControl.ScaleHeight - lHeadHeight - lMargin

        SB_ApplyDesign
        SB_SetMax IH * (mListCount - SeparatorsCount) + (IH / 2) * SeparatorsCount - ListHeight

        If SB.Max > 0 Then
            SB.SmallChange = IH * 3
            ' Sugerencia de JB
            SB.LargeChange = ListHeight - IH
            ' Fin Sugerencia de JB
            SB.WheelChange = IH * 3
            SB.WheelEnabled = True
            SB.Visible = True
        Else
            SB.WheelEnabled = False
            SB.Visible = False
        End If

        UserControl_Resize
        cShadow.BackColor = UserControl.BackColor
        If m_BorderVisible Then
            cShadow.ShowBorders UserControl.hWnd, isWinChild
        End If

        If m_Index > -1 Then FocusItem m_Index

        Call Draw

        'si ShowList se llama en MouseDown, espera al MouseUp
        If (GetAsyncKeyState(vbLeftButton) < 0) Or (GetAsyncKeyState(vbRightButton) < 0) Then
            DoEvents
            Do While (GetAsyncKeyState(vbLeftButton) < 0) Or (GetAsyncKeyState(vbRightButton) < 0)
            Loop
        End If

        Timer1_SetInterval 1
        bShow = True
    End Sub

    Public Sub HideList()
        If bShow = False Then Exit Sub
        bShow = False

        Set Frm = Nothing

        If Not ChildMenu Is Nothing Then
            ChildMenu.HideList
            Set ChildMenu.ParentMenu = Nothing

            Set ChildMenu = Nothing
        End If

        Timer1_SetInterval 0
        SB_StopRepeat

        Call UnRegisterHotsKeys

        hAnsestor = 0

        ShowWindow UserControl.hWnd, 0
        SetParent UserControl.hWnd, m_PhWnd

        cShadow.HideBorders

        If Not ParentMenu Is Nothing Then
            ParentMenu.HideList
            Set ParentMenu = Nothing
        End If
        RaiseEvent HideList
    End Sub

    Friend Sub UnRegisterHotsKeys()
        Call UnregisterHotKey(UserControl.hWnd, vbKeyDown)
        Call UnregisterHotKey(UserControl.hWnd, vbKeyUp)
        Call UnregisterHotKey(UserControl.hWnd, vbKeyReturn)
        Call UnregisterHotKey(UserControl.hWnd, vbKeyEscape)
        Call UnregisterHotKey(UserControl.hWnd, vbKeyHome)
        Call UnregisterHotKey(UserControl.hWnd, vbKeyEnd)
        Call UnregisterHotKey(UserControl.hWnd, vbKeyPageUp)
        Call UnregisterHotKey(UserControl.hWnd, vbKeyPageDown)
        Call UnregisterHotKey(UserControl.hWnd, vbKeyTab)
        Call UnregisterHotKey(UserControl.hWnd, vbKeyLeft)
        Call UnregisterHotKey(UserControl.hWnd, vbKeyRight)
    End Sub

    Friend Sub RegisterHotsKeys()
        Call RegisterHotKey(UserControl.hWnd, vbKeyDown, 0, vbKeyDown)
        Call RegisterHotKey(UserControl.hWnd, vbKeyUp, 0, vbKeyUp)
        Call RegisterHotKey(UserControl.hWnd, vbKeyReturn, 0, vbKeyReturn)
        Call RegisterHotKey(UserControl.hWnd, vbKeyEscape, 0, vbKeyEscape)
        Call RegisterHotKey(UserControl.hWnd, vbKeyHome, 0, vbKeyHome)
        Call RegisterHotKey(UserControl.hWnd, vbKeyEnd, 0, vbKeyEnd)
        Call RegisterHotKey(UserControl.hWnd, vbKeyPageUp, 0, vbKeyPageUp)
        Call RegisterHotKey(UserControl.hWnd, vbKeyPageDown, 0, vbKeyPageDown)
        Call RegisterHotKey(UserControl.hWnd, vbKeyTab, 0, vbKeyTab)
        Call RegisterHotKey(UserControl.hWnd, vbKeyLeft, 0, vbKeyLeft)
        Call RegisterHotKey(UserControl.hWnd, vbKeyRight, 0, vbKeyRight)
    End Sub

    Private Sub DrawLine(ByVal lpDC As LongPtr, ByVal X As Long, ByVal Y As Long, ByVal X2 As Long, ByVal Y2 As Long, ByVal Color As Long)
        Dim PT      As POINTAPI
        Dim hPen    As LongPtr
        Dim hPenOld As LongPtr

        hPen = CreatePen(0, 1, TranslateColor(Color))
        hPenOld = SelectObject(lpDC, hPen)
        Call MoveToEx(lpDC, X, Y, PT)
        Call LineTo(lpDC, X2, Y2)
        Call SelectObject(lpDC, hPenOld)
        Call DeleteObject(hPen)
    End Sub

    Private Sub Frm_Resize()
        HideList
    End Sub

    Private Sub Frm_Unload(Cancel As Integer)
        HideList
    End Sub

    '======================================================================
    ' Filtro: control EDIT creado por codigo (antes TextBox Text1)
    '======================================================================
    Private Sub Edit_Create()
        Const ES_LEFT As Long = 0
        If m_hEdit <> 0 Then Exit Sub
        If m_hWndSubclassed = 0 Then Exit Sub

        m_hEdit = CreateWindowExW(0, StrPtr("EDIT"), StrPtr(m_EditText), WS_CHILD Or WS_CLIPSIBLINGS Or ES_LEFT Or ES_AUTOHSCROLL, _
                                  m_EditL, m_EditT, m_EditW, m_EditH, m_hWndSubclassed, 0, App.hInstance, 0)
        If m_hEdit = 0 Then Exit Sub

        UCL_SubclassList m_hEdit, ObjPtr(Me) + 2, ObjPtr(Me)
        Edit_SetFont
        If m_EditVisible Then ShowWindow m_hEdit, SW_SHOWNA
    End Sub

    Private Sub Edit_Destroy()
        If m_hEdit <> 0 Then
            UCL_UnsubclassList m_hEdit, ObjPtr(Me) + 2
            DestroyWindow m_hEdit
            m_hEdit = 0
        End If
        If m_hEditBrush <> 0 Then DeleteObject m_hEditBrush: m_hEditBrush = 0
    End Sub

    Private Sub Edit_SetFont()
        Dim oFont As IFont
        If m_hEdit = 0 Then Exit Sub
        Set oFont = UserControl.Font
        SendMessageW m_hEdit, WM_SETFONT, oFont.hFont, 1
    End Sub

    ' Equivale a Text1.Text = sText (dispara Text1_Change si cambia)
    Private Sub Edit_SetText(ByVal sText As String)
        If sText = m_EditText Then Exit Sub
        If m_hEdit <> 0 Then
            SetWindowTextW m_hEdit, StrPtr(sText)   'EN_CHANGE -> Text1_Change
            m_EditText = Edit_ReadText()
        Else
            m_EditText = sText
            Text1_Change
        End If
    End Sub

    Private Function Edit_ReadText() As String
        Dim lLen As Long, sBuf As String
        If m_hEdit = 0 Then Edit_ReadText = m_EditText: Exit Function
        lLen = GetWindowTextLengthW(m_hEdit)
        If lLen > 0 Then
            sBuf = String$(lLen + 1, vbNullChar)
            lLen = GetWindowTextW(m_hEdit, StrPtr(sBuf), lLen + 1)
            Edit_ReadText = Left$(sBuf, lLen)
        End If
    End Function

    Private Sub Edit_SetVisible(ByVal bVisible As Boolean)
        m_EditVisible = bVisible
        If m_hEdit <> 0 Then ShowWindow m_hEdit, IIf(bVisible, SW_SHOWNA, SW_HIDE)
    End Sub

    Private Sub Edit_SetHeight(ByVal lHeight As Long)
        m_EditH = lHeight
        Edit_ApplyPos
    End Sub

    Private Sub Edit_Move(ByVal lLeft As Long, ByVal lTop As Long, Optional ByVal lWidth As Long = -1, Optional ByVal lHeight As Long = -1)
        m_EditL = lLeft
        m_EditT = lTop
        If lWidth >= 0 Then m_EditW = lWidth
        If lHeight >= 0 Then m_EditH = lHeight
        Edit_ApplyPos
    End Sub

    Private Sub Edit_ApplyPos()
        If m_hEdit <> 0 Then MoveWindow m_hEdit, m_EditL, m_EditT, m_EditW, m_EditH, 1
    End Sub

    Private Function Edit_ShiftState() As Integer
        If GetKeyState(VK_SHIFT) < 0 Then Edit_ShiftState = Edit_ShiftState Or vbShiftMask
        If GetKeyState(VK_CONTROL) < 0 Then Edit_ShiftState = Edit_ShiftState Or vbCtrlMask
        If GetKeyState(VK_MENU) < 0 Then Edit_ShiftState = Edit_ShiftState Or vbAltMask
    End Function

    ' Mensajes de la propia ventana EDIT (antes eventos Text1_KeyDown / Text1_KeyPress)
    Private Function Edit_WndProc(ByVal lhWnd As LongPtr, ByVal uMsg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr, ByRef bHandled As Boolean) As LongPtr
        Dim KeyCode As Integer, KeyAscii As Integer, Shift As Integer
        Dim lMsg As Long, vk As LongPtr

        Select Case uMsg
            Case WM_GETDLGCODE
                ' Flechas y caracteres siempre; Enter (y Escape en modo desplegable)
                ' tambien, para que no los consuma el formulario. Tab sigue moviendo el foco.
                Edit_WndProc = UCL_DefProc(lhWnd, uMsg, wParam, lParam) Or DLGC_WANTARROWS Or DLGC_WANTCHARS Or DLGC_HASSETSEL
                If lParam <> 0 Then
                    CopyMemory lMsg, ByVal lParam + LenB(vk), 4                 'MSG.message
                    CopyMemory vk, ByVal lParam + LenB(vk) * 2, LenB(vk)        'MSG.wParam
                    If lMsg = WM_KEYDOWN Or lMsg = WM_CHAR Then
                        If vk = vbKeyReturn Or (vk = vbKeyEscape And Not isWinChild) Then
                            Edit_WndProc = Edit_WndProc Or DLGC_WANTMESSAGE
                        End If
                    End If
                End If
                bHandled = True

            Case WM_KEYDOWN
                m_EditSkipChar = False
                KeyCode = CInt(wParam And &HFF&)
                Shift = Edit_ShiftState()
                Text1_KeyDown KeyCode, Shift
                If KeyCode = 0 Then
                    m_EditSkipChar = True   'no pasar el WM_CHAR correspondiente (evita el pitido)
                    bHandled = True
                End If

            Case WM_CHAR
                If m_EditSkipChar Then
                    m_EditSkipChar = False
                    bHandled = True
                Else
                    KeyAscii = WordToInteger(wParam)
                    Text1_KeyPress KeyAscii
                    If KeyAscii = 0 Then
                        bHandled = True
                    ElseIf KeyAscii <> WordToInteger(wParam) Then
                        Edit_WndProc = UCL_DefProc(lhWnd, uMsg, CLngPtr(KeyAscii) And &HFFFF&, lParam)
                        bHandled = True
                    End If
                End If

            Case WM_NCDESTROY
                UCL_UnsubclassList lhWnd, ObjPtr(Me) + 2
                m_hEdit = 0
        End Select
    End Function

    ' Mensajes que el EDIT envia a su padre (la ventana del UserControl)
    Private Function Edit_ParentMsg(ByVal uMsg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr, ByRef bHandled As Boolean) As LongPtr
        Dim lBack As Long

        If m_hEdit = 0 Or lParam <> m_hEdit Then Exit Function

        Select Case uMsg
            Case WM_COMMAND
                If (HiWordSigned(wParam) And &HFFFF&) = EN_CHANGE Then
                    m_EditText = Edit_ReadText()
                    Text1_Change
                    bHandled = True
                End If

            Case WM_CTLCOLOREDIT
                lBack = TranslateColor(m_EditBack)
                If m_hEditBrush = 0 Or m_EditBrushColor <> lBack Then
                    If m_hEditBrush <> 0 Then DeleteObject m_hEditBrush
                    m_hEditBrush = CreateSolidBrush(lBack)
                    m_EditBrushColor = lBack
                End If
                SetTextColor wParam, TranslateColor(m_EditFore)
                SetBkColor wParam, lBack
                Edit_ParentMsg = m_hEditBrush
                bHandled = True
        End Select
    End Function

    '======================================================================
    ' Filtro (logica)
    '======================================================================
    Private Sub Text1_Change()
        Dim i As Long
        Dim lHeight As Long
        Dim ParentIndex As Long
        Dim lWidth As Long

        bFiltered = Len(m_EditText) > 0
        m_Index = -1

        VisibleItemsCount = 0
        For i = 0 To mListCount - 1
            With m_Items(i)
                If .IsGroup Then
                    .Visible = False
                    ParentIndex = i
                Else
                    If InStr(UCase$(.Text), UCase$(m_EditText)) Then

                        lHeight = lHeight + IH

                        If .IsChild And m_Items(ParentIndex).Visible = False Then
                            m_Items(ParentIndex).Visible = True
                            lHeight = lHeight + IH
                        End If
                        .Visible = True
                        VisibleItemsCount = VisibleItemsCount + 1
                    Else
                        .Visible = False
                    End If
                End If
            End With
        Next

        If isWinChild Then
            If lHeight < SB.Height Then
                SB.Visible = False
                SB.WheelEnabled = False
                SB.Value = 0
            Else
                SB.Value = 0
                SB_SetMax lHeight - SB.Height
                SB.SmallChange = IH
                SB.LargeChange = ListHeight - IH
                SB.Visible = True
                SB.WheelEnabled = True
            End If
            Draw
            Exit Sub
        End If

        ' Lista desplegable cerrada (p. ej. AutoCompleteTextBox o ShowList vaciando el
        ' filtro): solo se actualiza la visibilidad de los elementos. Redimensionar aqui
        ' llamaba a cShadow.Refresh y a SetWindowPos(SWP_SHOWWINDOW), que volvian a
        ' mostrar la sombra (y la lista) en la posicion de la ultima vez.
        If Not bShow Then
            SB.Value = 0
            Exit Sub
        End If

        lWidth = m_ListWidth * Screen.TwipsPerPixelX * DpiFactor

        If lHeight <= SB.Height Then
            UserControl.Size lWidth, (lHeadHeight + lHeight + lMargin) * Screen.TwipsPerPixelY
            SB.Visible = False
            SB.WheelEnabled = False
        Else
            If (ListTop + lHeight + lMargin) > m_MaxListHeight And m_MaxListHeight > 0 Then
                UserControl.Size lWidth, m_MaxListHeight * Screen.TwipsPerPixelY
            Else
                UserControl.Size lWidth, ListHeight * Screen.TwipsPerPixelY
            End If

            SB.Value = 0
            SB_SetMax lHeight - SB.Height
            SB.SmallChange = IH
            SB.LargeChange = ListHeight - IH
            SB.Visible = True
            SB.WheelEnabled = True
        End If

        If m_BtnTop > 0 Then
            SetWindowPos UserControl.hWnd, HWND_TOPMOST, m_Left, (m_BtnTop * DpiFactor) - UserControl.ScaleHeight, 0, 0, SWP_NOACTIVATE Or SWP_SHOWWINDOW Or SWP_NOSIZE
        End If
        bKillFocus = False
        If m_BorderVisible Then RefreshShadow

        If SB.Value > 0 Then
            SB_SetValue 0, False
        Else
            Draw
        End If
    End Sub

    Private Sub FocusItem(ByVal Index As Long)
        Dim i As Long
        Dim mHeight As Long

        For i = 0 To mListCount - 1
            If m_Items(i).Visible Then
                If Not m_Items(i).Separator Then
                    mHeight = mHeight + IH
                Else
                    mHeight = mHeight + IH / 2
                End If
                If Index = i Then
                    If mHeight + IH > SB.Value + ListHeight Then
                        SB_SetValue mHeight - ListHeight, False
                    ElseIf mHeight - IH < SB.Value Then
                        SB_SetValue mHeight - IH, False
                    End If
                    Draw
                    Exit For
                End If
            End If
        Next
    End Sub

    Private Function IsItemSelectable(ByVal Index As Long) As Boolean
        If Index < 0 Or Index > mListCount - 1 Then Exit Function
        If m_Items(Index).Visible And Not m_Items(Index).Disabled And _
            Not m_Items(Index).IsGroup And Not m_Items(Index).Separator Then
            IsItemSelectable = True
        End If
    End Function

    Private Sub Text1_KeyDown(KeyCode As Integer, Shift As Integer)
        Dim i As Long
        Dim ItemPerPage As Long
        Dim sText As String
        Dim tR As RECT

        Select Case KeyCode
            Case vbKeyUp
                KeyCode = 0
                For i = m_Index - 1 To 0 Step -1
                    If IsItemSelectable(i) Then
                        m_Index = i
                        FocusItem m_Index
                        RaiseIndexChange
                        Exit For
                    End If
                Next

            Case vbKeyDown
                KeyCode = 0
                For i = m_Index + 1 To mListCount - 1
                    If IsItemSelectable(i) Then
                        m_Index = i
                        FocusItem m_Index
                        RaiseIndexChange
                        Exit For
                    End If
                Next

            Case vbKeyHome
                KeyCode = 0
                For i = 0 To mListCount - 1
                    If IsItemSelectable(i) Then
                        m_Index = i
                        FocusItem m_Index
                        RaiseIndexChange
                        Exit For
                    End If
                Next

            Case vbKeyEnd
                KeyCode = 0
                For i = mListCount - 1 To 0 Step -1
                    If IsItemSelectable(i) Then
                        m_Index = i
                        FocusItem m_Index
                        RaiseIndexChange
                        Exit For
                    End If
                Next

            Case vbKeyEscape
                If Not isWinChild Then
                    KeyCode = 0
                    If Not ParentMenu Is Nothing Then
                        Text1_KeyDown vbKeyLeft, 0
                    Else
                        HideList
                    End If
                End If

            Case vbKeyReturn

                KeyCode = 0
                If m_MultiSelect Then
                    If m_Index <> -1 Then
                        m_Items(m_Index).Checked = Not m_Items(m_Index).Checked
                        Draw
                        RaiseItemClick
                    End If
                Else
                    If m_Index <> -1 Then
                        If Not isWinChild Then HideList
                        RaiseItemClick

                        If SrcTextBox <> 0 Then
                            bTimerSkipRoutines = True
                            sText = m_Items(m_Index).Text
                            TextBox_SetText SrcTextBox, sText
                            TextBox_SelStart SrcTextBox, Len(sText)
                            bTimerSkipRoutines = False
                            RaiseEvent PostAutoComplete
                        End If
                    Else
                        If SrcTextBox <> 0 Then
                            HideList
                            SendMessageW SrcTextBox, WM_CHAR, vbKeyReturn, 0
                        Else
                            Beep
                        End If
                    End If
                End If

            Case vbKeyPageDown
                KeyCode = 0
                ItemPerPage = ListHeight \ (ItemHeight * DpiFactor)
                For i = m_Index + ItemPerPage To mListCount - 1
                    If IsItemSelectable(i) Then
                        m_Index = i
                        FocusItem m_Index
                        RaiseIndexChange
                        Exit For
                    End If
                Next
                Text1_KeyDown vbKeyEnd, 0

            Case vbKeyPageUp
                KeyCode = 0
                ItemPerPage = ListHeight \ (ItemHeight * DpiFactor)

                For i = m_Index - ItemPerPage To 0 Step -1
                    If IsItemSelectable(i) Then
                        m_Index = i
                        FocusItem m_Index
                        RaiseIndexChange
                        Exit For
                    End If
                Next
                Text1_KeyDown vbKeyHome, 0

            Case vbKeyTab
                If Not isWinChild Then HideList

            Case vbKeyLeft
                KeyCode = 0
                If Not ParentMenu Is Nothing Then
                    GiveCommand
                    ParentMenu.TakeCommand
                    Set ParentMenu = Nothing
                    HideList
                End If

            Case vbKeyRight
                KeyCode = 0

                If m_Index <> -1 Then
                    If Not m_Items(m_Index).SubMenu Is Nothing Then
                        GetWindowRect UserControl.hWnd, tR
                        Set m_Items(m_Index).SubMenu.ParentMenu = Me
                        Set ChildMenu = m_Items(m_Index).SubMenu
                        GiveCommand
                        m_Items(m_Index).SubMenu.ListIndex = -1
                        m_Items(m_Index).SubMenu.ShowList tR.Right, tR.Top + GetItemTop(m_Index) - lHeadHeight, tR.Left
                    End If
                End If

        End Select

    End Sub

    Private Sub Text1_KeyPress(KeyAscii As Integer)
        If KeyAscii = vbKeyReturn Then KeyAscii = 0
    End Sub

    '======================================================================
    ' Reemplazo de Timer1 (SetTimer / WM_TIMER)
    '======================================================================
    Private Sub Timer1_SetInterval(ByVal Interval As Long)
        m_TimerInterval = Interval
        Timer1_Apply
    End Sub

    Private Sub Timer1_SetEnabled(ByVal Enabled As Boolean)
        m_TimerEnabled = Enabled
        Timer1_Apply
    End Sub

    Private Sub Timer1_Apply()
        Dim lNew As Long
        If m_hWndSubclassed = 0 Then Exit Sub
        If m_TimerEnabled Then lNew = m_TimerInterval
        If lNew = m_TimerActive Then Exit Sub
        If lNew > 0 Then
            SetTimer m_hWndSubclassed, TIMER_MAIN, lNew, 0
        Else
            KillTimer m_hWndSubclassed, TIMER_MAIN
        End If
        m_TimerActive = lNew
    End Sub

    Private Sub Timer1_Timer()
        Dim PT As POINTAPI

        '------------------
        If bShowSubMenu Then
            TickCount = TickCount + 1
            If TickCount > 30 Then
                bShowSubMenu = False
                TimerShowMenu
            End If
        End If

        '------------------
        If bHideSubMenu Then
            TickCount = TickCount + 1
            If TickCount > 30 Then
                bHideSubMenu = False
                TimerHideMenu
            End If
        End If
        '------------------

        If bTimerSkipRoutines Then
            If ChildMenu Is Nothing Then
                bTimerSkipRoutines = False
            Else
                Exit Sub
            End If
        End If

        If isWinChild Then
            GetCursorPos PT
            If Not PointInWindow(UserControl.hWnd, PT) Then
                m_HotItem = -1
                SB.HotPart = sbpNone
                Timer1_SetInterval 0
                Draw
            End If
        Else

            If (GetAsyncKeyState(vbLeftButton) < 0) Or (GetAsyncKeyState(vbRightButton) < 0) Then
                ' Clic fuera de la lista -> cerrarla. En VB6 se comparaba
                ' WindowFromPoint(cursor) con UserControl.hWnd; en twinBASIC esa
                ' comparacion puede fallar aunque el clic sea DENTRO de la lista, y la
                ' lista se cerraba antes del MouseUp (sin ItemClick). Ahora se compara
                ' el cursor con el rectangulo de la ventana.
                GetCursorPos PT

                If Not PointInWindow(UserControl.hWnd, PT) Then

                    If Not ParentMenu Is Nothing Then
                        If PointInWindow(ParentMenu.hWnd, PT) Then Exit Sub
                    End If

                    HideList
                End If
            End If

            If bKillFocus Then HideList
            ' esto es para que se pueda mostrar u ocultar la lista presionando un boton
            ' con este tiempo de puede consultar si bShow = true
        End If
    End Sub

    ' Elemento seleccionable bajo la coordenada Y (misma logica que MouseMove)
    Private Function HotItemFromY(ByVal Y As Single) As Long
        Dim i As Long, lTop As Long
        HotItemFromY = -1
        If SB.Visible And SB.PressedPart <> sbpNone Then Exit Function
        lTop = ListTop - SB.Value
        For i = 0 To mListCount - 1
            With m_Items(i)
                If .Visible Then
                    If Y >= lTop And Y < lTop + IH Then
                        If Not .Separator And Not .IsGroup And Not .Disabled Then
                            HotItemFromY = i
                            Exit Function
                        End If
                    End If
                    If Not .Separator Then
                        lTop = lTop + IH
                    Else
                        lTop = lTop + IH / 2
                    End If
                    If lTop > UserControl.ScaleHeight Then Exit Function
                End If
            End With
        Next
    End Function

    ' True si el punto (coordenadas de pantalla) esta dentro de la ventana
    Private Function PointInWindow(ByVal lhWnd As LongPtr, ByRef PT As POINTAPI) As Boolean
        Dim tR As RECT
        If lhWnd = 0 Then Exit Function
        If GetWindowRect(lhWnd, tR) = 0 Then Exit Function
        PointInWindow = (PT.X >= tR.Left And PT.X < tR.Right And PT.Y >= tR.Top And PT.Y < tR.Bottom)
    End Function

    Private Sub TimerHideMenu()
        If Not ChildMenu Is Nothing Then
            Set ChildMenu.ParentMenu = Nothing
            ChildMenu.HideList
            Set ChildMenu = Nothing
            TakeCommand
            m_Index = -1
            Draw
        End If
    End Sub

    Private Sub TimerShowMenu()
        Dim tR As RECT
        If m_TimerTag = m_Index Then Exit Sub
        If m_TimerTag < 0 Or m_TimerTag > mListCount - 1 Then Exit Sub
        GetWindowRect UserControl.hWnd, tR
        m_Index = m_TimerTag
        Draw
        Set m_Items(m_Index).SubMenu.ParentMenu = Me
        Set ChildMenu = m_Items(m_Index).SubMenu

        GiveCommand

        m_Items(m_Index).SubMenu.ListIndex = -1
        m_Items(m_Index).SubMenu.ShowList tR.Right, tR.Top + GetItemTop(m_Index) - lHeadHeight, tR.Left

    End Sub

    '======================================================================
    ' Barra de desplazamiento interna (antes ucScrollbar1)
    '======================================================================
    Private Sub ucScrollbar1_Change()
        Draw
        If SB.Value = SB.Max Then
            RaiseEvent ScrollBottom
        End If
    End Sub

    Private Sub ucScrollbar1_Scroll()
        Draw
    End Sub

    Private Sub SB_ApplyDesign()
        Select Case m_ListDesign
            Case GoogleDesign
                SB.Width = 8 * DpiFactor
                SB.ShowButtons = False
                SB.Style = sCustomDraw
            Case MicrosoftDesign
                SB.Width = 16 * DpiFactor
                SB.ShowButtons = True
                SB.Style = sThemed
        End Select
    End Sub

    Private Sub SB_SetMax(ByVal NewMax As Long)
        SB.Max = NewMax
        If SB.Max < 0 Then
            SB.Value = 0
        ElseIf SB.Value > SB.Max Then
            SB.Value = SB.Max
        End If
    End Sub

    Private Sub SB_Move(ByVal Left As Long, ByVal Top As Long, ByVal Width As Long, ByVal Height As Long)
        SB.Left = Left
        SB.Top = Top
        SB.Width = Width
        SB.Height = Height
    End Sub

    ' Cambia el valor; bScroll = True durante el arrastre del thumb (evento Scroll)
    Private Sub SB_SetValue(ByVal NewValue As Long, ByVal bScroll As Boolean, Optional ByVal bRaise As Boolean = True)
        If NewValue > SB.Max Then NewValue = SB.Max
        If NewValue < 0 Then NewValue = 0
        If NewValue = SB.Value Then Exit Sub
        SB.Value = NewValue
        If Not bRaise Then Exit Sub
        If bScroll Then
            ucScrollbar1_Scroll
        Else
            ucScrollbar1_Change
        End If
    End Sub

    Private Sub SB_GetMetrics(ByRef BtnSize As Long, ByRef TrackTop As Long, ByRef TrackLen As Long, ByRef ThumbTop As Long, ByRef ThumbLen As Long)
        Dim lPage As Long, lMin As Long

        If SB.ShowButtons Then BtnSize = SB.Width Else BtnSize = 0
        If BtnSize * 2 > SB.Height Then BtnSize = SB.Height \ 2
        TrackTop = SB.Top + BtnSize
        TrackLen = SB.Height - BtnSize * 2
        If TrackLen < 0 Then TrackLen = 0

        If SB.Max <= 0 Then
            ThumbTop = TrackTop
            ThumbLen = TrackLen
            Exit Sub
        End If

        lPage = SB.LargeChange
        If lPage < 1 Then lPage = 1
        ThumbLen = CLng(CDbl(TrackLen) * lPage / (SB.Max + lPage))
        lMin = 16 * DpiFactor
        If ThumbLen < lMin Then ThumbLen = lMin
        If ThumbLen > TrackLen Then ThumbLen = TrackLen
        ThumbTop = TrackTop + CLng(CDbl(TrackLen - ThumbLen) * SB.Value / SB.Max)
    End Sub

    Private Function SB_HitTest(ByVal X As Long, ByVal Y As Long) As eSbPart
        Dim BtnSize As Long, TrackTop As Long, TrackLen As Long, ThumbTop As Long, ThumbLen As Long

        If Not SB.Visible Then Exit Function
        If X < SB.Left Or X >= SB.Left + SB.Width Then Exit Function
        If Y < SB.Top Or Y >= SB.Top + SB.Height Then Exit Function

        SB_GetMetrics BtnSize, TrackTop, TrackLen, ThumbTop, ThumbLen

        If Y < TrackTop Then
            SB_HitTest = sbpUpButton
        ElseIf Y >= TrackTop + TrackLen Then
            SB_HitTest = sbpDownButton
        ElseIf Y < ThumbTop Then
            SB_HitTest = sbpTrackUp
        ElseIf Y >= ThumbTop + ThumbLen Then
            SB_HitTest = sbpTrackDown
        Else
            SB_HitTest = sbpThumb
        End If
    End Function

    Private Sub SB_DoStep(ByVal Part As eSbPart)
        Select Case Part
            Case sbpUpButton:   SB_SetValue SB.Value - SB.SmallChange, False
            Case sbpDownButton: SB_SetValue SB.Value + SB.SmallChange, False
            Case sbpTrackUp:    SB_SetValue SB.Value - SB.LargeChange, False
            Case sbpTrackDown:  SB_SetValue SB.Value + SB.LargeChange, False
        End Select
    End Sub

    Private Function SB_MouseDown(ByVal Button As Integer, ByVal X As Long, ByVal Y As Long) As Boolean
        Dim BtnSize As Long, TrackTop As Long, TrackLen As Long, ThumbTop As Long, ThumbLen As Long
        Dim Part As eSbPart

        If Not SB.Visible Then Exit Function
        If X < SB.Left Then Exit Function
        SB_MouseDown = True
        If Button <> vbLeftButton Then Exit Function

        Timer1_SetEnabled False   'antes: ucScrollbar1_MouseDown -> Timer1.Enabled = False

        Part = SB_HitTest(X, Y)
        SB.PressedPart = Part
        Select Case Part
            Case sbpThumb
                SB_GetMetrics BtnSize, TrackTop, TrackLen, ThumbTop, ThumbLen
                SB.DragOffset = Y - ThumbTop
            Case sbpUpButton, sbpDownButton, sbpTrackUp, sbpTrackDown
                SB_DoStep Part
                SB.RepeatStarted = False
                If m_hWndSubclassed Then SetTimer m_hWndSubclassed, TIMER_SCROLL, 350, 0
        End Select
        Draw
    End Function

    Private Function SB_MouseMove(ByVal X As Long, ByVal Y As Long) As Boolean
        Dim BtnSize As Long, TrackTop As Long, TrackLen As Long, ThumbTop As Long, ThumbLen As Long
        Dim Part As eSbPart

        If SB.PressedPart = sbpThumb Then
            SB_GetMetrics BtnSize, TrackTop, TrackLen, ThumbTop, ThumbLen
            If TrackLen - ThumbLen > 0 Then
                SB_SetValue CLng(CDbl(Y - SB.DragOffset - TrackTop) * SB.Max / (TrackLen - ThumbLen)), True
            End If
            SB_MouseMove = True
            Exit Function
        End If

        If SB.PressedPart <> sbpNone Then SB_MouseMove = True: Exit Function

        Part = SB_HitTest(X, Y)
        If Part <> SB.HotPart Then
            SB.HotPart = Part
            Draw
        End If
        If SB.Visible And X >= SB.Left Then SB_MouseMove = True
    End Function

    Private Function SB_MouseUp() As Boolean
        Dim WasThumb As Boolean
        If SB.PressedPart = sbpNone Then Exit Function
        SB_MouseUp = True
        WasThumb = (SB.PressedPart = sbpThumb)
        SB_StopRepeat
        SB.PressedPart = sbpNone
        Timer1_SetEnabled True    'antes: ucScrollbar1_MouseUp -> Timer1.Enabled = True
        If WasThumb Then
            ucScrollbar1_Change
        Else
            Draw
        End If
    End Function

    Private Sub SB_StopRepeat()
        If m_hWndSubclassed Then KillTimer m_hWndSubclassed, TIMER_SCROLL
    End Sub

    Private Sub SB_RepeatTick()
        Dim PT As POINTAPI
        Dim tR As RECT

        If Not SB.RepeatStarted Then
            SB.RepeatStarted = True
            SetTimer m_hWndSubclassed, TIMER_SCROLL, 50, 0
        End If

        If (GetAsyncKeyState(vbLeftButton) >= 0) Then
            SB_MouseUp
            Exit Sub
        End If

        ' Solo repetir si el cursor sigue sobre la parte pulsada
        GetCursorPos PT
        GetWindowRect UserControl.hWnd, tR
        If SB_HitTest(PT.X - tR.Left, PT.Y - tR.Top) = SB.PressedPart Then
            SB_DoStep SB.PressedPart
        End If
    End Sub

    Private Sub SB_MouseWheel(ByVal Delta As Long)
        If Not SB.Visible Or Not SB.WheelEnabled Then Exit Sub
        SB_SetValue SB.Value - (Delta * SB.WheelChange) \ 120, False
    End Sub

    Private Sub SB_Paint(ByVal lHdc As LongPtr)
        Dim BtnSize As Long, TrackTop As Long, TrackLen As Long, ThumbTop As Long, ThumbLen As Long
        Dim rc As RECT
        Dim hTheme As LongPtr
        Dim lState As Long
        Dim lColor As Long

        If Not SB.Visible Then Exit Sub
        If SB.Width <= 0 Or SB.Height <= 0 Then Exit Sub

        SB_GetMetrics BtnSize, TrackTop, TrackLen, ThumbTop, ThumbLen

        If SB.Style = sThemed Then hTheme = OpenThemeData(UserControl.hWnd, StrPtr("SCROLLBAR"))

        If hTheme <> 0 Then
            '----- Estilo Microsoft (con tema de Windows)
            SetRect rc, SB.Left, TrackTop, SB.Left + SB.Width, TrackTop + TrackLen
            DrawThemeBackground hTheme, lHdc, SBP_LOWERTRACKVERT, 1, rc, 0

            If BtnSize > 0 Then
                SetRect rc, SB.Left, SB.Top, SB.Left + SB.Width, SB.Top + BtnSize
                DrawThemeBackground hTheme, lHdc, SBP_ARROWBTN, ABS_UPNORMAL + SB_PartState(sbpUpButton) - 1, rc, 0
                SetRect rc, SB.Left, SB.Top + SB.Height - BtnSize, SB.Left + SB.Width, SB.Top + SB.Height
                DrawThemeBackground hTheme, lHdc, SBP_ARROWBTN, ABS_DOWNNORMAL + SB_PartState(sbpDownButton) - 1, rc, 0
            End If

            If SB.Max > 0 Then
                lState = SB_PartState(sbpThumb)
                SetRect rc, SB.Left, ThumbTop, SB.Left + SB.Width, ThumbTop + ThumbLen
                DrawThemeBackground hTheme, lHdc, SBP_THUMBBTNVERT, lState, rc, 0
                DrawThemeBackground hTheme, lHdc, SBP_GRIPPERVERT, lState, rc, 0
            End If
            CloseThemeData hTheme

        ElseIf SB.Style = sThemed Then
            '----- Estilo Microsoft clasico (sin temas)
            SetRect rc, SB.Left, SB.Top, SB.Left + SB.Width, SB.Top + SB.Height
            FillRectangle lHdc, rc, vbScrollBars
            If BtnSize > 0 Then
                SetRect rc, SB.Left, SB.Top, SB.Left + SB.Width, SB.Top + BtnSize
                DrawFrameControl lHdc, rc, DFC_SCROLL, DFCS_SCROLLUP Or IIf(SB.PressedPart = sbpUpButton, DFCS_PUSHED, 0)
                SetRect rc, SB.Left, SB.Top + SB.Height - BtnSize, SB.Left + SB.Width, SB.Top + SB.Height
                DrawFrameControl lHdc, rc, DFC_SCROLL, DFCS_SCROLLDOWN Or IIf(SB.PressedPart = sbpDownButton, DFCS_PUSHED, 0)
            End If
            If SB.Max > 0 Then
                SetRect rc, SB.Left, ThumbTop, SB.Left + SB.Width, ThumbTop + ThumbLen
                FillRectangle lHdc, rc, vbButtonFace
                DrawEdge lHdc, rc, EDGE_RAISED, BF_RECT_MIDDLE
            End If

        Else
            '----- Estilo Google (dibujo personalizado, antes ucScrollbar1_OnPaint)
            SetRect rc, SB.Left, SB.Top, SB.Left + SB.Width, SB.Top + SB.Height
            FillRectangle lHdc, rc, UserControl.BackColor

            If SB.Max > 0 Then
                lState = SB_PartState(sbpThumb)
                If IsDarkColor(UserControl.BackColor) Then
                    If lState = 2 Then
                        lColor = ShiftColor(UserControl.BackColor, vbWhite, 180)
                    ElseIf lState = 3 Then
                        lColor = ShiftColor(UserControl.BackColor, vbWhite, 150)
                    Else
                        lColor = ShiftColor(UserControl.BackColor, vbWhite, 200)
                    End If
                Else
                    If lState = 2 Then
                        lColor = ShiftColor(UserControl.BackColor, vbBlack, 220)
                    ElseIf lState = 3 Then
                        lColor = ShiftColor(UserControl.BackColor, vbBlack, 180)
                    Else
                        lColor = ShiftColor(UserControl.BackColor, vbBlack, 200)
                    End If
                End If
                RoundRectPlus lHdc, SB.Left, ThumbTop, SB.Width - DpiFactor, ThumbLen - DpiFactor, RGBtoARGB(lColor, 100), 0, SB.Width - 1
            End If
        End If
    End Sub

    ' 1 = normal, 2 = hot, 3 = pressed
    Private Function SB_PartState(ByVal Part As eSbPart) As Long
        If SB.PressedPart = Part Then
            SB_PartState = 3
        ElseIf SB.HotPart = Part Then
            SB_PartState = 2
        Else
            SB_PartState = 1
        End If
    End Function

    '======================================================================
    ' Eventos del UserControl
    '======================================================================
    ' cShadow.Refresh vuelve a mostrar la ventana de sombra; en una lista desplegable
    ' solo debe hacerse mientras esta abierta.
    Private Sub RefreshShadow()
        If isWinChild Or bShow Then cShadow.Refresh
    End Sub

    Private Sub UserControl_AmbientChanged(PropertyName As String)
        If isWinChild Then
            If PropertyName = "BackColor" Then
                If m_BorderVisible Then cShadow.Refresh
            End If
        End If
    End Sub

    Private Sub UserControl_DblClick()
        RaiseEvent DblClick
    End Sub

    Private Sub UserControl_EnterFocus()
        bHasFocus = True
        If isWinChild Then
            With cShadow
                .ShadowOpacity = 25
                .ShadowColor = m_SelectionColor
                .BorderColor = m_SelectionColor
                If m_BorderVisible Then .Refresh
            End With
            Draw
        End If
    End Sub

    Private Sub UserControl_ExitFocus()
        bHasFocus = False
        If isWinChild Then
            With cShadow
                .ShadowOpacity = 10
                .ShadowColor = vbBlack
                .BorderColor = m_BorderColor
                If m_BorderVisible Then .Refresh
            End With
            If UserControl.Extender.Visible Then Draw
        End If
    End Sub

    Private Sub UserControl_Hide()
        cShadow.HideBorders
    End Sub

    Private Sub UserControl_Initialize()
        Set cImageList = New Collection
        Set cShadow = New ClsShadow  '<---GdiplusStartup
        cShadow.ShadowSize = 2
        SB.ShowButtons = False
        SB.Style = sCustomDraw
        m_TimerEnabled = True
        m_TimerTag = -1
        m_Index = -1
        m_HotItem = -1
        ReDim m_Items(0)
    End Sub

    Private Sub UserControl_KeyDown(KeyCode As Integer, Shift As Integer)
        Call Text1_KeyDown(KeyCode, Shift)
        RaiseEvent KeyDown(KeyCode, Shift)
    End Sub

    Friend Sub TakeCommand()
        Set ChildMenu = Nothing
        bKillFocus = False
        RegisterHotsKeys
        cShadow.DrawBitmap UserControl.Image.Handle, UserControl.hWnd, UserControl.ScaleWidth, UserControl.ScaleHeight
        SetParent UserControl.hWnd, m_PhWnd
        PutFocus UserControl.hWnd
        SetParent UserControl.hWnd, 0
        bKillFocus = False
        bTimerSkipRoutines = False
        SubMenuVisible = False
    End Sub

    Friend Sub GiveCommand()
        bTimerSkipRoutines = True
        SubMenuVisible = True
        UnRegisterHotsKeys
    End Sub

    Private Sub UserControl_KeyPress(KeyAscii As Integer)
        Dim i As Long
        Dim lPos As Long, sChar As String

        RaiseEvent KeyPress(KeyAscii)

        If m_ListStyle = StyleMenu Then
            For i = 0 To mListCount - 1
                With m_Items(i)
                    If Not .Disabled And Not .IsGroup And Not .Separator Then
                        lPos = InStr(.Text, "&")
                        If lPos Then
                            sChar = Mid$(.Text, lPos + 1, 1)
                            If UCase$(ChrW$(KeyAscii)) = UCase$(sChar) Then
                                m_Index = i
                                HideList
                                RaiseItemClick
                                Exit Sub
                            End If
                        End If
                    End If
                End With
            Next

            Beep
            Exit Sub
        End If

        For i = m_Index + 1 To mListCount - 1
            With m_Items(i)
                If Not .Disabled And Not .IsGroup Then
                    If UCase$(ChrW$(KeyAscii)) = UCase$(Left$(.Text, 1)) Then
                        m_Index = i
                        FocusItem m_Index
                        Draw
                        RaiseIndexChange
                        Exit Sub
                    End If
                End If
            End With
        Next

        For i = 0 To m_Index - 1
            With m_Items(i)
                If Not .Disabled And Not .IsGroup Then
                    If UCase$(ChrW$(KeyAscii)) = UCase$(Left$(.Text, 1)) Then
                        m_Index = i
                        FocusItem m_Index
                        Draw
                        RaiseIndexChange
                        Exit Sub
                    End If
                End If
            End With
        Next
    End Sub

    Private Sub UserControl_KeyUp(KeyCode As Integer, Shift As Integer)
        RaiseEvent KeyUp(KeyCode, Shift)
    End Sub

    Private Sub UserControl_MouseDown(Button As Integer, Shift As Integer, X As Single, Y As Single)
        ' Clic sobre la barra de desplazamiento interna
        If SB_MouseDown(Button, X, Y) Then Exit Sub

        If Button = vbLeftButton Then
            ' Si no llego un MouseMove previo (o un WM_MOUSELEAVE lo borro), se
            ' calcula el elemento bajo el cursor para no perder el clic.
            If m_HotItem = -1 Then m_HotItem = HotItemFromY(Y)
            If m_HotItem <> -1 Then

                If isWinChild Then
                    m_Index = m_HotItem
                    bMouseDown = True
                    Draw
                    RaiseIndexChange
                Else
                    If m_Items(m_HotItem).SubMenu Is Nothing Then
                        bMouseDown = True
                        Draw
                    Else
                        bShowSubMenu = False
                        m_TimerTag = m_HotItem
                        TimerShowMenu
                    End If
                End If
            End If
        End If

        RaiseEvent MouseDown(Button, Shift, X, Y)
    End Sub

    Private Sub UserControl_MouseMove(Button As Integer, Shift As Integer, X As Single, Y As Single)
        Dim HotItem As Long
        Dim lTop As Long
        Dim i As Long
        Dim ET As TRACKMOUSEEVENTTYPE

        EnsureSubclass

        If isWinChild Then
            Timer1_SetInterval 100 'para detectar cuando el raton sale del control
        Else
            ET.cbSize = LenB(ET)
            ET.hwndTrack = UserControl.hWnd
            ET.dwFlags = TME_LEAVE
            TrackMouseEvent ET
        End If

        If SB_MouseMove(X, Y) Then Exit Sub

        HotItem = -1
        lTop = ListTop - SB.Value

        For i = 0 To mListCount - 1
            With m_Items(i)
                If .Visible Then
                    If Y >= lTop And Y < lTop + IH Then
                        If Not .Separator And Not .IsGroup And Not .Disabled Then
                            HotItem = i
                            Exit For
                        Else
                            HotItem = -1
                        End If
                    End If
                    If Not .Separator Then
                        lTop = lTop + IH
                    Else
                        lTop = lTop + IH / 2
                    End If
                    If lTop - SB.Value > UserControl.ScaleHeight Then Exit For
                End If
            End With
        Next

        If HotItem <> m_HotItem Then
            m_HotItem = HotItem

            If HotItem <> -1 Then
                If Not m_Items(HotItem).SubMenu Is Nothing Then
                    bHideSubMenu = False
                    bShowSubMenu = True
                    TickCount = 0
                    m_TimerTag = HotItem
                Else
                    bHideSubMenu = True
                    bShowSubMenu = False
                    TickCount = 0
                    m_TimerTag = -1
                End If
            End If

            Draw
        End If
        RaiseEvent MouseMove(Button, Shift, X, Y)
    End Sub

    Public Property Get hWnd() As LongPtr
        hWnd = UserControl.hWnd
    End Property

    Private Sub UserControl_MouseUp(Button As Integer, Shift As Integer, X As Single, Y As Single)
        Dim sText As String

        If SB_MouseUp() Then Exit Sub
        If bMouseDown = False Then Exit Sub

        bMouseDown = False
        If m_HotItem = -1 Then m_HotItem = HotItemFromY(Y)
        If m_HotItem <> -1 Then
            m_Index = m_HotItem

            If m_MultiSelect Then

                m_Items(m_Index).Checked = Not m_Items(m_Index).Checked
                Draw
                RaiseItemClick
            Else
                If isWinChild Then
                    Draw
                Else
                    If m_Items(m_Index).SubMenu Is Nothing Then
                        HideList
                    End If
                End If

                RaiseItemClick

                If SrcTextBox <> 0 Then
                    bTimerSkipRoutines = True
                    sText = m_Items(m_Index).Text
                    TextBox_SetText SrcTextBox, sText
                    TextBox_SelStart SrcTextBox, Len(sText)
                    bTimerSkipRoutines = False
                    RaiseEvent PostAutoComplete
                End If

            End If
        End If
        RaiseEvent MouseUp(Button, Shift, X, Y)
    End Sub

    Private Sub LoadFontsIcons()
        Set m_SegoeFont = New StdFont
        m_SegoeFont.Name = "Segoe MDL2 Assets"

        If m_SegoeFont.Name = "Segoe MDL2 Assets" Then
            isSegoeFontInstaled = True
        Else
            Set m_SegoeFont = Nothing
            Set m_Wingdings2 = New StdFont
            Set m_Wingdings3 = New StdFont
            m_Wingdings2.Name = "Wingdings 2"
            m_Wingdings3.Name = "Wingdings 3"
            isSegoeFontInstaled = False
        End If
    End Sub

    Private Sub UserControl_InitProperties()
        Dim i As Long

        DpiFactor = cShadow.GetWindowsDPI
        Me.ItemHeight = 32
        m_ListWidth = 250
        Me.BorderRadius = 10
        m_SelectionColor = vbHighlight
        m_LineColor = vbActiveBorder
        m_BorderColor = vbActiveBorder
        lMargin = 8 * DpiFactor
        lCheckSize = 16 * DpiFactor
        m_FindTextColor = ShiftColor(vbHighlight, UserControl.BackColor, 200)
        m_HotItem = -1
        m_BorderVisible = True
        SB_ApplyDesign

        Call LoadFontsIcons

        Edit_SetText vbNullString

        If Ambient.UserMode Then
            ' Control creado sin propiedades guardadas (p. ej. en un formulario cuyo
            ' .tbform no incluye _IPersistStreamData): estilo DropDown, oculto y sin
            ' elementos de ejemplo. El estilo se puede cambiar desde codigo.
            m_Index = -1
            isWinChild = False
            EnsureSubclass
            UserControl.Extender.Visible = False
            Exit Sub
        End If

        For i = 1 To 7
            If i Mod 3 = 0 Then
                AddItem "-"
            Else
                AddItem "Item " & i, , , "Sub Text", i = 5, i = 3
            End If
        Next
        m_Index = 3

        DrawDesignIcon
    End Sub

    Private Sub UserControl_OLECompleteDrag(Effect As Long)
        RaiseEvent OLECompleteDrag(Effect)
    End Sub

    Private Sub UserControl_OLEDragDrop(Data As DataObject, Effect As Long, Button As Integer, Shift As Integer, X As Single, Y As Single)
        RaiseEvent OLEDragDrop(Data, Effect, Button, Shift, UserControl.ScaleX(X, vbPixels, vbContainerPosition), UserControl.ScaleY(Y, vbPixels, vbContainerPosition))
    End Sub

