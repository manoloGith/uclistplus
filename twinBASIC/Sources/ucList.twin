    Public Property Get Font() As StdFont
        Set Font = UserControl.Font
    End Property

    Public Property Set Font(new_Font As StdFont)
        With UserControl.Font
            .Name = new_Font.Name
            .Size = new_Font.Size
            .Bold = new_Font.Bold
            .Italic = new_Font.Italic
            .Underline = new_Font.Underline
            .Strikethrough = new_Font.Strikethrough
            .Weight = new_Font.Weight
            .Charset = new_Font.Charset
        End With
        UserControl.PropertyChanged "Font"
        If isWinChild Then Draw
    End Property

    Public Property Get ListStyle() As eListStyle
        ListStyle = m_ListStyle
    End Property

    Public Property Let ListStyle(ByVal New_Value As eListStyle)

        If Ambient.UserMode Then
            ' En ejecucion (twinBASIC): permite configurar el estilo desde codigo
            ' sin cambiar el tamano que tiene el control en el formulario.
            If bShow Then HideList
            m_ListStyle = New_Value
            isWinChild = (New_Value = StyleListBox)
            EnsureSubclass
            If isWinChild Then
                m_HotItem = -1
                UserControl.Extender.Visible = True
                Update
            Else
                cShadow.HideBorders
                UserControl.Extender.Visible = False
            End If
            Exit Property
        End If

        If New_Value = StyleListBox Then
            isWinChild = True
            UserControl.Size 150 * Screen.TwipsPerPixelX, 200 * Screen.TwipsPerPixelY
        Else
            isWinChild = False
            UserControl.Size 32 * Screen.TwipsPerPixelX, 32 * Screen.TwipsPerPixelY
        End If
        m_ListStyle = New_Value

        UserControl.PropertyChanged "ListStyle"
        If isWinChild Then Update Else DrawDesignIcon
    End Property

    Public Function ItemHitest(ByVal Y As Long) As Long
        Dim Item As Long
        Dim lTop As Long
        Dim i As Long
        Item = -1
        For i = 0 To mListCount - 1
            With m_Items(i)
                If .Visible Then
                    If Y >= lTop And Y < lTop + IH Then
                        If Not .Separator And Not .IsGroup And Not .Disabled Then
                            Item = i
                            Exit For
                        Else
                            Item = -1
                        End If
                    End If
                    If Not .Separator Then
                        lTop = lTop + IH
                    Else
                        lTop = lTop + IH / 2
                    End If
                    If lTop - SB.Value > UserControl.ScaleHeight Then Exit For
                End If
            End With
        Next

        ItemHitest = Item
    End Function

