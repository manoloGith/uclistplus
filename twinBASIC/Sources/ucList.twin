    Public Sub BSort(ByVal SortOrder As eSortOrder)
        Dim i As Long
        Dim bResult As Boolean
        Dim Item As tItem
        Dim Sorted As Boolean

        If mListCount < 2 Then Draw: Exit Sub

        Do While Not Sorted
            Sorted = True
            For i = 0 To mListCount - 2
                If SortOrder = SortAscendant Then
                    bResult = StrComp(m_Items(i).Text, m_Items(i + 1).Text, vbTextCompare) = 1
                Else
                    bResult = StrComp(m_Items(i).Text, m_Items(i + 1).Text, vbTextCompare) = -1
                End If

                If bResult Then
                    Item = m_Items(i + 1)
                    m_Items(i + 1) = m_Items(i)
                    m_Items(i) = Item
                    Sorted = False
                End If
            Next
        Loop
        Draw
    End Sub

    Public Sub QSort(ByVal SortOrder As eSortOrder)
        If mListCount < 2 Then Draw: Exit Sub
        If SortOrder = SortAscendant Then
            QuickSortAsc 0, mListCount - 1
        Else
            QuickSortDes 0, mListCount - 1
        End If
        Draw
    End Sub

    Private Sub QuickSortAsc(ByVal First As Long, ByVal Last As Long)
        '  Made by Michael Ciurescu (CVMichael from vbforums.com)
        '  Original thread: http://www.vbforums.com/showthread.php?t=231925
        Dim Low As Long, High As Long
        Dim MidValue As String
        Dim Item As tItem

        Low = First
        High = Last
        MidValue = m_Items((First + Last) \ 2).Text

        Do
            While StrComp(m_Items(Low).Text, MidValue, vbTextCompare) = -1
                Low = Low + 1
            Wend

            While StrComp(MidValue, m_Items(High).Text, vbTextCompare) = -1
                High = High - 1
            Wend

            If Low <= High Then
                Item = m_Items(Low)
                m_Items(Low) = m_Items(High)
                m_Items(High) = Item

                Low = Low + 1
                High = High - 1
            End If
        Loop While Low <= High

        If First < High Then QuickSortAsc First, High
        If Low < Last Then QuickSortAsc Low, Last
    End Sub

    Private Sub QuickSortDes(ByVal First As Long, ByVal Last As Long)
        '  Made by Michael Ciurescu (CVMichael from vbforums.com)
        '  Original thread: http://www.vbforums.com/showthread.php?t=231925
        Dim Low As Long, High As Long
        Dim MidValue As String
        Dim Item As tItem

        Low = First
        High = Last
        MidValue = m_Items((First + Last) \ 2).Text

        Do
            While StrComp(MidValue, m_Items(Low).Text, vbTextCompare) = -1
                Low = Low + 1
            Wend

            While StrComp(m_Items(High).Text, MidValue, vbTextCompare) = -1
                High = High - 1
            Wend

            If Low <= High Then
                Item = m_Items(Low)
                m_Items(Low) = m_Items(High)
                m_Items(High) = Item

                Low = Low + 1
                High = High - 1
            End If
        Loop While Low <= High

        If First < High Then QuickSortDes First, High
        If Low < Last Then QuickSortDes Low, Last
    End Sub

