    '======================================================================
    ' Lista emergente: ShowList / HideList
    '======================================================================
    ' Left/Top: esquina superior izquierda (pixeles de pantalla).
    ' BtnLeft/BtnTop: si la lista no cabe a la derecha/abajo, se coloca para
    ' que su borde derecho/inferior quede en BtnLeft/BtnTop.
    Public Sub ShowList(Left As Long, Top As Long, Optional BtnLeft As Long, Optional BtnTop As Long)
        Dim W As Long, H As Long, lHead As Long, lCap As Long, lSaveIndex As Long
        Dim mi As MONITORINFO
        Dim X As Long, Y As Long

        If m_ListStyle = StyleListBox Then Exit Sub
        If Not Ambient.UserMode Then Exit Sub
        If Not UserControl.Enabled Then Exit Sub
        If bShow Then HideList
        m_hPrevFocus = GetFocus()

        EnsureRuntime
        ' La emergente pertenece al formulario actual del control
        If m_hList <> 0 Then
            If m_hOwner <> GetAncestor(UserControl.ContainerHwnd, GA_ROOT) Then DestroyListWindow
        End If
        If m_hList = 0 Then
            If Not CreateListWindow(True) Then Exit Sub
        End If
        EnsureEdit

        m_HotItem = -1
        bMouseDown = False
        m_BtnTop = 0
        m_SubPending = -1
        sbPressed = SBP_NONE
        sbHot = SBP_NONE
        sbValue = 0

        ' Filtro vacio al abrir (todos los elementos visibles) conservando ListIndex
        lSaveIndex = m_Index
        SetEditText vbNullString
        ApplyFilter vbNullString
        m_Index = lSaveIndex

        lHead = HeaderHeight()
        H = lHead + ContentHeight() + lMargin
        W = m_ListWidth * DpiFactor
        If W < 16 Then W = 16

        ' Limites: MaxVisibleItems / MaxListHeight / monitor
        If m_MaxVisibleItems > 0 Then
            lCap = lHead + IH * m_MaxVisibleItems + lMargin
        ElseIf m_MaxListHeight > 0 Then
            lCap = m_MaxListHeight * DpiFactor
        End If
        If lCap > 0 And H > lCap Then H = lCap

        mi.cbSize = LenB(mi)
        GetMonitorInfoW MonitorFromPoint(Left, Top, MONITOR_DEFAULTTONEAREST), mi
        With mi.rcWork
            If H > .Bottom - .Top Then H = .Bottom - .Top
            X = Left: Y = Top
            If Y + H > .Bottom Then
                If BtnTop > 0 Then
                    m_BtnTop = BtnTop
                    Y = BtnTop - H
                Else
                    Y = .Bottom - H
                End If
            End If
            If Y < .Top Then Y = .Top
            If X + W > .Right Then
                If BtnLeft > 0 Then
                    X = BtnLeft - W
                Else
                    X = .Right - W
                End If
            End If
            If X < .Left Then X = .Left
        End With

        SetWindowPos m_hList, HWND_TOPMOST, X, Y, W, H, SWP_NOACTIVATE
        m_LayoutDirty = True
        Layout
        ApplyRegion m_hList, W, H
        If m_Index > -1 And m_Index < mListCount Then FocusItem m_Index, False

        bShow = True
        m_ShowGen = m_ShowGen + 1

        If m_BorderVisible Then
            cShadow.BackColor = UserControl.BackColor
            cShadow.BorderColor = m_BorderColor
            cShadow.ShowBorders m_hList, False
        End If
        SetWindowPos m_hList, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOMOVE Or SWP_NOSIZE Or SWP_NOACTIVATE Or SWP_SHOWWINDOW
        If m_BorderVisible Then cShadow.Refresh
        UpdateWindow m_hList

        ' Teclado y clics fuera mientras este abierta
        UCL_PopupAdd ObjPtr(Me)
        If m_hOwner <> 0 And m_hOwnerSub = 0 Then
            If UCL_SubclassList(m_hOwner, ObjPtr(Me)) Then m_hOwnerSub = m_hOwner
        End If

        ' Como el original (PutFocus Text1.hWnd): con filtro y sin TextBox de
        ' autocompletar, el EDIT recibe el foco para que se vea el cursor.
        ' Se publica para que ocurra despues del clic que abrio la lista (un
        ' boton toma el foco al terminar de procesar su WM_LBUTTONDOWN).
        If m_ShowFilter And m_hEdit <> 0 And m_hSrc = 0 Then PostMessageW m_hList, WM_UCL_FOCUSEDIT, m_ShowGen, 0
    End Sub

    Public Sub HideList()
        Dim oChild As ucList, oParent As ucList
        If Not bShow Then Exit Sub
        bShow = False

        If Not ChildMenu Is Nothing Then
            Set oChild = ChildMenu
            Set ChildMenu = Nothing
            Set oChild.ParentMenu = Nothing
            oChild.HideList
            Set oChild = Nothing
        End If

        UCL_PopupRemove ObjPtr(Me)
        If m_hOwnerSub <> 0 Then
            UCL_UnsubclassList m_hOwnerSub, ObjPtr(Me)
            m_hOwnerSub = 0
        End If
        If m_hList <> 0 Then
            KillTimer m_hList, TIMER_SUBMENU
            KillTimer m_hList, TIMER_SCROLL
            If GetCapture() = m_hList Then ReleaseCapture
        End If
        Erase m_KeySwallowed
        m_SubPending = -1
        bMouseDown = False
        bTracking = False
        m_HotItem = -1
        sbPressed = SBP_NONE

        ' Si el foco esta dentro de la emergente (filtro), se devuelve a la
        ' ventana que lo tenia al abrirla (o al formulario).
        If m_hList <> 0 Then
            If zzOwnsWindow(GetFocus()) Then
                If m_hPrevFocus <> 0 And IsWindow(m_hPrevFocus) <> 0 Then
                    SetFocusAPI m_hPrevFocus
                ElseIf m_hOwner <> 0 And IsWindow(m_hOwner) <> 0 Then
                    SetActiveWindow m_hOwner
                End If
            End If
        End If
        m_hPrevFocus = 0

        cShadow.HideBorders
        If m_hList <> 0 Then ShowWindow m_hList, SW_HIDE

        If Not ParentMenu Is Nothing Then
            Set oParent = ParentMenu
            Set ParentMenu = Nothing
            oParent.HideList
            Set oParent = Nothing
        End If
        RaiseEvent HideList
    End Sub

    ' Ajusta el alto de la emergente abierta (al filtrar)
    Private Sub ResizePopup()
        Dim H As Long, lHead As Long, lCap As Long, Y As Long
        Dim mi As MONITORINFO
        Dim rc As RECT
        If Not bShow Or m_hList = 0 Then Exit Sub
        GetWindowRect m_hList, rc
        lHead = HeaderHeight()
        H = lHead + ContentHeight() + lMargin
        If m_MaxVisibleItems > 0 Then
            lCap = lHead + IH * m_MaxVisibleItems + lMargin
        ElseIf m_MaxListHeight > 0 Then
            lCap = m_MaxListHeight * DpiFactor
        End If
        If lCap > 0 And H > lCap Then H = lCap
        mi.cbSize = LenB(mi)
        GetMonitorInfoW MonitorFromPoint(rc.Left, rc.Top, MONITOR_DEFAULTTONEAREST), mi
        If H > mi.rcWork.Bottom - mi.rcWork.Top Then H = mi.rcWork.Bottom - mi.rcWork.Top
        If H < lHead + lMargin Then H = lHead + lMargin
        Y = rc.Top
        If m_BtnTop > 0 Then Y = m_BtnTop - H
        If Y + H > mi.rcWork.Bottom Then Y = mi.rcWork.Bottom - H
        If Y < mi.rcWork.Top Then Y = mi.rcWork.Top
        SetWindowPos m_hList, HWND_TOPMOST, rc.Left, Y, rc.Right - rc.Left, H, SWP_NOACTIVATE
        m_LayoutDirty = True
        Layout
        ApplyRegion m_hList, rc.Right - rc.Left, H
        If m_BorderVisible Then cShadow.Refresh
    End Sub

    '======================================================================
    ' Llamados por los ganchos de mUcListHelpers (sobre la instancia)
    '======================================================================
    Public Function zzOwnsWindow(ByVal hWnd As LongPtr) As Boolean
        If m_hList = 0 Or hWnd = 0 Then Exit Function
        If hWnd = m_hList Then
            zzOwnsWindow = True
        ElseIf IsChild(m_hList, hWnd) <> 0 Then
            zzOwnsWindow = True
        End If
    End Function

    Public Sub zzRequestClose()
        If bShow And m_hList <> 0 Then PostMessageW m_hList, WM_UCL_CLOSE, m_ShowGen, 0
    End Sub

    Public Function zzHookWheel(ByVal hTarget As LongPtr, ByVal ptX As Long, ByVal ptY As Long, ByVal lMouseData As Long) As Boolean
        Dim rc As RECT
        If Not bShow Or m_hList = 0 Then Exit Function
        If zzOwnsWindow(hTarget) Then Exit Function     'ya le llega directamente
        GetWindowRect m_hList, rc
        If ptX >= rc.Left And ptX < rc.Right And ptY >= rc.Top And ptY < rc.Bottom Then
            PostMessageW m_hList, WM_UCL_WHEEL, HiWordSigned(lMouseData), 0
            zzHookWheel = True
        End If
    End Function

    ' Gancho de teclado: decide si la tecla es para la lista abierta. Devuelve
    ' True para que el mensaje NO llegue al control con el foco. La logica se
    ' ejecuta despues, con mensajes publicados a la ventana de la lista.
    Public Function zzHookKey(ByVal bAction As Boolean, ByVal vk As Long, ByVal lParam As LongPtr) As Boolean
        Dim bUp As Boolean
        Dim kState(0 To 255) As Byte
        Dim sBuf As String
        Dim n As Long, i As Long
        Dim bCtrl As Boolean

        If Not bShow Or m_hList = 0 Then Exit Function
        If vk < 0 Or vk > 255 Then Exit Function
        bUp = (lParam And &H80000000) <> 0

        Select Case vk
            Case vbKeyTab
                ' Tab cierra la lista y SIGUE su camino (el foco pasa al siguiente
                ' control). Si el foco esta en el filtro de la emergente, la tecla
                ' se consume: al cerrar, el foco vuelve a donde estaba.
                If bAction And Not bUp Then PostMessageW m_hList, WM_UCL_KEY, vk, ShiftState()
                If zzOwnsWindow(GetFocus()) Then zzHookKey = True
                Exit Function

            Case vbKeyUp, vbKeyDown, vbKeyHome, vbKeyEnd, vbKeyPageUp, vbKeyPageDown, _
                 vbKeyReturn, vbKeyEscape, vbKeyLeft, vbKeyRight
                ' Teclas de navegacion: siempre para la lista (como RegisterHotKey)
                If bAction And Not bUp Then PostMessageW m_hList, WM_UCL_KEY, vk, ShiftState()
                zzHookKey = True
                Exit Function
        End Select

        If bUp Then
            If m_KeySwallowed(vk) Then
                If bAction Then m_KeySwallowed(vk) = False
                zzHookKey = True
            End If
            Exit Function
        End If

        ' Autocompletar: el resto de teclas va al TextBox
        If m_hSrc <> 0 Then Exit Function
        If GetKeyState(VK_MENU) < 0 Then Exit Function
        bCtrl = GetKeyState(VK_CONTROL) < 0

        If m_ShowFilter And m_hEdit <> 0 Then
            If bCtrl Then
                Select Case vk
                    Case vbKeyA: n = EDITCMD_SELALL
                    Case vbKeyC: n = EDITCMD_COPY
                    Case vbKeyV: n = EDITCMD_PASTE
                    Case vbKeyX: n = EDITCMD_CUT
                End Select
                If n <> 0 Then
                    If bAction Then
                        PostMessageW m_hList, WM_UCL_EDITCMD, n, 0
                        m_KeySwallowed(vk) = True
                    End If
                    zzHookKey = True
                End If
                Exit Function
            End If
            If vk = VK_DELETE Then
                If bAction Then
                    PostMessageW m_hList, WM_UCL_EDITCMD, EDITCMD_DELETE, 0
                    m_KeySwallowed(vk) = True
                End If
                zzHookKey = True
                Exit Function
            End If
        ElseIf bCtrl Then
            Exit Function
        End If

        ' Caracter producido por la tecla (texto del filtro o letra del menu)
        If Not bAction Then
            ' HC_NOREMOVE: solo indicar si se va a consumir
            zzHookKey = (vk = vbKeyBack Or vk = vbKeySpace Or (vk >= &H30 And vk <= &H5A) Or (vk >= &H60 And vk <= &H6F) Or vk >= &HBA)
            Exit Function
        End If
        GetKeyboardState kState(0)
        kState(vk) = &H80
        sBuf = String$(8, vbNullChar)
        n = ToUnicodeEx(vk, CLng((lParam \ &H10000) And &HFF&), kState(0), StrPtr(sBuf), 8, 4, GetKeyboardLayout(0))
        If n > 0 Then
            For i = 1 To n
                PostMessageW m_hList, WM_UCL_CHAR, AscW(Mid$(sBuf, i, 1)) And &HFFFF&, 0
            Next
            m_KeySwallowed(vk) = True
            zzHookKey = True
        End If
    End Function

    Private Function ShiftState() As Integer
        If GetKeyState(VK_SHIFT) < 0 Then ShiftState = ShiftState Or vbShiftMask
        If GetKeyState(VK_CONTROL) < 0 Then ShiftState = ShiftState Or vbCtrlMask
        If GetKeyState(VK_MENU) < 0 Then ShiftState = ShiftState Or vbAltMask
    End Function

    '======================================================================
    ' Submenus
    '======================================================================
    Private Sub ShowSubMenu(ByVal Index As Long)
        Dim rc As RECT
        Dim oChild As ucList
        If Not bShow Or m_hList = 0 Then Exit Sub
        If Index < 0 Or Index > mListCount - 1 Then Exit Sub
        If m_Items(Index).SubMenu Is Nothing Then Exit Sub
        If Not ChildMenu Is Nothing Then
            If ChildMenu Is m_Items(Index).SubMenu Then
                If ChildMenu.IsListVisible Then Exit Sub
            End If
            HideChildMenu
        End If
        m_Index = Index
        Redraw
        GetWindowRect m_hList, rc
        Set oChild = m_Items(Index).SubMenu
        Set ChildMenu = oChild
        Set oChild.ParentMenu = Me
        oChild.ListIndex = -1
        oChild.ShowList rc.Right, rc.Top + GetItemTop(Index) - lMargin, rc.Left
        If Not oChild.IsListVisible Then
            Set ChildMenu = Nothing
            Set oChild.ParentMenu = Nothing
        End If
    End Sub

    Private Sub HideChildMenu()
        Dim oChild As ucList
        If ChildMenu Is Nothing Then Exit Sub
        Set oChild = ChildMenu
        Set ChildMenu = Nothing
        Set oChild.ParentMenu = Nothing
        oChild.HideList
        Redraw
    End Sub

    ' Lo llama un submenu que se cierra con Izquierda/Escape
    Public Sub zzChildMenuClosed()
        Set ChildMenu = Nothing
        Redraw
    End Sub

    '======================================================================
    ' AutoCompleteTextBox
    '======================================================================
    Public Function AutoCompleteTextBox(ByVal oTextBox As LongPtr, Optional ByVal OffsetLeft As Long, Optional ByVal OffsetTop As Long, Optional ByVal OffsetRight As Long, Optional ByVal OffsetBottom As Long)
        If bShow Then HideList
        m_rcSrcOffset.Left = OffsetLeft
        m_rcSrcOffset.Top = OffsetTop
        m_rcSrcOffset.Right = OffsetRight
        m_rcSrcOffset.Bottom = OffsetBottom
        SetSourceTextBox oTextBox
    End Function

    Private Sub SetSourceTextBox(ByVal hWnd As LongPtr)
        If m_hSrc <> 0 Then
            UCL_UnsubclassList m_hSrc, ObjPtr(Me)
            m_hSrc = 0
        End If
        If hWnd = 0 Then Exit Sub
        If IsWindow(hWnd) = 0 Then Exit Sub
        If UCL_SubclassList(hWnd, ObjPtr(Me)) Then
            m_hSrc = hWnd
            m_SrcLastText = WindowText(m_hSrc)
        End If
    End Sub

    ' El usuario cambio el texto del TextBox origen.
    Private Sub SrcTextChanged()
        Dim sText As String
        Dim i As Long, bFound As Boolean
        Dim rc As RECT

        sText = WindowText(m_hSrc)
        If Not bShow Then
            If Len(sText) = 0 Then Exit Sub
            For i = 0 To mListCount - 1
                If Not m_Items(i).IsGroup And Not m_Items(i).Separator Then
                    If InStr(1, m_Items(i).Text, sText, vbTextCompare) > 0 Then bFound = True: Exit For
                End If
            Next
            If Not bFound Then Exit Sub
            GetWindowRect m_hSrc, rc
            With m_rcSrcOffset
                m_ListWidth = ((rc.Right + .Right) - (rc.Left + .Left)) / DpiFactor
                ShowList rc.Left + .Left, rc.Bottom + .Top, 0, rc.Top + .Bottom
            End With
            If Not bShow Then Exit Sub
        ElseIf Len(sText) = 0 Then
            HideList
            Exit Sub
        End If
        ApplyFilter sText
        If VisibleItemsCount = 0 Then HideList
    End Sub

    ' Pone el texto del elemento elegido en el TextBox origen.
    Private Sub CompleteSourceText()
        Dim sText As String
        If m_hSrc = 0 Or m_Index < 0 Or m_Index > mListCount - 1 Then Exit Sub
        sText = m_Items(m_Index).Text
        m_bSettingSrc = True
        SendMessageW m_hSrc, WM_SETTEXT, 0, StrPtr(sText)
        SendMessageW m_hSrc, EM_SETSEL, Len(sText), Len(sText)
        m_SrcLastText = sText
        m_bSettingSrc = False
        RaiseEvent PostAutoComplete
    End Sub

    '======================================================================
    ' Filtro
    '======================================================================
    Private Sub ApplyFilter(ByVal sText As String)
        Dim i As Long, ParentIndex As Long
        m_Filter = sText
        m_Index = -1
        m_HotItem = -1
        VisibleItemsCount = 0
        ParentIndex = -1
        For i = 0 To mListCount - 1
            With m_Items(i)
                If Len(sText) = 0 Then
                    .Visible = True
                    If Not .IsGroup Then VisibleItemsCount = VisibleItemsCount + 1
                ElseIf .IsGroup Then
                    .Visible = False
                    ParentIndex = i
                ElseIf .Separator Then
                    .Visible = False
                ElseIf InStr(1, .Text, sText, vbTextCompare) > 0 Then
                    .Visible = True
                    VisibleItemsCount = VisibleItemsCount + 1
                    If .IsChild And ParentIndex >= 0 Then m_Items(ParentIndex).Visible = True
                Else
                    .Visible = False
                End If
            End With
        Next
        sbValue = 0
        m_LayoutDirty = True
        If bShow Then ResizePopup
        Redraw
    End Sub

    Private Sub SetEditText(ByVal sText As String)
        If m_hEdit = 0 Then Exit Sub
        m_bSettingEdit = True
        SetWindowTextW m_hEdit, StrPtr(sText)
        m_bSettingEdit = False
    End Sub

    Private Function WindowText(ByVal hWnd As LongPtr) As String
        Dim n As Long, sBuf As String
        If hWnd = 0 Then Exit Function
        n = GetWindowTextLengthW(hWnd)
        If n <= 0 Then Exit Function
        sBuf = String$(n + 1, vbNullChar)
        n = GetWindowTextW(hWnd, StrPtr(sBuf), n + 1)
        WindowText = Left$(sBuf, n)
    End Function

    '======================================================================
    ' Teclado
    '======================================================================
    Private Function IsItemSelectable(ByVal Index As Long) As Boolean
        If Index < 0 Or Index > mListCount - 1 Then Exit Function
        With m_Items(Index)
            IsItemSelectable = .Visible And Not .Disabled And Not .IsGroup And Not .Separator
        End With
    End Function

    Private Sub SelectIndex(ByVal Index As Long)
        m_Index = Index
        FocusItem m_Index, True
        RaiseEvent IndexChange
    End Sub

    ' Logica de teclas de la lista. Deja KeyCode = 0 si la tecla se consumio.
    Private Sub KeyDownLogic(KeyCode As Integer, ByVal Shift As Integer)
        Dim i As Long, ItemPerPage As Long
        Dim bPopup As Boolean

        bPopup = (m_ListStyle <> StyleListBox)
        If m_LayoutDirty Then Layout
        ItemPerPage = 1
        If IH > 0 Then ItemPerPage = ListHeight \ IH
        If ItemPerPage < 1 Then ItemPerPage = 1

        Select Case KeyCode
            Case vbKeyUp
                KeyCode = 0
                For i = m_Index - 1 To 0 Step -1
                    If IsItemSelectable(i) Then SelectIndex i: Exit For
                Next

            Case vbKeyDown
                KeyCode = 0
                For i = m_Index + 1 To mListCount - 1
                    If IsItemSelectable(i) Then SelectIndex i: Exit For
                Next

            Case vbKeyHome
                KeyCode = 0
                For i = 0 To mListCount - 1
                    If IsItemSelectable(i) Then SelectIndex i: Exit For
                Next

            Case vbKeyEnd
                KeyCode = 0
                For i = mListCount - 1 To 0 Step -1
                    If IsItemSelectable(i) Then SelectIndex i: Exit For
                Next

            Case vbKeyPageDown
                KeyCode = 0
                For i = m_Index + ItemPerPage To mListCount - 1
                    If IsItemSelectable(i) Then SelectIndex i: Exit Sub
                Next
                For i = mListCount - 1 To m_Index + 1 Step -1
                    If IsItemSelectable(i) Then SelectIndex i: Exit Sub
                Next

            Case vbKeyPageUp
                KeyCode = 0
                For i = m_Index - ItemPerPage To 0 Step -1
                    If IsItemSelectable(i) Then SelectIndex i: Exit Sub
                Next
                For i = 0 To m_Index - 1
                    If IsItemSelectable(i) Then SelectIndex i: Exit Sub
                Next

            Case vbKeyEscape
                If bPopup Then
                    KeyCode = 0
                    If Not ParentMenu Is Nothing Then
                        CloseAsSubMenu
                    Else
                        HideList
                    End If
                End If

            Case vbKeyReturn
                KeyCode = 0
                If m_Index > -1 And m_Index < mListCount Then
                    If Not m_Items(m_Index).SubMenu Is Nothing And bPopup Then
                        ShowSubMenu m_Index
                    ElseIf m_MultiSelect Then
                        m_Items(m_Index).Checked = Not m_Items(m_Index).Checked
                        Redraw
                        RaiseEvent ItemClick
                    Else
                        If bPopup Then HideList
                        RaiseEvent ItemClick
                        If m_hSrc <> 0 Then CompleteSourceText
                    End If
                ElseIf m_hSrc <> 0 Then
                    HideList
                End If

            Case vbKeyTab
                If bPopup Then HideList

            Case vbKeyLeft
                If bPopup Then
                    KeyCode = 0
                    If Not ParentMenu Is Nothing Then CloseAsSubMenu
                End If

            Case vbKeyRight
                If bPopup Then
                    KeyCode = 0
                    If m_Index > -1 And m_Index < mListCount Then
                        If Not m_Items(m_Index).SubMenu Is Nothing Then
                            ShowSubMenu m_Index
                            If Not ChildMenu Is Nothing Then
                                KeyCode = vbKeyHome
                                ChildMenu.SetKeyDown KeyCode
                                KeyCode = 0
                            End If
                        End If
                    End If
                End If
        End Select
    End Sub

    ' Cierra solo este submenu y devuelve el teclado al menu padre.
    Private Sub CloseAsSubMenu()
        Dim oParent As ucList
        Set oParent = ParentMenu
        Set ParentMenu = Nothing
        HideList
        oParent.zzChildMenuClosed
        Set oParent = Nothing
    End Sub

    ' Tecla en modo ListBox: logica y evento KeyDown
    Private Sub HandleKeyDownWithEvent(KeyCode As Integer, ByVal Shift As Integer)
        Dim kc As Integer
        kc = KeyCode
        KeyDownLogic KeyCode, Shift
        RaiseEvent KeyDown(kc, Shift)
    End Sub

    ' Evento KeyPress y busqueda por letra / acelerador (&) en menus
    Private Sub KeyPressLogic(KeyAscii As Integer)
        Dim i As Long, lPos As Long
        Dim sChar As String

        RaiseEvent KeyPress(KeyAscii)
        If KeyAscii < 32 Then Exit Sub
        sChar = UCase$(ChrW$(KeyAscii And &HFFFF&))

        If m_ListStyle = StyleMenu Then
            For i = 0 To mListCount - 1
                If IsItemSelectable(i) Then
                    lPos = InStr(m_Items(i).Text, "&")
                    If lPos > 0 Then
                        If UCase$(Mid$(m_Items(i).Text, lPos + 1, 1)) = sChar Then
                            m_Index = i
                            If Not m_Items(i).SubMenu Is Nothing Then
                                ShowSubMenu i
                            Else
                                HideList
                                RaiseEvent ItemClick
                            End If
                            Exit Sub
                        End If
                    End If
                End If
            Next
        End If

        For i = m_Index + 1 To mListCount - 1
            If IsItemSelectable(i) Then
                If UCase$(Left$(Replace$(m_Items(i).Text, "&", ""), 1)) = sChar Then SelectIndex i: Exit Sub
            End If
        Next
        For i = 0 To m_Index
            If IsItemSelectable(i) Then
                If UCase$(Left$(Replace$(m_Items(i).Text, "&", ""), 1)) = sChar Then SelectIndex i: Exit Sub
            End If
        Next
    End Sub

    ' Evita procesar dos veces una misma tecla si el host la entrega tanto al
    ' UserControl como a la ventana de la lista.
    Private Function KeyAlreadyHandled(ByVal Code As Long) As Boolean
        Dim t As Long
        t = GetMessageTime()
        If t = m_LastKeyTime And Code = m_LastKeyCode Then
            KeyAlreadyHandled = True
        Else
            m_LastKeyTime = t
            m_LastKeyCode = Code
        End If
    End Function

    '======================================================================
    ' Raton
    '======================================================================
    Private Function ShiftFromMK(ByVal mk As Long) As Integer
        If (mk And MK_SHIFT) <> 0 Then ShiftFromMK = ShiftFromMK Or vbShiftMask
        If (mk And MK_CONTROL) <> 0 Then ShiftFromMK = ShiftFromMK Or vbCtrlMask
        If GetKeyState(VK_MENU) < 0 Then ShiftFromMK = ShiftFromMK Or vbAltMask
    End Function

    Private Function ButtonFromMK(ByVal mk As Long) As Integer
        If (mk And MK_LBUTTON) <> 0 Then ButtonFromMK = ButtonFromMK Or vbLeftButton
        If (mk And MK_RBUTTON) <> 0 Then ButtonFromMK = ButtonFromMK Or vbRightButton
        If (mk And MK_MBUTTON) <> 0 Then ButtonFromMK = ButtonFromMK Or vbMiddleButton
    End Function

    ' Elemento seleccionable bajo Y (pixeles del area de la lista) o -1.
    Private Function HitTestY(ByVal Y As Long) As Long
        Dim i As Long, lTop As Long, lItemH As Long
        HitTestY = -1
        If Y < ListTop Or Y >= ListTop + ListHeight Then Exit Function
        lTop = ListTop - sbValue
        For i = 0 To mListCount - 1
            If m_Items(i).Visible Then
                lItemH = ItemH(i)
                If Y >= lTop And Y < lTop + lItemH Then
                    If IsItemSelectable(i) Then HitTestY = i
                    Exit Function
                End If
                lTop = lTop + lItemH
            End If
        Next
    End Function

    Private Sub OnMouseMove(ByVal X As Long, ByVal Y As Long, ByVal mk As Long)
        Dim tme As TRACKMOUSEEVENTSTRUCT
        Dim HotItem As Long

        If Not bTracking Then
            tme.cbSize = LenB(tme)
            tme.dwFlags = TME_LEAVE
            tme.hwndTrack = m_hList
            If TrackMouseEvent(tme) <> 0 Then bTracking = True
        End If

        If SB_MouseMove(X, Y) Then
            RaiseEvent MouseMove(ButtonFromMK(mk), ShiftFromMK(mk), CSng(X), CSng(Y))
            Exit Sub
        End If

        HotItem = HitTestY(Y)
        If HotItem <> m_HotItem Then
            m_HotItem = HotItem
            If m_bPopupWnd Then
                ' Submenus: abrir el del elemento bajo el raton o cerrar el abierto
                KillTimer m_hList, TIMER_SUBMENU
                m_SubPending = -1
                If HotItem <> -1 Then
                    If Not m_Items(HotItem).SubMenu Is Nothing Then
                        m_SubPending = HotItem
                        SetTimer m_hList, TIMER_SUBMENU, SUBMENU_DELAY, 0
                    ElseIf Not ChildMenu Is Nothing Then
                        m_SubPending = -2
                        SetTimer m_hList, TIMER_SUBMENU, SUBMENU_DELAY, 0
                    End If
                End If
            End If
            Redraw
        End If
        RaiseEvent MouseMove(ButtonFromMK(mk), ShiftFromMK(mk), CSng(X), CSng(Y))
    End Sub

    Private Sub OnMouseDown(ByVal Button As Integer, ByVal X As Long, ByVal Y As Long, ByVal mk As Long)
        Dim f As LongPtr

        ' ListBox: el clic da el foco a la lista (o al filtro)
        If Not m_bPopupWnd Then
            f = GetFocus()
            If f <> m_hList And (f <> m_hEdit Or m_hEdit = 0) Then SetFocusAPI FocusTarget()
        End If

        If Button = vbLeftButton Then
            If SB_MouseDown(X, Y) Then
                RaiseEvent MouseDown(Button, ShiftFromMK(mk), CSng(X), CSng(Y))
                Exit Sub
            End If
            m_HotItem = HitTestY(Y)
            If m_HotItem <> -1 Then
                If Not m_bPopupWnd Then
                    m_Index = m_HotItem
                    bMouseDown = True
                    FocusItem m_Index, True
                    RaiseEvent IndexChange
                ElseIf m_Items(m_HotItem).SubMenu Is Nothing Then
                    bMouseDown = True
                    Redraw
                Else
                    KillTimer m_hList, TIMER_SUBMENU
                    m_SubPending = -1
                    ShowSubMenu m_HotItem
                End If
            End If
        End If
        RaiseEvent MouseDown(Button, ShiftFromMK(mk), CSng(X), CSng(Y))
    End Sub

    Private Sub OnMouseUp(ByVal Button As Integer, ByVal X As Long, ByVal Y As Long, ByVal mk As Long)
        Dim lHit As Long
        If Button = vbLeftButton Then
            If SB_MouseUp() Then
                RaiseEvent MouseUp(Button, ShiftFromMK(mk), CSng(X), CSng(Y))
                Exit Sub
            End If
            If bMouseDown Then
                bMouseDown = False
                lHit = HitTestY(Y)
                If lHit <> -1 And lHit = m_HotItem Then
                    m_Index = lHit
                    If m_MultiSelect Then
                        m_Items(m_Index).Checked = Not m_Items(m_Index).Checked
                        Redraw
                        RaiseEvent ItemClick
                    ElseIf Not m_bPopupWnd Then
                        Redraw
                        RaiseEvent ItemClick
                    ElseIf m_Items(m_Index).SubMenu Is Nothing Then
                        HideList
                        RaiseEvent ItemClick
                        If m_hSrc <> 0 Then CompleteSourceText
                    End If
                Else
                    Redraw
                End If
            End If
        End If
        RaiseEvent MouseUp(Button, ShiftFromMK(mk), CSng(X), CSng(Y))
    End Sub

    Private Sub OnMouseLeave()
        bTracking = False
        If sbPressed <> SBP_NONE Then Exit Sub
        If sbHot <> SBP_NONE Then sbHot = SBP_NONE: Redraw
        If m_HotItem <> -1 Or bMouseDown Then
            ' Con un submenu abierto, su elemento sigue marcado
            If ChildMenu Is Nothing Then
                m_HotItem = -1
                bMouseDown = False
                KillTimer m_hList, TIMER_SUBMENU
                m_SubPending = -1
                Redraw
            End If
        End If
    End Sub

    Private Sub OnMouseWheel(ByVal Delta As Long)
        If m_LayoutDirty Then Layout
        If Not sbVisible Then Exit Sub
        SB_SetValue sbValue - (Delta * sbWheel) \ 120, False
    End Sub

    Private Function SetCursorFromPointer() As Boolean
        Dim lId As Long
        Dim oPic As IPictureDisp
        Select Case UserControl.MousePointer
            Case vbDefault
                Exit Function
            Case vbCustom
                Set oPic = UserControl.MouseIcon
                If Not oPic Is Nothing Then
                    If oPic.Handle <> 0 Then
                        SetCursor oPic.Handle
                        SetCursorFromPointer = True
                    End If
                End If
                Exit Function
            Case vbArrow: lId = 32512
            Case vbCrosshair: lId = 32515
            Case vbIbeam: lId = 32513
            Case vbIconPointer: lId = 32641
            Case vbSizePointer, vbSizeAll: lId = 32646
            Case vbSizeNESW: lId = 32643
            Case vbSizeNS: lId = 32645
            Case vbSizeNWSE: lId = 32642
            Case vbSizeWE: lId = 32644
            Case vbUpArrow: lId = 32516
            Case vbHourglass: lId = 32514
            Case vbNoDrop: lId = 32648
            Case vbArrowHourglass: lId = 32650
            Case vbArrowQuestion: lId = 32651
            Case Else: lId = 32649
        End Select
        SetCursor LoadCursorW(0, lId)
        SetCursorFromPointer = True
    End Function

    '======================================================================
    ' Disposicion
    '======================================================================
    Private Function ItemH(ByVal i As Long) As Long
        If m_Items(i).Separator Then ItemH = IH \ 2 Else ItemH = IH
    End Function

    Private Function EditHeight() As Long
        EditHeight = UserControl.Font.Size * 1.5 * DpiFactor
    End Function

    Private Function HeaderHeight() As Long
        If m_ShowFilter Then
            HeaderHeight = EditHeight() + lMargin * 4
        Else
            HeaderHeight = lMargin
        End If
    End Function

    Private Function ContentHeight() As Long
        Dim i As Long
        For i = 0 To mListCount - 1
            If m_Items(i).Visible Then ContentHeight = ContentHeight + ItemH(i)
        Next
    End Function

    ' Calcula cabecera, filtro y barra de desplazamiento.
    Private Sub Layout()
        Dim rc As RECT
        Dim BW As Long

        If m_hList <> 0 Then
            GetClientRect m_hList, rc
            m_ClientW = rc.Right
            m_ClientH = rc.Bottom
        Else
            m_ClientW = UserControl.ScaleWidth
            m_ClientH = UserControl.ScaleHeight
        End If

        ListTop = HeaderHeight()
        ListHeight = m_ClientH - ListTop - lMargin
        If ListHeight < 0 Then ListHeight = 0

        ' Filtro
        m_EditL = lMargin * 2
        m_EditT = lMargin * 2
        m_EditW = m_ClientW - lMargin * 4 - lCheckSize
        If m_EditW < 1 Then m_EditW = 1
        m_EditH = EditHeight()
        If m_hEdit <> 0 Then
            If m_ShowFilter Then
                MoveWindow m_hEdit, m_EditL, m_EditT, m_EditW, m_EditH, 1
                ShowWindow m_hEdit, SW_SHOWNA
            Else
                ShowWindow m_hEdit, SW_HIDE
            End If
        End If

        ' Barra de desplazamiento (como el ucScrollbar del original)
        If m_ListDesign = MicrosoftDesign Then
            sbWidth = 16 * DpiFactor
            sbButtons = True
            sbThemed = True
        Else
            sbWidth = 8 * DpiFactor
            sbButtons = False
            sbThemed = False
        End If
        sbMax = ContentHeight() - ListHeight
        If sbMax < 0 Then sbMax = 0
        If sbValue > sbMax Then sbValue = sbMax
        sbVisible = (sbMax > 0)
        sbSmall = IH
        sbLarge = ListHeight - IH
        If sbLarge < 1 Then sbLarge = 1
        sbWheel = IH * 3

        If m_ListDesign = GoogleDesign Then
            sbLeft = m_ClientW - sbWidth - 2 * DpiFactor
            sbTop = ListTop
            sbHeight = ListHeight
        Else
            If m_ListStyle = StyleListBox Then BW = DpiFactor
            sbLeft = m_ClientW - sbWidth - BW * 2
            If m_ShowFilter Then
                sbTop = ListTop
                sbHeight = m_ClientH - ListTop - BR \ 2 - BW * 2
            Else
                sbTop = BR \ 2 + BW
                sbHeight = m_ClientH - BR - BW * 3
            End If
        End If
        If sbHeight < 0 Then sbHeight = 0

        m_LayoutDirty = False
    End Sub

    ' Desplaza para que el elemento Index se vea completo
    Private Sub FocusItem(ByVal Index As Long, ByVal bRedraw As Boolean)
        Dim i As Long, lTop As Long, lBottom As Long
        If m_LayoutDirty Then Layout
        If Index < 0 Or Index > mListCount - 1 Then Exit Sub
        For i = 0 To Index - 1
            If m_Items(i).Visible Then lTop = lTop + ItemH(i)
        Next
        lBottom = lTop + ItemH(Index)
        If lBottom > sbValue + ListHeight Then
            SB_SetValue lBottom - ListHeight, False, False
        ElseIf lTop < sbValue Then
            SB_SetValue lTop, False, False
        End If
        If bRedraw Then Redraw
    End Sub

    '======================================================================
    ' Barra de desplazamiento interna
    '======================================================================
    Private Sub SB_SetValue(ByVal v As Long, ByVal bDragging As Boolean, Optional ByVal bRedraw As Boolean = True)
        If v > sbMax Then v = sbMax
        If v < 0 Then v = 0
        If v = sbValue Then Exit Sub
        sbValue = v
        If bRedraw Then Redraw
        If Not bDragging And sbValue = sbMax And sbMax > 0 Then RaiseEvent ScrollBottom
    End Sub

    Private Sub SB_Metrics(ByRef BtnSize As Long, ByRef TrackTop As Long, ByRef TrackLen As Long, ByRef ThumbTop As Long, ByRef ThumbLen As Long)
        Dim lMin As Long
        If sbButtons Then BtnSize = sbWidth Else BtnSize = 0
        If BtnSize * 2 > sbHeight Then BtnSize = sbHeight \ 2
        TrackTop = sbTop + BtnSize
        TrackLen = sbHeight - BtnSize * 2
        If TrackLen < 0 Then TrackLen = 0
        If sbMax <= 0 Then
            ThumbTop = TrackTop
            ThumbLen = TrackLen
            Exit Sub
        End If
        ThumbLen = CLng(CDbl(TrackLen) * sbLarge / (sbMax + sbLarge))
        lMin = 16 * DpiFactor
        If ThumbLen < lMin Then ThumbLen = lMin
        If ThumbLen > TrackLen Then ThumbLen = TrackLen
        ThumbTop = TrackTop + CLng(CDbl(TrackLen - ThumbLen) * sbValue / sbMax)
    End Sub

    Private Function SB_HitTest(ByVal X As Long, ByVal Y As Long) As Long
        Dim BtnSize As Long, TrackTop As Long, TrackLen As Long, ThumbTop As Long, ThumbLen As Long
        If Not sbVisible Then Exit Function
        If X < sbLeft Or X >= sbLeft + sbWidth Or Y < sbTop Or Y >= sbTop + sbHeight Then Exit Function
        SB_Metrics BtnSize, TrackTop, TrackLen, ThumbTop, ThumbLen
        If Y < TrackTop Then
            SB_HitTest = SBP_UP
        ElseIf Y >= TrackTop + TrackLen Then
            SB_HitTest = SBP_DOWN
        ElseIf Y < ThumbTop Then
            SB_HitTest = SBP_PAGEUP
        ElseIf Y >= ThumbTop + ThumbLen Then
            SB_HitTest = SBP_PAGEDOWN
        Else
            SB_HitTest = SBP_THUMB
        End If
    End Function

    Private Sub SB_Step(ByVal lPart As Long)
        Select Case lPart
            Case SBP_UP:       SB_SetValue sbValue - sbSmall, False
            Case SBP_DOWN:     SB_SetValue sbValue + sbSmall, False
            Case SBP_PAGEUP:   SB_SetValue sbValue - sbLarge, False
            Case SBP_PAGEDOWN: SB_SetValue sbValue + sbLarge, False
        End Select
    End Sub

    Private Function SB_MouseDown(ByVal X As Long, ByVal Y As Long) As Boolean
        Dim BtnSize As Long, TrackTop As Long, TrackLen As Long, ThumbTop As Long, ThumbLen As Long
        Dim lPart As Long
        lPart = SB_HitTest(X, Y)
        If lPart = SBP_NONE Then Exit Function
        SB_MouseDown = True
        sbPressed = lPart
        SetCapture m_hList
        If lPart = SBP_THUMB Then
            SB_Metrics BtnSize, TrackTop, TrackLen, ThumbTop, ThumbLen
            sbDragOffset = Y - ThumbTop
        Else
            SB_Step lPart
            sbRepeating = False
            SetTimer m_hList, TIMER_SCROLL, 350, 0
        End If
        Redraw
    End Function

    Private Function SB_MouseMove(ByVal X As Long, ByVal Y As Long) As Boolean
        Dim BtnSize As Long, TrackTop As Long, TrackLen As Long, ThumbTop As Long, ThumbLen As Long
        Dim lPart As Long
        If sbPressed = SBP_THUMB Then
            SB_Metrics BtnSize, TrackTop, TrackLen, ThumbTop, ThumbLen
            If TrackLen - ThumbLen > 0 Then
                SB_SetValue CLng(CDbl(Y - sbDragOffset - TrackTop) * sbMax / (TrackLen - ThumbLen)), True
            End If
            SB_MouseMove = True
            Exit Function
        End If
        If sbPressed <> SBP_NONE Then SB_MouseMove = True: Exit Function
        lPart = SB_HitTest(X, Y)
        If lPart <> sbHot Then
            sbHot = lPart
            Redraw
        End If
        If lPart <> SBP_NONE Then
            SB_MouseMove = True
            If m_HotItem <> -1 And ChildMenu Is Nothing Then m_HotItem = -1: Redraw
        End If
    End Function

    Private Function SB_MouseUp() As Boolean
        Dim bThumb As Boolean
        If sbPressed = SBP_NONE Then Exit Function
        SB_MouseUp = True
        bThumb = (sbPressed = SBP_THUMB)
        sbPressed = SBP_NONE
        KillTimer m_hList, TIMER_SCROLL
        If GetCapture() = m_hList Then ReleaseCapture
        If bThumb And sbValue = sbMax And sbMax > 0 Then RaiseEvent ScrollBottom
        Redraw
    End Function

    Private Sub SB_RepeatTick()
        Dim pt As POINTAPI
        If sbPressed = SBP_NONE Or sbPressed = SBP_THUMB Then
            KillTimer m_hList, TIMER_SCROLL
            Exit Sub
        End If
        If Not sbRepeating Then
            sbRepeating = True
            SetTimer m_hList, TIMER_SCROLL, 50, 0
        End If
        If GetAsyncKeyState(vbLeftButton) >= 0 Then
            SB_MouseUp
            Exit Sub
        End If
        GetCursorPos pt
        ScreenToClient m_hList, pt
        If SB_HitTest(pt.X, pt.Y) = sbPressed Then SB_Step sbPressed
    End Sub

    ' 1 normal, 2 caliente, 3 pulsado
    Private Function SB_State(ByVal lPart As Long) As Long
        If sbPressed = lPart Then
            SB_State = 3
        ElseIf sbHot = lPart Then
            SB_State = 2
        Else
            SB_State = 1
        End If
    End Function

    Private Sub SB_Paint(ByVal hDC As LongPtr)
        Dim BtnSize As Long, TrackTop As Long, TrackLen As Long, ThumbTop As Long, ThumbLen As Long
        Dim rc As RECT
        Dim hTheme As LongPtr
        Dim lState As Long, lColor As Long, lBack As Long
        Dim sClass As String

        If Not sbVisible Or sbWidth <= 0 Or sbHeight <= 0 Then Exit Sub
        SB_Metrics BtnSize, TrackTop, TrackLen, ThumbTop, ThumbLen
        lBack = UserControl.BackColor

        If sbThemed Then
            sClass = "SCROLLBAR"
            hTheme = OpenThemeData(m_hList, StrPtr(sClass))
        End If
        If hTheme <> 0 Then
            SetRect4 rc, sbLeft, TrackTop, sbLeft + sbWidth, TrackTop + TrackLen
            DrawThemeBackground hTheme, hDC, SBP_LOWERTRACKVERT, 1, rc, 0
            If BtnSize > 0 Then
                SetRect4 rc, sbLeft, sbTop, sbLeft + sbWidth, sbTop + BtnSize
                DrawThemeBackground hTheme, hDC, SBP_ARROWBTN, ABS_UPNORMAL + SB_State(SBP_UP) - 1, rc, 0
                SetRect4 rc, sbLeft, sbTop + sbHeight - BtnSize, sbLeft + sbWidth, sbTop + sbHeight
                DrawThemeBackground hTheme, hDC, SBP_ARROWBTN, ABS_DOWNNORMAL + SB_State(SBP_DOWN) - 1, rc, 0
            End If
            lState = SB_State(SBP_THUMB)
            SetRect4 rc, sbLeft, ThumbTop, sbLeft + sbWidth, ThumbTop + ThumbLen
            DrawThemeBackground hTheme, hDC, SBP_THUMBBTNVERT, lState, rc, 0
            DrawThemeBackground hTheme, hDC, SBP_GRIPPERVERT, lState, rc, 0
            CloseThemeData hTheme
        ElseIf sbThemed Then
            SetRect4 rc, sbLeft, sbTop, sbLeft + sbWidth, sbTop + sbHeight
            FillRectangle hDC, rc, vbScrollBars
            If BtnSize > 0 Then
                SetRect4 rc, sbLeft, sbTop, sbLeft + sbWidth, sbTop + BtnSize
                DrawFrameControl hDC, rc, DFC_SCROLL, DFCS_SCROLLUP Or IIf(sbPressed = SBP_UP, DFCS_PUSHED, 0)
                SetRect4 rc, sbLeft, sbTop + sbHeight - BtnSize, sbLeft + sbWidth, sbTop + sbHeight
                DrawFrameControl hDC, rc, DFC_SCROLL, DFCS_SCROLLDOWN Or IIf(sbPressed = SBP_DOWN, DFCS_PUSHED, 0)
            End If
            SetRect4 rc, sbLeft, ThumbTop, sbLeft + sbWidth, ThumbTop + ThumbLen
            FillRectangle hDC, rc, vbButtonFace
            DrawEdge hDC, rc, EDGE_RAISED, BF_RECT_MIDDLE
        Else
            ' Estilo Google: solo el pulgar, redondeado
            lState = SB_State(SBP_THUMB)
            If IsDarkColor(lBack) Then
                Select Case lState
                    Case 2: lColor = ShiftColor(lBack, vbWhite, 180)
                    Case 3: lColor = ShiftColor(lBack, vbWhite, 150)
                    Case Else: lColor = ShiftColor(lBack, vbWhite, 200)
                End Select
            Else
                Select Case lState
                    Case 2: lColor = ShiftColor(lBack, vbBlack, 200)
                    Case 3: lColor = ShiftColor(lBack, vbBlack, 170)
                    Case Else: lColor = ShiftColor(lBack, vbBlack, 220)
                End Select
            End If
            RoundRectPlus hDC, sbLeft, ThumbTop, sbWidth - 1, ThumbLen - 1, RGBtoARGB(lColor, 100), 0, sbWidth - 1
        End If
    End Sub

    '======================================================================
    ' Dibujo
    '======================================================================
    ' Repinta la lista ahora.
    Private Sub Redraw()
        If m_hList <> 0 Then
            InvalidateRect m_hList, 0, 0
            UpdateWindow m_hList
        ElseIf Not Ambient.UserMode Then
            DesignRender
        End If
    End Sub

    Private Sub PaintList()
        Dim ps As PAINTSTRUCT
        Dim hDC As LongPtr, hMemDC As LongPtr, hBmp As LongPtr, hOld As LongPtr
        Dim rc As RECT
        hDC = BeginPaint(m_hList, ps)
        If m_LayoutDirty Then Layout
        GetClientRect m_hList, rc
        If rc.Right > 0 And rc.Bottom > 0 Then
            hMemDC = CreateCompatibleDC(hDC)
            hBmp = CreateCompatibleBitmap(hDC, rc.Right, rc.Bottom)
            hOld = SelectObject(hMemDC, hBmp)
            Render hMemDC, rc.Right, rc.Bottom
            BitBlt hDC, 0, 0, rc.Right, rc.Bottom, hMemDC, 0, 0, vbSrcCopy
            SelectObject hMemDC, hOld
            DeleteObject hBmp
            DeleteDC hMemDC
        End If
        EndPaint m_hList, ps
    End Sub

    ' Vista en el disenador
    Private Sub DesignRender()
        Dim rc As RECT
        Dim i As Long
        If Ambient.UserMode Then Exit Sub
        If m_hFontBold = 0 Then BuildFonts
        UserControl.AutoRedraw = True
        If m_ListStyle = StyleListBox Then
            ' Elementos de muestra solo para la vista previa
            If mListCount = 0 Then
                For i = 1 To 7
                    If i Mod 3 = 0 Then
                        AddItemDesign "-"
                    Else
                        AddItemDesign "Item " & i
                    End If
                Next
            End If
            m_LayoutDirty = True
            Layout
            Render UserControl.hDC, UserControl.ScaleWidth, UserControl.ScaleHeight
            SetRect4 rc, 0, 0, UserControl.ScaleWidth, UserControl.ScaleHeight
            RoundRectPlus UserControl.hDC, 0, 0, rc.Right - 1, rc.Bottom - 1, 0, RGBtoARGB(m_BorderColor, 100), BR
        Else
            SetRect4 rc, 0, 0, UserControl.ScaleWidth, UserControl.ScaleHeight
            FillRectangle UserControl.hDC, rc, UserControl.BackColor
            RoundRectPlus UserControl.hDC, 1, 1, rc.Right - 3, rc.Bottom - 3, RGBtoARGB(vbWindowBackground, 100), RGBtoARGB(vbActiveBorder, 100), 6
            SetRect4 rc, 7, 8, rc.Right - 7, 11
            FillRectangle UserControl.hDC, rc, ShiftColor(vbWindowText, vbWindowBackground, 60)
            rc.Top = 14: rc.Bottom = 18
            FillRectangle UserControl.hDC, rc, vbHighlight
            rc.Top = 21: rc.Bottom = 24
            FillRectangle UserControl.hDC, rc, ShiftColor(vbWindowText, vbWindowBackground, 60)
        End If
        UserControl.Refresh
    End Sub

    ' Elemento de muestra del disenador (no se guarda)
    Private Sub AddItemDesign(ByVal sText As String)
        ReDim Preserve m_Items(mListCount)
        With m_Items(mListCount)
            .Text = sText
            .Icon = -1
            .Separator = (sText = "-")
            .Visible = True
            .TextColor = CLR_NONE
            .SubTextColor = CLR_NONE
            .BackColor = CLR_NONE
        End With
        mListCount = mListCount + 1
    End Sub

    ' Dibuja la lista completa en hDC (W x H).
    Private Sub Render(ByVal hDC As LongPtr, ByVal W As Long, ByVal H As Long)
        Dim i As Long, lTop As Long, lLeft As Long, lWidth As Long, lItemH As Long
        Dim rc As RECT, TempRect As RECT
        Dim oColor As Long, lFore As Long, lBack As Long, lLineColor As Long
        Dim HotItembckColor As Long, HighlightTextColor As Long, NormalTextColor As Long
        Dim sText As String, sShortcut As String, TempStr As String
        Dim lPos As Long
        Dim hOldFont As LongPtr, hFont As LongPtr, oFont As IFont
        Dim bSel As Boolean, bHot As Boolean, bPressed As Boolean
        Dim eIndex As Long, eLeft As Long, eTop As Long, eWidth As Long, eHeight As Long

        lBack = TranslateColor(UserControl.BackColor)
        SetRect4 rc, 0, 0, W, H
        FillRectangle hDC, rc, lBack
        SetBkMode hDC, TRANSPARENT_BK
        Set oFont = UserControl.Font
        hFont = oFont.hFont
        hOldFont = SelectObject(hDC, hFont)

        If IsDarkColor(m_SelectionColor) Then HighlightTextColor = vbWhite Else HighlightTextColor = vbBlack
        If IsDarkColor(lBack) Then
            HotItembckColor = ShiftColor(lBack, vbWhite, 200)
            NormalTextColor = vbWhite
        Else
            HotItembckColor = ShiftColor(lBack, vbBlack, 240)
            NormalTextColor = vbBlack
        End If
        lLineColor = TranslateColor(m_LineColor)

        lWidth = W
        If sbVisible Then lWidth = sbLeft - 2 * DpiFactor
        If m_SelectionRadius > 0 Then lLeft = lMargin \ 2

        lTop = ListTop - sbValue
        For i = 0 To mListCount - 1
            If m_Items(i).Visible Then
                lItemH = ItemH(i)
                If lTop + lItemH > 0 And lTop < H Then
                    With m_Items(i)
                        SetRect4 rc, 0, lTop, lWidth, lTop + lItemH
                        bSel = (i = m_Index)
                        bHot = (i = m_HotItem)
                        bPressed = bHot And bMouseDown

                        ' Fondo del elemento
                        If .Separator Or .IsGroup Then
                            If .BackColor <> CLR_NONE Then FillRectangle hDC, rc, .BackColor
                        ElseIf bSel Or bPressed Then
                            oColor = m_SelectionColor
                            If m_SelectionRadius = 0 Then
                                FillRectangle hDC, rc, oColor
                            Else
                                RoundRectPlus hDC, lLeft, rc.Top, lWidth - lLeft * 2, lItemH, RGBtoARGB(oColor, 100), 0, m_SelectionRadius * DpiFactor
                            End If
                        ElseIf bHot And Not .Disabled Then
                            If .BackColor <> CLR_NONE Then
                                If IsDarkColor(.BackColor) Then
                                    oColor = ShiftColor(.BackColor, vbWhite, 200)
                                Else
                                    oColor = ShiftColor(.BackColor, vbBlack, 240)
                                End If
                            Else
                                oColor = HotItembckColor
                            End If
                            If m_SelectionRadius = 0 Then
                                FillRectangle hDC, rc, oColor
                            Else
                                RoundRectPlus hDC, lLeft, rc.Top, lWidth - lLeft * 2, lItemH, RGBtoARGB(oColor, 100), 0, m_SelectionRadius * DpiFactor
                            End If
                        ElseIf .BackColor <> CLR_NONE Then
                            FillRectangle hDC, rc, .BackColor
                        End If

                        If .Separator Then
                            DrawLineColor hDC, lMargin, lTop + lItemH \ 2, lWidth - lMargin, lTop + lItemH \ 2, lLineColor
                        Else
                            ' Color del texto
                            If .Disabled Then
                                lFore = ShiftColor(NormalTextColor, lBack, 100)
                            ElseIf bSel Or bPressed Then
                                lFore = HighlightTextColor
                            ElseIf .TextColor <> CLR_NONE Then
                                lFore = TranslateColor(.TextColor)
                            Else
                                lFore = NormalTextColor
                            End If
                            SetTextColor hDC, lFore

                            If m_UseMonocromeIcons Then oColor = lFore Else oColor = CLR_NONE

                            If m_DrawSeparatorLine And Not .IsGroup Then
                                DrawLineColor hDC, lMargin, lTop + lItemH - 1, lWidth - lMargin, lTop + lItemH - 1, lLineColor
                            End If

                            If .IsGroup Then
                                rc.Left = lMargin * 2
                                If cImageList.Count > 0 And .Icon > -1 Then
                                    ImageListDraw hDC, .Icon + 1, rc.Left, lTop + (lItemH - ImgLstHeight) \ 2, ImgLstWidth, ImgLstHeight, oColor, .Disabled
                                    rc.Left = rc.Left + ImgLstWidth + lMargin
                                End If
                                rc.Right = rc.Right - lMargin
                                SelectObject hDC, m_hFontBold
                                DrawTextW hDC, StrPtr(.Text), -1, rc, DT_SINGLELINE Or DT_VCENTER Or DT_WORD_ELLIPSIS Or DT_NOPREFIX
                                SelectObject hDC, hFont
                            Else
                                rc.Left = lMargin * 2
                                If .IsChild Then rc.Left = rc.Left + lMargin * 2

                                If m_MultiSelect And .SubMenu Is Nothing Then
                                    DrawCheckBox hDC, .Checked, bSel Or bPressed, rc.Left, lTop + (lItemH - lCheckSize) \ 2, rc.Left + lCheckSize, lTop + (lItemH + lCheckSize) \ 2, lFore
                                    rc.Left = rc.Left + lCheckSize + lMargin
                                End If

                                If cImageList.Count > 0 Then
                                    If .Icon > -1 Then ImageListDraw hDC, .Icon + 1, rc.Left, lTop + (lItemH - ImgLstHeight) \ 2, ImgLstWidth, ImgLstHeight, oColor, .Disabled
                                    rc.Left = rc.Left + ImgLstWidth + lMargin
                                End If

                                If Not .SubMenu Is Nothing Then
                                    DrawArrow hDC, rc.Right - lMargin - lCheckSize, lTop, rc.Right - lMargin, lTop + lItemH
                                End If
                                rc.Right = rc.Right - lMargin - lCheckSize

                                ' Texto y atajo de teclado (separados por vbTab)
                                lPos = InStr(.Text, vbTab)
                                If lPos > 0 Then
                                    sText = Left$(.Text, lPos - 1)
                                    sShortcut = Mid$(.Text, lPos + 1)
                                Else
                                    sText = .Text
                                    sShortcut = vbNullString
                                End If

                                If Len(sShortcut) > 0 Then
                                    If .SubTextColor <> CLR_NONE And Not (bSel Or bPressed) Then
                                        SetTextColor hDC, TranslateColor(.SubTextColor)
                                    Else
                                        SetTextColor hDC, ShiftColor(lFore, lBack, 160)
                                    End If
                                    DrawTextW hDC, StrPtr(sShortcut), -1, rc, DT_SINGLELINE Or DT_VCENTER Or DT_RIGHT Or DT_NOPREFIX
                                    SetTextColor hDC, lFore
                                    TempRect = rc
                                    DrawTextW hDC, StrPtr(sShortcut), -1, TempRect, DT_SINGLELINE Or DT_CALCRECT Or DT_NOPREFIX
                                    rc.Right = rc.Right - (TempRect.Right - TempRect.Left) - lMargin
                                End If

                                If .ItemBold Then SelectObject hDC, m_hFontBold
                                If Len(.SubText) > 0 And m_SubTitleVisible Then
                                    ' Dos lineas: texto arriba, subtexto abajo
                                    TempRect = rc
                                    TempRect.Top = lTop + (lItemH - m_TextHeight * 2) \ 2
                                    TempRect.Bottom = TempRect.Top + m_TextHeight
                                    DrawItemText hDC, sText, TempRect, lFore, bSel Or bPressed
                                    SelectObject hDC, m_hFontSmall
                                    If .SubTextColor <> CLR_NONE And Not (bSel Or bPressed) Then
                                        SetTextColor hDC, TranslateColor(.SubTextColor)
                                    Else
                                        SetTextColor hDC, ShiftColor(lFore, lBack, 160)
                                    End If
                                    TempRect.Top = TempRect.Bottom
                                    TempRect.Bottom = TempRect.Top + m_TextHeight
                                    DrawTextW hDC, StrPtr(.SubText), -1, TempRect, DT_SINGLELINE Or DT_VCENTER Or DT_WORD_ELLIPSIS Or DT_NOPREFIX
                                    SetTextColor hDC, lFore
                                Else
                                    DrawItemText hDC, sText, rc, lFore, bSel Or bPressed
                                End If
                                SelectObject hDC, hFont
                            End If
                        End If
                    End With

                    ' ItemCustomDraw recibe copias (los argumentos son ByRef)
                    eIndex = i: eLeft = 0: eTop = lTop: eWidth = lWidth: eHeight = lItemH
                    RaiseEvent ItemCustomDraw(eIndex, hDC, eLeft, eTop, eWidth, eHeight)
                    SelectObject hDC, hFont
                    SetBkMode hDC, TRANSPARENT_BK
                End If
                lTop = lTop + lItemH
                If lTop > H Then Exit For
            End If
        Next

        ' Cabecera y pie (tapan los elementos desplazados) con degradado
        SetRect4 rc, 0, 0, W, ListTop
        FillRectangle hDC, rc, lBack
        If sbValue > 0 Then FillRectGradient hDC, 0, ListTop, lWidth, lMargin, RGBtoARGB(lBack, 100), RGBtoARGB(lBack, 0)
        SetRect4 rc, 0, ListTop + ListHeight, W, H
        FillRectangle hDC, rc, lBack
        If sbValue < sbMax Then FillRectGradient hDC, 0, ListTop + ListHeight - lMargin, lWidth, lMargin, RGBtoARGB(lBack, 0), RGBtoARGB(lBack, 100)

        ' Marco del filtro y lupa
        If m_ShowFilter Then
            If bHasFocus And m_hEdit <> 0 And GetFocus() = m_hEdit Then
                oColor = m_SelectionColor
            Else
                oColor = m_BorderColor
            End If
            RoundRectPlus hDC, m_EditL - lMargin, m_EditT - lMargin, W - lMargin * 2, m_EditH + lMargin * 2, RGBtoARGB(lBack, 100), RGBtoARGB(oColor, 100), BR
            SetRect4 rc, m_EditL + m_EditW, m_EditT, m_EditL + m_EditW + lCheckSize, m_EditT + m_EditH
            SetTextColor hDC, ShiftColor(NormalTextColor, lBack, 160)
            If m_hFontGlass <> 0 Then
                SelectObject hDC, m_hFontGlass
                DrawTextW hDC, StrPtr(ChrW$(&HE094&)), 1, rc, DT_SINGLELINE Or DT_VCENTER Or DT_CENTER Or DT_NOPREFIX
                SelectObject hDC, hFont
            End If
        End If

        SB_Paint hDC

        RaiseEvent PostPaint(hDC)
        SelectObject hDC, hOldFont
    End Sub

    ' Texto de un elemento con el resaltado del texto buscado (filtro)
    Private Sub DrawItemText(ByVal hDC As LongPtr, ByVal sText As String, ByRef rc As RECT, ByVal lFore As Long, ByVal bSelected As Boolean)
        Dim lPos As Long
        Dim TempRect As RECT
        Dim sPart As String
        Dim sz As SIZEAPI

        DrawTextW hDC, StrPtr(sText), -1, rc, DT_SINGLELINE Or DT_VCENTER Or DT_WORD_ELLIPSIS Or DT_NOPREFIX
        If Len(m_Filter) = 0 Or bSelected Then Exit Sub
        lPos = InStr(1, sText, m_Filter, vbTextCompare)
        If lPos = 0 Then Exit Sub

        ' Se vuelve a pintar la parte coincidente en FindTextColor, en su sitio
        TempRect = rc
        If lPos > 1 Then
            sPart = Left$(sText, lPos - 1)
            GetTextExtentPoint32W hDC, StrPtr(sPart), Len(sPart), sz
            TempRect.Left = rc.Left + sz.cx
        End If
        If TempRect.Left >= rc.Right Then Exit Sub
        sPart = Mid$(sText, lPos, Len(m_Filter))
        SetTextColor hDC, TranslateColor(m_FindTextColor)
        DrawTextW hDC, StrPtr(sPart), -1, TempRect, DT_SINGLELINE Or DT_VCENTER Or DT_NOPREFIX
        SetTextColor hDC, lFore
    End Sub

    Private Sub DrawArrow(ByVal hDC As LongPtr, ByVal X1 As Long, ByVal Y1 As Long, ByVal X2 As Long, ByVal Y2 As Long)
        Dim rc As RECT, hOld As LongPtr, sChr As String
        If isSegoeFontInstaled Then sChr = ChrW$(&HE970&) Else sChr = "}"
        SetRect4 rc, X1, Y1, X2, Y2
        hOld = SelectObject(hDC, m_hFontArrow)
        DrawTextW hDC, StrPtr(sChr), 1, rc, DT_SINGLELINE Or DT_VCENTER Or DT_CENTER Or DT_NOPREFIX
        SelectObject hDC, hOld
    End Sub

    Private Sub DrawCheckBox(ByVal hDC As LongPtr, ByVal Value As Boolean, ByVal bHighlight As Boolean, ByVal X1 As Long, ByVal Y1 As Long, ByVal X2 As Long, ByVal Y2 As Long, ByVal lFore As Long)
        Dim rc As RECT, hOld As LongPtr, sChr As String
        If isSegoeFontInstaled Then
            If Value Then sChr = ChrW$(&HE005&) Else sChr = ChrW$(&HE003&)
        Else
            If Value Then sChr = ChrW$(&H52&) Else sChr = ChrW$(&HA3&)
        End If
        If Value And Not bHighlight Then SetTextColor hDC, TranslateColor(m_SelectionColor)
        SetRect4 rc, X1, Y1, X2, Y2
        hOld = SelectObject(hDC, m_hFontCheck)
        DrawTextW hDC, StrPtr(sChr), 1, rc, DT_SINGLELINE Or DT_VCENTER Or DT_CENTER Or DT_NOPREFIX
        SelectObject hDC, hOld
        SetTextColor hDC, lFore
    End Sub

    Private Sub DrawLineColor(ByVal hDC As LongPtr, ByVal X As Long, ByVal Y As Long, ByVal X2 As Long, ByVal Y2 As Long, ByVal Color As Long)
        Dim hPen As LongPtr, hOld As LongPtr
        hPen = CreatePen(0, 1, TranslateColor(Color))
        hOld = SelectObject(hDC, hPen)
        MoveToEx hDC, X, Y, 0
        LineTo hDC, X2, Y2
        SelectObject hDC, hOld
        DeleteObject hPen
    End Sub

    Private Sub FillRectangle(ByVal hDC As LongPtr, ByRef rc As RECT, ByVal Color As Long)
        Dim hBrush As LongPtr
        hBrush = CreateSolidBrush(TranslateColor(Color))
        FillRect hDC, rc, hBrush
        DeleteObject hBrush
    End Sub

    Private Sub FillRectGradient(ByVal hDC As LongPtr, ByVal X As Long, ByVal Y As Long, ByVal W As Long, ByVal H As Long, ByVal Color1 As Long, ByVal Color2 As Long)
        Dim hGraphics As LongPtr, hBrush As LongPtr
        Dim gr As GPRECT
        If W <= 0 Or H <= 0 Then Exit Sub
        gr.X = X: gr.Y = Y - 1: gr.Width = W: gr.Height = H + 2
        If GdipCreateFromHDC(hDC, hGraphics) <> 0 Then Exit Sub
        If GdipCreateLineBrushFromRectI(gr, Color1, Color2, LinearGradientModeVertical, WrapModeTileFlipXY, hBrush) = 0 Then
            GdipFillRectangleI hGraphics, hBrush, X, Y, W, H
            GdipDeleteBrush hBrush
        End If
        GdipDeleteGraphics hGraphics
    End Sub

    ' Rectangulo redondeado con GDI+ (colores ARGB; 0 = sin relleno / sin borde)
    Private Sub RoundRectPlus(ByVal hDC As LongPtr, ByVal X As Long, ByVal Y As Long, ByVal W As Long, ByVal H As Long, ByVal lBackARGB As Long, ByVal lBorderARGB As Long, ByVal Radius As Long)
        Dim hGraphics As LongPtr, hBrush As LongPtr, hPen As LongPtr, hPath As LongPtr
        Dim D As Long
        If W <= 0 Or H <= 0 Then Exit Sub
        If GdipCreateFromHDC(hDC, hGraphics) <> 0 Then Exit Sub
        GdipSetSmoothingMode hGraphics, SmoothingModeAntiAlias
        If lBackARGB <> 0 Then GdipCreateSolidFill lBackARGB, hBrush
        If lBorderARGB <> 0 Then GdipCreatePen1 lBorderARGB, DpiFactor, UnitPixel, hPen
        D = Radius
        If D > W Then D = W
        If D > H Then D = H
        If D <= 1 Then
            If hBrush <> 0 Then GdipFillRectangleI hGraphics, hBrush, X, Y, W, H
            If hPen <> 0 Then GdipDrawRectangleI hGraphics, hPen, X, Y, W, H
        ElseIf GdipCreatePath(0, hPath) = 0 Then
            GdipAddPathArcI hPath, X, Y, D, D, 180, 90
            GdipAddPathArcI hPath, X + W - D, Y, D, D, 270, 90
            GdipAddPathArcI hPath, X + W - D, Y + H - D, D, D, 0, 90
            GdipAddPathArcI hPath, X, Y + H - D, D, D, 90, 90
            GdipClosePathFigure hPath
            If hBrush <> 0 Then GdipFillPath hGraphics, hBrush, hPath
            If hPen <> 0 Then GdipDrawPath hGraphics, hPen, hPath
            GdipDeletePath hPath
        End If
        If hBrush <> 0 Then GdipDeleteBrush hBrush
        If hPen <> 0 Then GdipDeletePen hPen
        GdipDeleteGraphics hGraphics
    End Sub

    Private Sub SetRect4(ByRef rc As RECT, ByVal L As Long, ByVal T As Long, ByVal R As Long, ByVal B As Long)
        rc.Left = L: rc.Top = T: rc.Right = R: rc.Bottom = B
    End Sub

    '======================================================================
    ' Fuentes
    '======================================================================
    Private Sub FreeFonts()
        If m_hFontBold <> 0 Then DeleteObject m_hFontBold: m_hFontBold = 0
        If m_hFontSmall <> 0 Then DeleteObject m_hFontSmall: m_hFontSmall = 0
        If m_hFontArrow <> 0 Then DeleteObject m_hFontArrow: m_hFontArrow = 0
        If m_hFontCheck <> 0 Then DeleteObject m_hFontCheck: m_hFontCheck = 0
        If m_hFontGlass <> 0 Then DeleteObject m_hFontGlass: m_hFontGlass = 0
    End Sub

    Private Function ScreenDpiY() As Long
        Dim hDC As LongPtr
        hDC = GetDC(0)
        ScreenDpiY = GetDeviceCaps(hDC, LOGPIXELSY)
        ReleaseDC 0, hDC
        If ScreenDpiY <= 0 Then ScreenDpiY = 96
    End Function

    Private Function MakeFont(ByVal sFace As String, ByVal dPoints As Double, ByVal lWeight As Long, ByVal lCharset As Long) As LongPtr
        Dim lf As LOGFONTW
        Dim b() As Byte
        lf.lfHeight = -CLng(dPoints * ScreenDpiY() / 72)
        lf.lfWeight = lWeight
        lf.lfCharSet = lCharset
        b = sFace & vbNullChar
        If UBound(b) > 63 Then ReDim Preserve b(63)
        CopyMemory lf.lfFaceName(0), b(0), UBound(b) + 1
        MakeFont = CreateFontIndirectW(lf)
    End Function

    Private Function FontFaceIs(ByVal hFont As LongPtr, ByVal sFace As String) As Boolean
        Dim hDC As LongPtr, hOld As LongPtr
        Dim sBuf As String, n As Long
        If hFont = 0 Then Exit Function
        hDC = GetDC(0)
        hOld = SelectObject(hDC, hFont)
        sBuf = String$(64, vbNullChar)
        n = GetTextFaceW(hDC, 64, StrPtr(sBuf))
        SelectObject hDC, hOld
        ReleaseDC 0, hDC
        If n > 0 Then
            sBuf = Left$(sBuf, InStr(sBuf & vbNullChar, vbNullChar) - 1)
            FontFaceIs = (StrComp(sBuf, sFace, vbTextCompare) = 0)
        End If
    End Function

    Private Sub BuildFonts()
        Dim lf As LOGFONTW
        Dim oFont As IFont
        Dim hDC As LongPtr, hOld As LongPtr
        Dim sz As SIZEAPI, s As String
        Dim dSize As Double

        FreeFonts
        Set oFont = UserControl.Font
        dSize = UserControl.Font.Size

        ' Negrita y pequena (subtexto) derivadas de la fuente del control
        If GetObjectW(oFont.hFont, LenB(lf), lf) <> 0 Then
            lf.lfWeight = FW_BOLD
            m_hFontBold = CreateFontIndirectW(lf)
            GetObjectW oFont.hFont, LenB(lf), lf
            If dSize > 2 Then lf.lfHeight = -CLng((dSize - 1) * ScreenDpiY() / 72)
            m_hFontSmall = CreateFontIndirectW(lf)
        End If

        ' Simbolos: Segoe MDL2 Assets o, si no esta instalada, Wingdings 2/3
        m_hFontArrow = MakeFont("Segoe MDL2 Assets", dSize, 400, 1)
        isSegoeFontInstaled = FontFaceIs(m_hFontArrow, "Segoe MDL2 Assets")
        If isSegoeFontInstaled Then
            m_hFontCheck = MakeFont("Segoe MDL2 Assets", 12, 400, 1)
            m_hFontGlass = MakeFont("Segoe MDL2 Assets", dSize, 400, 1)
        Else
            DeleteObject m_hFontArrow
            m_hFontArrow = MakeFont("Wingdings 3", dSize, 400, 2)
            m_hFontCheck = MakeFont("Wingdings 2", 14, 400, 2)
            m_hFontGlass = 0
        End If

        ' Alto de una linea de texto
        hDC = GetDC(0)
        hOld = SelectObject(hDC, oFont.hFont)
        s = "Aj"
        GetTextExtentPoint32W hDC, StrPtr(s), 2, sz
        SelectObject hDC, hOld
        ReleaseDC 0, hDC
        m_TextHeight = sz.cy
    End Sub

    '======================================================================
    ' Colores
    '======================================================================
    Private Function TranslateColor(ByVal Color As Long) As Long
        If (Color And &H80000000) <> 0 And Color <> CLR_NONE Then
            TranslateColor = GetSysColor(Color And &HFF&)
        Else
            TranslateColor = Color
        End If
    End Function

    Public Function RGBtoARGB(ByVal RGBColor As Long, ByVal Opacity As Long) As Long
        Dim a As Long
        RGBColor = TranslateColor(RGBColor)
        If Opacity < 0 Then Opacity = 0
        If Opacity > 100 Then Opacity = 100
        a = CLng(Opacity * 255 / 100)
        RGBtoARGB = (RGBColor And &HFF00&) Or ((RGBColor And &HFF&) * &H10000) Or ((RGBColor And &HFF0000) \ &H10000)
        If a > 127 Then
            RGBtoARGB = RGBtoARGB Or ((a - 128) * &H1000000) Or &H80000000
        Else
            RGBtoARGB = RGBtoARGB Or (a * &H1000000)
        End If
    End Function

    ' Mezcla: lAlpha (0..255) de clrFirst sobre clrSecond
    Private Function ShiftColor(ByVal clrFirst As Long, ByVal clrSecond As Long, ByVal lAlpha As Long) As Long
        Dim r1 As Long, g1 As Long, b1 As Long, r2 As Long, g2 As Long, b2 As Long
        clrFirst = TranslateColor(clrFirst)
        clrSecond = TranslateColor(clrSecond)
        r1 = clrFirst And &HFF&: g1 = (clrFirst \ &H100&) And &HFF&: b1 = (clrFirst \ &H10000) And &HFF&
        r2 = clrSecond And &HFF&: g2 = (clrSecond \ &H100&) And &HFF&: b2 = (clrSecond \ &H10000) And &HFF&
        r1 = (r1 * lAlpha + r2 * (255 - lAlpha)) \ 255
        g1 = (g1 * lAlpha + g2 * (255 - lAlpha)) \ 255
        b1 = (b1 * lAlpha + b2 * (255 - lAlpha)) \ 255
        ShiftColor = r1 Or (g1 * &H100&) Or (b1 * &H10000)
    End Function

    Private Function IsDarkColor(ByVal Color As Long) As Boolean
        Dim r As Long, g As Long, b As Long
        Color = TranslateColor(Color)
        r = Color And &HFF&: g = (Color \ &H100&) And &HFF&: b = (Color \ &H10000) And &HFF&
        IsDarkColor = ((r * 299 + g * 587 + b * 114) \ 1000) < 128
    End Function

    '======================================================================
    ' Lista de imagenes (GDI+)
    '======================================================================
    Public Function ImageListInitialize(Optional ByVal ImageWidth As Integer = 16, Optional ByVal ImageHeight As Integer = 16) As Boolean
        ImgLstWidth = ImageWidth * DpiFactor
        ImgLstHeight = ImageHeight * DpiFactor
        ImageListClear
        ImageListInitialize = True
    End Function

    Public Property Get ImgListWidth() As Long
        ImgListWidth = ImgLstWidth
    End Property

    Public Property Get ImgListHeight() As Long
        ImgListHeight = ImgLstHeight
    End Property

    Public Function ImageListAddImage(SrcImg As Variant, Optional Key As Variant) As Long
        Dim hImage As LongPtr
        hImage = LoadPictureEx(SrcImg, ImgLstWidth, ImgLstHeight)
        If hImage <> 0 Then
            If IsMissing(Key) Then
                cImageList.Add hImage
            Else
                cImageList.Add hImage, CStr(Key)
            End If
            ImageListAddImage = cImageList.Count
        End If
    End Function

    Public Function ImageListRemoveImage(Index As Variant) As Long
        GdipDisposeImage CLngPtr(cImageList(Index))
        cImageList.Remove Index
        ImageListRemoveImage = cImageList.Count
        Redraw
    End Function

    Public Function ImageListInsertImage(SrcImg As Variant, Optional Key As Variant, Optional Before As Variant, Optional After As Variant) As Long
        Dim hImage As LongPtr
        hImage = LoadPictureEx(SrcImg, ImgLstWidth, ImgLstHeight)
        If hImage <> 0 Then
            cImageList.Add hImage, Key, Before, After
            ImageListInsertImage = cImageList.Count
        End If
    End Function

    Public Sub ImageListClear()
        Dim i As Long
        For i = 1 To cImageList.Count
            GdipDisposeImage CLngPtr(cImageList(i))
        Next
        Set cImageList = New Collection
    End Sub

    Public Property Get ImageListCount() As Long
        ImageListCount = cImageList.Count
    End Property

    ' Index: 1..ImageListCount. PictureColor: tinte (iconos monocromo).
    Public Function ImageListDraw(ByVal hdc As LongPtr, ByVal Index As Long, ByVal Left As Long, ByVal Top As Long, ByVal Width As Long, ByVal Height As Long, Optional ByVal PictureColor As Long = CLR_NONE, Optional ByVal Disabled As Boolean) As Boolean
        Dim cm As COLORMATRIX
        Dim hAttr As LongPtr, hGraphics As LongPtr, hImage As LongPtr
        Dim sR As Single, sG As Single, sB As Single
        Dim lW As Long, lH As Long

        If Index < 1 Or Index > cImageList.Count Then Exit Function
        hImage = cImageList(Index)

        ' COLORMATRIX de GDI+ es m[fila][columna]. En este tipo VB, M(i, j) se
        ' guarda en el desplazamiento de la fila j, columna i (orden de columnas).
        If PictureColor <> CLR_NONE Then
            ' Tinte: el color del pixel pasa a ser PictureColor y se conserva alfa
            PictureColor = TranslateColor(PictureColor)
            sR = (PictureColor And &HFF&) / 255
            sG = ((PictureColor \ &H100&) And &HFF&) / 255
            sB = ((PictureColor \ &H10000) And &HFF&) / 255
            cm.M(0, 4) = sR: cm.M(1, 4) = sG: cm.M(2, 4) = sB     'fila 4 (traslacion)
            cm.M(3, 3) = 1
            cm.M(4, 4) = 1
        ElseIf Disabled Then
            ' Escala de grises
            cm.M(0, 0) = 0.299: cm.M(1, 0) = 0.299: cm.M(2, 0) = 0.299
            cm.M(0, 1) = 0.587: cm.M(1, 1) = 0.587: cm.M(2, 1) = 0.587
            cm.M(0, 2) = 0.114: cm.M(1, 2) = 0.114: cm.M(2, 2) = 0.114
            cm.M(3, 3) = 1
            cm.M(4, 4) = 1
        Else
            cm.M(0, 0) = 1: cm.M(1, 1) = 1: cm.M(2, 2) = 1: cm.M(3, 3) = 1: cm.M(4, 4) = 1
        End If
        ' Deshabilitado: semitransparente
        If Disabled Then cm.M(3, 3) = 0.5

        GdipGetImageWidth hImage, lW
        GdipGetImageHeight hImage, lH
        If GdipCreateImageAttributes(hAttr) <> 0 Then Exit Function
        GdipSetImageAttributesColorMatrix hAttr, 0, 1, cm, 0, 0
        If GdipCreateFromHDC(hdc, hGraphics) = 0 Then
            ImageListDraw = (GdipDrawImageRectRectI(hGraphics, hImage, Left, Top, Width, Height, 0, 0, lW, lH, UnitPixel, hAttr, 0, 0) = 0)
            GdipDeleteGraphics hGraphics
        End If
        GdipDisposeImageAttributes hAttr
    End Function

    ' Carga una imagen (ruta, URL http(s), data:...;base64, StdPicture,
    ' HBITMAP/HICON, IStream o array de bytes) ajustada a Width x Height.
    ' Devuelve un GpImage propio (o 0).
    Private Function LoadPictureEx(SrcImg As Variant, ByVal Width As Long, ByVal Height As Long) As LongPtr
        Dim hImg As LongPtr, hOut As LongPtr, hGraphics As LongPtr, hPath As LongPtr, hPen As LongPtr
        Dim DataArr() As Byte
        Dim sSrc As String
        Dim oHttp As Object
        Dim oPic As StdPicture
        Dim hHandle As LongPtr
        Dim rw As Long, rh As Long, X As Long, Y As Long, cx As Long, cy As Long
        Dim dRatio As Double, D As Long

        On Error GoTo Fail
        If IsObject(SrcImg) Then
            If TypeOf SrcImg Is StdPicture Then
                Set oPic = SrcImg
                If oPic.Type = vbPicTypeIcon Then
                    GdipCreateBitmapFromHICON oPic.Handle, hImg
                ElseIf oPic.Type = vbPicTypeBitmap Then
                    GdipCreateBitmapFromHBITMAP oPic.Handle, oPic.hPal, hImg
                End If
            Else
                GdipLoadImageFromStream SrcImg, hImg
            End If
        Else
            Select Case VarType(SrcImg)
                Case vbString
                    sSrc = SrcImg
                    If LCase$(Left$(sSrc, 5)) = "data:" Then
                        If Base64Decode(Mid$(sSrc, InStr(sSrc, ",") + 1), DataArr) Then LoadImageFromArray DataArr, hImg
                    ElseIf PathIsURLW(StrPtr(sSrc)) <> 0 Then
                        Set oHttp = CreateObject("MSXML2.ServerXMLHTTP.6.0")
                        oHttp.Open "GET", sSrc, False
                        oHttp.send
                        If oHttp.Status = 200 Then
                            DataArr = oHttp.responseBody
                            LoadImageFromArray DataArr, hImg
                        End If
                    Else
                        GdipLoadImageFromFile StrPtr(sSrc), hImg
                    End If
                Case vbLong, vbInteger, vbLongLong
                    hHandle = CLngPtr(SrcImg)
                    If GetObjectType(hHandle) = OBJ_BITMAP Then
                        GdipCreateBitmapFromHBITMAP hHandle, 0, hImg
                    Else
                        GdipCreateBitmapFromHICON hHandle, hImg
                    End If
                Case vbArray Or vbByte
                    DataArr = SrcImg
                    LoadImageFromArray DataArr, hImg
            End Select
        End If
        If hImg = 0 Then Exit Function

        GdipGetImageWidth hImg, rw
        GdipGetImageHeight hImg, rh
        If rw <= 0 Or rh <= 0 Then GdipDisposeImage hImg: Exit Function
        If Width <= 0 Then Width = rw
        If Height <= 0 Then Height = rh
        dRatio = Width / rw
        If Height / rh < dRatio Then dRatio = Height / rh
        cx = rw * dRatio: cy = rh * dRatio
        If cx < 1 Then cx = 1
        If cy < 1 Then cy = 1
        X = (Width - cx) \ 2: Y = (Height - cy) \ 2

        If GdipCreateBitmapFromScan0(Width, Height, 0, PixelFormat32bppPARGB, 0, hOut) = 0 Then
            If GdipGetImageGraphicsContext(hOut, hGraphics) = 0 Then
                GdipSetSmoothingMode hGraphics, SmoothingModeAntiAlias
                If m_ImagesRadius > 0 Then
                    D = m_ImagesRadius * DpiFactor * 2
                    If D > cx Then D = cx
                    If D > cy Then D = cy
                    If D > 1 Then
                        If GdipCreatePath(0, hPath) = 0 Then
                            GdipAddPathArcI hPath, X, Y, D, D, 180, 90
                            GdipAddPathArcI hPath, X + cx - D, Y, D, D, 270, 90
                            GdipAddPathArcI hPath, X + cx - D, Y + cy - D, D, D, 0, 90
                            GdipAddPathArcI hPath, X, Y + cy - D, D, D, 90, 90
                            GdipClosePathFigure hPath
                            GdipSetClipPath hGraphics, hPath, CombineModeIntersect
                        End If
                    End If
                End If
                GdipDrawImageRectRectI hGraphics, hImg, X, Y, cx, cy, 0, 0, rw, rh, UnitPixel, 0, 0, 0
                If hPath <> 0 Then
                    GdipResetClip hGraphics
                    GdipDeletePath hPath
                End If
                GdipDeleteGraphics hGraphics
            End If
        End If
        GdipDisposeImage hImg
        LoadPictureEx = hOut
        Exit Function
Fail:
        If hImg <> 0 Then GdipDisposeImage hImg
        If hOut <> 0 Then GdipDisposeImage hOut
        LoadPictureEx = 0
    End Function

    Private Function LoadImageFromArray(ByRef bvData() As Byte, ByRef hImage As LongPtr) As Boolean
        Dim oStream As IUnknown
        Dim hMem As LongPtr, pMem As LongPtr
        Dim lSize As Long
        On Error Resume Next
        lSize = UBound(bvData) - LBound(bvData) + 1
        If Err.Number <> 0 Or lSize <= 0 Then Exit Function
        On Error GoTo 0
        hMem = GlobalAlloc(GMEM_MOVEABLE, lSize)
        If hMem = 0 Then Exit Function
        pMem = GlobalLock(hMem)
        CopyMemory ByVal pMem, bvData(LBound(bvData)), lSize
        GlobalUnlock hMem
        If CreateStreamOnHGlobal(hMem, 1, oStream) = 0 Then
            LoadImageFromArray = (GdipLoadImageFromStream(oStream, hImage) = 0)
        Else
            GlobalFree hMem
        End If
        Set oStream = Nothing
    End Function

    Private Function Base64Decode(ByVal sIn As String, ByRef bvOut() As Byte) As Boolean
        Const CRYPT_STRING_BASE64 As Long = 1
        Dim n As Long
        If Len(sIn) = 0 Then Exit Function
        CryptStringToBinaryW StrPtr(sIn), Len(sIn), CRYPT_STRING_BASE64, 0, n, 0, 0
        If n = 0 Then Exit Function
        ReDim bvOut(n - 1)
        Base64Decode = (CryptStringToBinaryW(StrPtr(sIn), Len(sIn), CRYPT_STRING_BASE64, VarPtr(bvOut(0)), n, 0, 0) <> 0)
    End Function

    '======================================================================
    ' Utilidades
    '======================================================================
    Private Function LoWordSigned(ByVal Value As LongPtr) As Long
        Dim w(1) As Integer
        CopyMemory w(0), Value, 4
        LoWordSigned = w(0)
    End Function

    Private Function HiWordSigned(ByVal Value As LongPtr) As Long
        Dim w(1) As Integer
        CopyMemory w(0), Value, 4
        HiWordSigned = w(1)
    End Function

    '======================================================================
    ' Mensajes (llamado desde mUcListHelpers.UCL_ListProc)
    '======================================================================
    Public Function zzWndProc(ByVal hWnd As LongPtr, ByVal uMsg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr
        On Error Resume Next
        If hWnd = m_hList And m_hList <> 0 Then
            zzWndProc = ListProc(hWnd, uMsg, wParam, lParam)
        ElseIf hWnd = m_hEdit And m_hEdit <> 0 Then
            zzWndProc = EditProc(hWnd, uMsg, wParam, lParam)
        ElseIf hWnd = m_hSrc And m_hSrc <> 0 Then
            zzWndProc = SrcProc(hWnd, uMsg, wParam, lParam)
        ElseIf hWnd = m_hOwnerSub And m_hOwnerSub <> 0 Then
            zzWndProc = OwnerProc(hWnd, uMsg, wParam, lParam)
        ElseIf hWnd = m_hUC And m_hUC <> 0 Then
            zzWndProc = UCProc(hWnd, uMsg, wParam, lParam)
        Else
            zzWndProc = UCL_DefProc(hWnd, uMsg, wParam, lParam)
        End If
    End Function

    ' Ventana de la lista
    Private Function ListProc(ByVal hWnd As LongPtr, ByVal uMsg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr
        Dim KeyCode As Integer, KeyAscii As Integer
        Dim lBack As Long, lFore As Long
        Dim f As LongPtr

        Select Case uMsg
            Case WM_PAINT
                PaintList
                Exit Function

            Case WM_ERASEBKGND
                ListProc = 1
                Exit Function

            Case WM_SIZE
                m_LayoutDirty = True
                InvalidateRect hWnd, 0, 0

            Case WM_MOUSEACTIVATE
                If m_bPopupWnd Then
                    ListProc = MA_NOACTIVATE
                    Exit Function
                End If

            Case WM_ACTIVATE
                ' La emergente se activa al dar el foco al filtro. Si pierde la
                ' activacion en favor de otra ventana (Alt+Tab, otra aplicacion,
                ' el formulario), se cierra.
                ' Volver al formulario propio no cierra (los clics fuera ya los
                ' detecta el gancho de raton).
                If m_bPopupWnd And (CLng(wParam) And &HFFFF&) = 0 Then
                    If lParam <> m_hOwner And Not UCL_PopupsOwnWindow(lParam) Then zzRequestClose
                End If

            Case WM_SETCURSOR
                If CLng(lParam And &HFFFF&) = HTCLIENT Then
                    If SetCursorFromPointer() Then
                        ListProc = 1
                        Exit Function
                    End If
                End If

            Case WM_MOUSEMOVE
                OnMouseMove LoWordSigned(lParam), HiWordSigned(lParam), CLng(wParam And &HFFFF&)
                Exit Function

            Case WM_MOUSELEAVE
                OnMouseLeave
                Exit Function

            Case WM_LBUTTONDOWN
                OnMouseDown vbLeftButton, LoWordSigned(lParam), HiWordSigned(lParam), CLng(wParam And &HFFFF&)
                Exit Function

            Case WM_LBUTTONDBLCLK
                ' Secuencia VB: MouseDown, MouseUp, DblClick, MouseUp
                If SB_HitTest(LoWordSigned(lParam), HiWordSigned(lParam)) <> SBP_NONE Then
                    OnMouseDown vbLeftButton, LoWordSigned(lParam), HiWordSigned(lParam), CLng(wParam And &HFFFF&)
                Else
                    RaiseEvent DblClick
                End If
                Exit Function

            Case WM_LBUTTONUP
                OnMouseUp vbLeftButton, LoWordSigned(lParam), HiWordSigned(lParam), CLng(wParam And &HFFFF&)
                Exit Function

            Case WM_RBUTTONDOWN, WM_RBUTTONDBLCLK
                OnMouseDown vbRightButton, LoWordSigned(lParam), HiWordSigned(lParam), CLng(wParam And &HFFFF&)
                Exit Function

            Case WM_RBUTTONUP
                OnMouseUp vbRightButton, LoWordSigned(lParam), HiWordSigned(lParam), CLng(wParam And &HFFFF&)
                Exit Function

            Case WM_MBUTTONDOWN
                OnMouseDown vbMiddleButton, LoWordSigned(lParam), HiWordSigned(lParam), CLng(wParam And &HFFFF&)
                Exit Function

            Case WM_MBUTTONUP
                OnMouseUp vbMiddleButton, LoWordSigned(lParam), HiWordSigned(lParam), CLng(wParam And &HFFFF&)
                Exit Function

            Case WM_CAPTURECHANGED
                If lParam <> hWnd And sbPressed <> SBP_NONE Then
                    sbPressed = SBP_NONE
                    KillTimer hWnd, TIMER_SCROLL
                    Redraw
                End If

            Case WM_MOUSEWHEEL
                OnMouseWheel HiWordSigned(wParam)
                Exit Function

            Case WM_TIMER
                Select Case CLng(wParam)
                    Case TIMER_SUBMENU
                        KillTimer hWnd, TIMER_SUBMENU
                        If m_SubPending >= 0 Then
                            If m_SubPending = m_HotItem Then ShowSubMenu m_SubPending
                        ElseIf m_SubPending = -2 Then
                            HideChildMenu
                        End If
                        m_SubPending = -1
                        Exit Function
                    Case TIMER_SCROLL
                        SB_RepeatTick
                        Exit Function
                End Select

            Case WM_GETDLGCODE
                ' ListBox: flechas, caracteres y Enter. Tab sigue al formulario.
                ListProc = DLGC_WANTARROWS Or DLGC_WANTCHARS
                If DlgMsgIsKey(lParam, vbKeyReturn) Then ListProc = ListProc Or DLGC_WANTMESSAGE
                Exit Function

            Case WM_KEYDOWN
                If Not m_bPopupWnd Then
                    If Not KeyAlreadyHandled(CLng(wParam And &HFFFF&)) Then
                        KeyCode = CInt(wParam And &HFF&)
                        HandleKeyDownWithEvent KeyCode, ShiftState()
                    End If
                    Exit Function
                End If

            Case WM_KEYUP
                If Not m_bPopupWnd Then
                    KeyCode = CInt(wParam And &HFF&)
                    RaiseEvent KeyUp(KeyCode, ShiftState())
                    Exit Function
                End If

            Case WM_CHAR
                If Not m_bPopupWnd Then
                    If Not KeyAlreadyHandled(-CLng(wParam And &HFFFF&)) Then
                        KeyAscii = LoWordSigned(wParam)
                        KeyPressLogic KeyAscii
                    End If
                    Exit Function
                End If

            Case WM_SETFOCUS
                FocusChanged True

            Case WM_KILLFOCUS
                f = wParam
                If f = 0 Or (f <> m_hEdit And f <> m_hUC) Then FocusChanged False

            Case WM_COMMAND
                If lParam = m_hEdit And m_hEdit <> 0 Then
                    If (HiWordSigned(wParam) And &HFFFF&) = EN_CHANGE Then
                        If Not m_bSettingEdit Then ApplyFilter WindowText(m_hEdit)
                        Exit Function
                    End If
                End If

            Case WM_CTLCOLOREDIT
                If lParam = m_hEdit And m_hEdit <> 0 Then
                    lBack = TranslateColor(UserControl.BackColor)
                    If IsDarkColor(lBack) Then lFore = vbWhite Else lFore = vbBlack
                    If m_hEditBrush = 0 Or m_EditBrushColor <> lBack Then
                        If m_hEditBrush <> 0 Then DeleteObject m_hEditBrush
                        m_hEditBrush = CreateSolidBrush(lBack)
                        m_EditBrushColor = lBack
                    End If
                    SetTextColor wParam, lFore
                    SetBkColor wParam, lBack
                    ListProc = m_hEditBrush
                    Exit Function
                End If

            Case WM_UCL_CLOSE
                If bShow And CLng(wParam) = m_ShowGen Then HideList
                Exit Function

            Case WM_UCL_KEY
                If bShow Then
                    KeyCode = CInt(wParam And &HFF&)
                    KeyDownLogic KeyCode, CInt(lParam And &HFFFF&)
                End If
                Exit Function

            Case WM_UCL_CHAR
                If bShow Then
                    KeyAscii = LoWordSigned(wParam)
                    If m_ShowFilter And m_hEdit <> 0 Then
                        RaiseEvent KeyPress(KeyAscii)
                        If KeyAscii <> 0 Then SendMessageW m_hEdit, WM_CHAR, KeyAscii And &HFFFF&, 0
                    Else
                        KeyPressLogic KeyAscii
                    End If
                End If
                Exit Function

            Case WM_UCL_EDITCMD
                If bShow And m_hEdit <> 0 Then
                    Select Case CLng(wParam)
                        Case EDITCMD_DELETE
                            SendMessageW m_hEdit, WM_KEYDOWN, VK_DELETE, 0
                            SendMessageW m_hEdit, WM_KEYUP, VK_DELETE, 0
                        Case EDITCMD_PASTE: SendMessageW m_hEdit, WM_PASTE, 0, 0
                        Case EDITCMD_COPY:  SendMessageW m_hEdit, WM_COPY, 0, 0
                        Case EDITCMD_CUT:   SendMessageW m_hEdit, WM_CUT, 0, 0
                        Case EDITCMD_SELALL: SendMessageW m_hEdit, EM_SETSEL, 0, -1
                    End Select
                End If
                Exit Function

            Case WM_UCL_FOCUSEDIT
                If bShow And CLng(wParam) = m_ShowGen And m_hEdit <> 0 Then SetFocusAPI m_hEdit
                Exit Function

            Case WM_UCL_WHEEL
                OnMouseWheel CLng(wParam)
                Exit Function

            Case WM_NCDESTROY
                ListProc = UCL_DefProc(hWnd, uMsg, wParam, lParam)
                UCL_UnsubclassList hWnd, ObjPtr(Me)
                If bShow Then
                    bShow = False
                    UCL_PopupRemove ObjPtr(Me)
                    cShadow.HideBorders
                End If
                m_hList = 0
                m_bPopupWnd = False
                Exit Function
        End Select
        ListProc = UCL_DefProc(hWnd, uMsg, wParam, lParam)
    End Function

    ' Filtro (EDIT). En modo emergente nunca tiene el foco: recibe los
    ' caracteres por WM_UCL_CHAR. En modo ListBox si puede tenerlo.
    Private Function EditProc(ByVal hWnd As LongPtr, ByVal uMsg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr
        Dim KeyCode As Integer, KeyAscii As Integer
        Dim f As LongPtr
        Select Case uMsg
            Case WM_GETDLGCODE
                EditProc = UCL_DefProc(hWnd, uMsg, wParam, lParam) Or DLGC_WANTARROWS Or DLGC_WANTCHARS Or DLGC_HASSETSEL
                If DlgMsgIsKey(lParam, vbKeyReturn) Then EditProc = EditProc Or DLGC_WANTMESSAGE
                Exit Function

            Case WM_KEYDOWN
                m_EditSkipChar = False
                If Not m_bPopupWnd Then
                    KeyCode = CInt(wParam And &HFF&)
                    Select Case KeyCode
                        Case vbKeyUp, vbKeyDown, vbKeyPageUp, vbKeyPageDown, vbKeyReturn
                            ' Navegacion de la lista desde el filtro
                            HandleKeyDownWithEvent KeyCode, ShiftState()
                            m_EditSkipChar = True       'sin pitido por el WM_CHAR que sigue
                            Exit Function
                    End Select
                End If

            Case WM_CHAR
                If m_EditSkipChar Then
                    m_EditSkipChar = False
                    Exit Function
                End If
                If CLng(wParam) = vbKeyReturn Or CLng(wParam) = vbKeyEscape Then Exit Function
                If Not m_bPopupWnd Then
                    KeyAscii = LoWordSigned(wParam)
                    RaiseEvent KeyPress(KeyAscii)
                    If KeyAscii = 0 Then Exit Function
                    wParam = KeyAscii And &HFFFF&
                End If

            Case WM_MOUSEWHEEL
                If m_hList <> 0 Then
                    EditProc = SendMessageW(m_hList, uMsg, wParam, lParam)
                    Exit Function
                End If

            Case WM_SETFOCUS
                FocusChanged True
                If m_hList <> 0 Then InvalidateRect m_hList, 0, 0

            Case WM_KILLFOCUS
                f = wParam
                If f = 0 Or (f <> m_hList And f <> m_hUC) Then FocusChanged False
                If m_hList <> 0 Then InvalidateRect m_hList, 0, 0

            Case WM_NCDESTROY
                EditProc = UCL_DefProc(hWnd, uMsg, wParam, lParam)
                UCL_UnsubclassList hWnd, ObjPtr(Me)
                m_hEdit = 0
                Exit Function
        End Select
        EditProc = UCL_DefProc(hWnd, uMsg, wParam, lParam)
    End Function

    ' TextBox de AutoCompleteTextBox
    Private Function SrcProc(ByVal hWnd As LongPtr, ByVal uMsg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr
        Dim lCh As Long
        Dim sText As String
        Select Case uMsg
            Case WM_CHAR, WM_PASTE, WM_CUT, WM_CLEAR, WM_UNDO, WM_KEYDOWN
                SrcProc = UCL_DefProc(hWnd, uMsg, wParam, lParam)
                If m_bSettingSrc Then Exit Function
                If uMsg = WM_CHAR Then
                    lCh = CLng(wParam And &HFFFF&)
                    If lCh < 32 And lCh <> vbKeyBack Then Exit Function     'Enter, Tab, Esc, Ctrl+...
                ElseIf uMsg = WM_KEYDOWN Then
                    If CLng(wParam And &HFF&) <> VK_DELETE Then Exit Function
                End If
                ' Solo cambios hechos por el usuario en el control con el foco
                If GetFocus() <> hWnd Then Exit Function
                sText = WindowText(hWnd)
                If sText <> m_SrcLastText Then
                    m_SrcLastText = sText
                    SrcTextChanged
                End If
                Exit Function

            Case WM_SETTEXT
                ' Texto asignado por codigo: se recuerda pero no abre la lista
                SrcProc = UCL_DefProc(hWnd, uMsg, wParam, lParam)
                m_SrcLastText = WindowText(hWnd)
                Exit Function

            Case WM_KILLFOCUS
                ' El foco salio del TextBox (Tab, clic en otro control...): cerrar
                If bShow And Not UCL_PopupsOwnWindow(wParam) Then zzRequestClose

            Case WM_NCDESTROY
                SrcProc = UCL_DefProc(hWnd, uMsg, wParam, lParam)
                UCL_UnsubclassList hWnd, ObjPtr(Me)
                m_hSrc = 0
                Exit Function
        End Select
        SrcProc = UCL_DefProc(hWnd, uMsg, wParam, lParam)
    End Function

    ' Formulario propietario mientras la emergente esta abierta
    Private Function OwnerProc(ByVal hWnd As LongPtr, ByVal uMsg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr
        Dim lFlags As Long
        Select Case uMsg
            Case WM_ACTIVATE
                ' WA_INACTIVE: se cierra salvo que se active una de nuestras
                ' emergentes (clic en el filtro, que toma el foco)
                If (CLng(wParam) And &HFFFF&) = 0 Then
                    If Not UCL_PopupsOwnWindow(lParam) Then zzRequestClose
                End If
            Case WM_WINDOWPOSCHANGED
                ' WINDOWPOS: hwnd, hwndInsertAfter, x, y, cx, cy, flags
                If lParam <> 0 Then
                    CopyMemory lFlags, ByVal (lParam + LenB(lParam) * 2 + 16), 4
                    If (lFlags And (SWP_NOMOVE Or SWP_NOSIZE)) <> (SWP_NOMOVE Or SWP_NOSIZE) Then zzRequestClose
                End If
            Case WM_DESTROY
                OwnerProc = UCL_DefProc(hWnd, uMsg, wParam, lParam)
                If bShow Then HideList
                Exit Function
            Case WM_NCDESTROY
                OwnerProc = UCL_DefProc(hWnd, uMsg, wParam, lParam)
                UCL_UnsubclassList hWnd, ObjPtr(Me)
                m_hOwnerSub = 0
                Exit Function
        End Select
        OwnerProc = UCL_DefProc(hWnd, uMsg, wParam, lParam)
    End Function

    ' Ventana del UserControl
    Private Function UCProc(ByVal hWnd As LongPtr, ByVal uMsg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr
        Select Case uMsg
            Case WM_SETFOCUS
                UCProc = UCL_DefProc(hWnd, uMsg, wParam, lParam)
                If m_ListStyle = StyleListBox And m_hList <> 0 And Not m_bPopupWnd Then SetFocusAPI FocusTarget()
                Exit Function
            Case WM_MOUSEWHEEL
                If m_hList <> 0 And Not m_bPopupWnd Then
                    UCProc = SendMessageW(m_hList, uMsg, wParam, lParam)
                    Exit Function
                End If
            Case WM_NCDESTROY
                UCProc = UCL_DefProc(hWnd, uMsg, wParam, lParam)
                UCL_UnsubclassList hWnd, ObjPtr(Me)
                m_hUC = 0
                Exit Function
        End Select
        UCProc = UCL_DefProc(hWnd, uMsg, wParam, lParam)
    End Function

    ' lParam de WM_GETDLGCODE: puntero a MSG o 0. True si es WM_KEYDOWN de vk.
    Private Function DlgMsgIsKey(ByVal lParam As LongPtr, ByVal vk As Long) As Boolean
        Dim lMsg As Long, wp As LongPtr, lPtr As Long
        If lParam = 0 Then Exit Function
        lPtr = LenB(lParam)
        CopyMemory lMsg, ByVal (lParam + lPtr), 4
        CopyMemory wp, ByVal (lParam + lPtr * 2), lPtr
        DlgMsgIsKey = (lMsg = WM_KEYDOWN And CLng(wp And &HFF&) = vk)
    End Function

    ' Aspecto de foco en modo ListBox (sombra y borde)
    Private Sub FocusChanged(ByVal bFocus As Boolean)
        If bFocus = bHasFocus Then Exit Sub
        bHasFocus = bFocus
        If m_ListStyle <> StyleListBox Then Exit Sub
        With cShadow
            If bFocus Then
                .ShadowOpacity = 25
                .ShadowColor = m_SelectionColor
                .BorderColor = m_SelectionColor
            Else
                .ShadowOpacity = 10
                .ShadowColor = vbBlack
                .BorderColor = m_BorderColor
            End If
            If m_BorderVisible Then .Refresh
        End With
        Redraw
    End Sub

End Class
