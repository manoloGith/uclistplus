    Public Function ChrW2(ByVal CharCode As Long) As String
        If CharCode <= &HFFFF& Then
            ChrW2 = ChrW$(CharCode)
        Else
            CharCode = CharCode - &H10000
            ChrW2 = ChrW$(&HD800& + (CharCode \ &H400&)) & ChrW$(&HDC00& + (CharCode And &H3FF&))
        End If
    End Function

    Public Sub Refresh()
        Redraw
    End Sub

    Public Sub Update(Optional bResize As Boolean = True)
        m_LayoutDirty = True
        EnsureEdit
        If m_hList <> 0 Then
            If bShow And bResize Then ResizePopup
            If Not m_bPopupWnd And bResize Then UserControl_Resize
            If m_ListStyle = StyleListBox And m_BorderVisible Then cShadow.Refresh
        End If
        Redraw
    End Sub

