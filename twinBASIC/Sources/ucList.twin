    Public Function ImageListInitialize(Optional ByVal ImageWidth As Integer = 16, Optional ByVal ImageHeight As Integer = 16) As Boolean
        ImgLstWidth = ImageWidth * DpiFactor
        ImgLstHeight = ImageHeight * DpiFactor
        ImageListClear
        ImageListInitialize = True
    End Function

    Public Property Get ImgListWidth() As Long
        ImgListWidth = ImgLstWidth
    End Property

    Public Property Get ImgListHeight() As Long
        ImgListHeight = ImgLstHeight
    End Property

    Public Function ImageListAddImage(SrcImg As Variant, Optional Key As Variant) As Long
        Dim hImage As LongPtr
        hImage = LoadPictureEx(SrcImg, ImgLstWidth, ImgLstHeight)
        If hImage <> 0 Then
            cImageList.Add hImage, Key
            ImageListAddImage = cImageList.Count
        End If
    End Function

    Public Function ImageListRemoveImage(Index As Variant) As Long
        GdipDisposeImage CLngPtr(cImageList(Index))
        cImageList.Remove Index
        ImageListRemoveImage = cImageList.Count
    End Function

    Public Function ImageListInsertImage(SrcImg As Variant, Optional Key As Variant, Optional Before As Variant, Optional After As Variant) As Long
        Dim hImage As LongPtr
        hImage = LoadPictureEx(SrcImg, ImgLstWidth, ImgLstHeight)
        If hImage <> 0 Then
            cImageList.Add hImage, Key, Before, After
            ImageListInsertImage = cImageList.Count
        End If
    End Function

    Public Sub ImageListClear()
        Dim i As Long
        For i = 1 To cImageList.Count
            GdipDisposeImage CLngPtr(cImageList(i))
        Next
        Set cImageList = New Collection
    End Sub

    Public Property Get ImageListCount() As Long
        ImageListCount = cImageList.Count
    End Property

    Private Sub RoundRectPlus(ByVal lHdc As LongPtr, ByVal Left As Long, ByVal Top As Long, _
                              ByVal Width As Long, ByVal Height As Long, ByVal BackColor As Long, ByVal BorderColor As Long, ByVal Radius As Long)
        Dim hPen As LongPtr, hBrush As LongPtr
        Dim mpath As LongPtr, hGraphics As LongPtr

        GdipCreateFromHDC lHdc, hGraphics
        GdipSetSmoothingMode hGraphics, SmoothingModeAntiAlias

        If BackColor <> 0 Then GdipCreateSolidFill BackColor, hBrush
        If BorderColor <> 0 Then GdipCreatePen1 BorderColor, 1 * DpiFactor, &H2, hPen

        If Radius = 0 Then

            If hBrush Then GdipFillRectangleI hGraphics, hBrush, Left, Top, Width, Height
            If hPen Then GdipDrawRectangleI hGraphics, hPen, Left, Top, Width, Height

        Else
            If GdipCreatePath(0, mpath) = 0 Then

                GdipAddPathArcI mpath, Left, Top, Radius, Radius, 180, 90
                GdipAddPathArcI mpath, Left + Width - Radius, Top, Radius, Radius, 270, 90
                GdipAddPathArcI mpath, Left + Width - Radius, Top + Height - Radius, Radius, Radius, 0, 90
                GdipAddPathArcI mpath, Left, Top + Height - Radius, Radius, Radius, 90, 90
                GdipClosePathFigure mpath

                If hBrush Then GdipFillPath hGraphics, hBrush, mpath
                If hPen Then GdipDrawPath hGraphics, hPen, mpath
                Call GdipDeletePath(mpath)
            End If
        End If

        If hBrush Then Call GdipDeleteBrush(hBrush)
        If hPen Then Call GdipDeletePen(hPen)
        GdipDeleteGraphics hGraphics
    End Sub

    Private Function LoadPictureEx(SrcImg As Variant, Optional ByVal Width As Long, Optional ByVal Height As Long) As LongPtr
        Const OBJ_BITMAP As Long = 7
        Dim hImage1 As LongPtr, hImage2 As LongPtr, hGraphics As LongPtr
        Dim DataArr() As Byte
        Dim lPictureRealWidth As Long, lPictureRealHeight As Long
        Dim X As Long, Y As Long, cx As Long, cy As Long
        Dim sngRatio1 As Single, sngRatio2 As Single
        Dim mpath As LongPtr, Radius As Long, hPen As LongPtr
        Dim sSrc As String
        Dim oXMLHTTP As Object
        Dim hHandle As LongPtr

        Select Case VarType(SrcImg)
            Case vbString
                sSrc = SrcImg
                If PathIsURLW(StrPtr(sSrc)) Then

                    If LCase$(Left$(sSrc, 5)) = "data:" Then
                        If Base64Decode(Split(sSrc, ",")(1), DataArr) Then
                            Call LoadImageFromArray(DataArr, hImage1)
                        End If
                    Else
                        Set oXMLHTTP = CreateObject("Microsoft.XMLHTTP")

                        oXMLHTTP.Open "GET", sSrc, True
                        oXMLHTTP.send
                        While oXMLHTTP.readyState <> 4
                            DoEvents
                        Wend
                        If oXMLHTTP.Status = 200 Then
                            DataArr() = oXMLHTTP.responseBody
                            Call LoadImageFromArray(DataArr, hImage1)
                        End If
                    End If
                Else
                    Call GdipLoadImageFromFile(StrPtr(sSrc), hImage1)
                End If

            Case vbLong, vbInteger, vbLongLong
                hHandle = CLngPtr(SrcImg)
                If GetObjectType(hHandle) = OBJ_BITMAP Then
                    Call GdipCreateBitmapFromHBITMAP(hHandle, 0, hImage1)
                Else
                    Call GdipCreateBitmapFromHICON(hHandle, hImage1)
                End If

            Case vbDataObject, vbObject
                Call GdipLoadImageFromStream(SrcImg, hImage1)

            Case (vbArray Or vbByte)
                DataArr() = SrcImg
                Call LoadImageFromArray(DataArr, hImage1)
        End Select

        If hImage1 <> 0 Then
            GdipGetImageWidth hImage1, lPictureRealWidth
            GdipGetImageHeight hImage1, lPictureRealHeight
            If Width = 0 Then Width = lPictureRealWidth
            If Height = 0 Then Height = lPictureRealHeight

            sngRatio1 = Width / lPictureRealWidth
            sngRatio2 = Height / lPictureRealHeight
            If sngRatio1 > sngRatio2 Then sngRatio1 = sngRatio2
            cx = lPictureRealWidth * sngRatio1: cy = lPictureRealHeight * sngRatio1
            X = (Width - cx) \ 2: Y = (Height - cy) \ 2

            GdipCreateBitmapFromScan0 Width, Height, 0&, PixelFormat32bppPARGB, 0, hImage2
            GdipGetImageGraphicsContext hImage2, hGraphics
            GdipSetSmoothingMode hGraphics, SmoothingModeAntiAlias

            If m_ImagesRadius > 0 Then
                Radius = m_ImagesRadius * DpiFactor
                If GdipCreatePath(0, mpath) = 0 Then
                    X = X + DpiFactor: Y = Y + DpiFactor
                    cx = cx - DpiFactor * 2: cy = cy - DpiFactor * 2
                    GdipAddPathArcI mpath, X, Y, Radius, Radius, 180, 90
                    GdipAddPathArcI mpath, X + cx - Radius, Y, Radius, Radius, 270, 90
                    GdipAddPathArcI mpath, X + cx - Radius, Y + cy - Radius, Radius, Radius, 0, 90
                    GdipAddPathArcI mpath, X, Y + cy - Radius, Radius, Radius, 90, 90
                    GdipClosePathFigure mpath
                    GdipSetClipPath hGraphics, mpath, CombineModeIntersect
                End If
            End If

            GdipDrawImageRectRectI hGraphics, hImage1, X, Y, cx, cy, 0, 0, lPictureRealWidth, lPictureRealHeight, UnitPixel, 0, 0, 0

            If mpath Then
                GdipCreatePen1 RGBtoARGB(vbButtonFace, 100), 1 * DpiFactor, &H2, hPen
                GdipResetClip hGraphics
                GdipDrawPath hGraphics, hPen, mpath
                GdipDeletePen hPen
                GdipDeletePath mpath
            End If

            GdipDeleteGraphics hGraphics
            GdipDisposeImage hImage1
            LoadPictureEx = hImage2
        End If
    End Function

    Public Function ImageListDraw(ByVal lHdc As LongPtr, ByVal Index As Long, ByVal Left As Long, ByVal Top As Long, ByVal Width As Long, ByVal Height As Long, Optional ByVal PictureColor As Long = CLR_NONE, Optional ByVal Disabled As Boolean) As Boolean
        Dim tMatrixColor As COLORMATRIX, tMatrixGray As COLORMATRIX
        Dim hAttributes As LongPtr, hGraphics As LongPtr
        Dim hImage As LongPtr
        Dim R As Byte, G As Byte, B As Byte

        If Index < 1 Or Index > cImageList.Count Then Exit Function
        hImage = cImageList(Index)

        Call GdipCreateImageAttributes(hAttributes)

        With tMatrixColor
            If PictureColor <> CLR_NONE Then
                PictureColor = TranslateColor(PictureColor)

                B = ((PictureColor \ &H10000) And &HFF)
                G = ((PictureColor \ &H100) And &HFF)
                R = (PictureColor And &HFF)

                .M(0, 0) = R / 255
                .M(1, 0) = G / 255
                .M(2, 0) = B / 255
                .M(0, 4) = R / 255
                .M(1, 4) = G / 255
                .M(2, 4) = B / 255
            Else
                .M(0, 0) = 1
                .M(1, 1) = 1
                .M(2, 2) = 1
            End If
            .M(3, 3) = 1
            .M(4, 4) = 1

            If Disabled Then
                .M(0, 0) = 0.299
                .M(1, 0) = 0.299
                .M(2, 0) = 0.299
                .M(0, 1) = 0.587
                .M(1, 1) = 0.587
                .M(2, 1) = 0.587
                .M(0, 2) = 0.114
                .M(1, 2) = 0.114
                .M(2, 2) = 0.114
            End If
        End With

        GdipCreateFromHDC lHdc, hGraphics
        GdipSetImageAttributesColorMatrix hAttributes, &H0, 1, tMatrixColor, tMatrixGray, &H0
        ImageListDraw = GdipDrawImageRectRectI(hGraphics, hImage, Left, Top, Width, Height, 0, 0, Width, Height, UnitPixel, hAttributes) = 0&
        Call GdipDeleteGraphics(hGraphics)
        Call GdipDisposeImageAttributes(hAttributes)
    End Function

    Private Function LoadImageFromArray(ByRef bvData() As Byte, ByRef hImage As LongPtr) As Boolean
        Dim IStream As IUnknown
        Dim hMem As LongPtr, pMem As LongPtr
        Dim lSize As Long

        On Error Resume Next
        lSize = UBound(bvData) - LBound(bvData) + 1   'falla si el array no esta dimensionado
        If Err.Number <> 0 Then Exit Function
        On Error GoTo 0
        If lSize <= 0 Then Exit Function

        hMem = GlobalAlloc(GMEM_MOVEABLE, lSize)
        If hMem = 0 Then Exit Function
        pMem = GlobalLock(hMem)
        CopyMemory ByVal pMem, bvData(LBound(bvData)), lSize
        GlobalUnlock hMem

        If CreateStreamOnHGlobal(hMem, 1, IStream) = 0 Then   'el stream libera hMem
            If GdipLoadImageFromStream(IStream, hImage) = 0 Then
                LoadImageFromArray = True
            End If
        Else
            GlobalFree hMem
        End If
        Set IStream = Nothing
    End Function

    Private Function Base64Decode(ByVal sIn As String, ByRef bvOut() As Byte) As Boolean 'By Cocus
        Const CRYPT_STRING_BASE64 As Long = &H1
        Dim lLenOut As Long
        Call CryptStringToBinaryW(StrPtr(sIn), Len(sIn), CRYPT_STRING_BASE64, 0, lLenOut, 0, 0)
        If lLenOut = 0 Then Exit Function
        ReDim bvOut(lLenOut - 1)
        Call CryptStringToBinaryW(StrPtr(sIn), Len(sIn), CRYPT_STRING_BASE64, VarPtr(bvOut(0)), lLenOut, 0, 0)
        Base64Decode = True
    End Function

    Public Function RGBtoARGB(ByVal RGBColor As Long, ByVal Opacity As Long) As Long 'By LaVople
        If (RGBColor And &H80000000) Then RGBColor = GetSysColor(RGBColor And &HFF&)
        RGBtoARGB = (RGBColor And &HFF00&) Or (RGBColor And &HFF0000) \ &H10000 Or (RGBColor And &HFF) * &H10000
        Opacity = CByte((Abs(Opacity) / 100) * 255)
        If Opacity < 128 Then
            If Opacity < 0& Then Opacity = 0&
            RGBtoARGB = RGBtoARGB Or Opacity * &H1000000
        Else
            If Opacity > 255& Then Opacity = 255&
            RGBtoARGB = RGBtoARGB Or (Opacity - 128&) * &H1000000 Or &H80000000
        End If
    End Function

    Private Function TranslateColor(ByVal Color As Long) As Long
        If (Color And &H80000000) Then
            TranslateColor = GetSysColor(Color And &HFF&)
        Else
            TranslateColor = Color
        End If
    End Function

    'Funcion para combinar dos colores
    Private Function ShiftColor(ByVal clrFirst As Long, ByVal clrSecond As Long, ByVal lAlpha As Long) As Long
        Dim clrFore(3)         As Byte
        Dim clrBack(3)         As Byte

        clrFirst = TranslateColor(clrFirst)
        clrSecond = TranslateColor(clrSecond)

        CopyMemory clrFore(0), clrFirst, 4
        CopyMemory clrBack(0), clrSecond, 4

        clrFore(0) = (clrFore(0) * lAlpha + clrBack(0) * (255 - lAlpha)) / 255
        clrFore(1) = (clrFore(1) * lAlpha + clrBack(1) * (255 - lAlpha)) / 255
        clrFore(2) = (clrFore(2) * lAlpha + clrBack(2) * (255 - lAlpha)) / 255

        CopyMemory ShiftColor, clrFore(0), 4

    End Function

    Private Function IsDarkColor(ByVal Color As Long) As Boolean
        Dim BGRA(0 To 3) As Byte
        Color = TranslateColor(Color)
        CopyMemory BGRA(0), Color, 4&
        IsDarkColor = ((CLng(BGRA(0)) + (CLng(BGRA(1)) * 3) + CLng(BGRA(2))) / 2) < 382
    End Function

    Private Sub TextBox_SelStart(ByVal lhWnd As LongPtr, ByVal New_Value As Long)
        Call SendMessageW(lhWnd, EM_SETSEL, New_Value, New_Value)
    End Sub

    Private Function TextBox_SetText(ByVal lhWnd As LongPtr, ByVal sText As String) As LongPtr
        TextBox_SetText = SendMessageW(lhWnd, WM_SETTEXT, 0, StrPtr(sText))
    End Function

    Private Function TextBox_GetText(ByVal lhWnd As LongPtr) As String
        Dim sText As String
        Dim lLength As Long

        lLength = CLng(SendMessageW(lhWnd, WM_GETTEXTLENGTH, 0, 0))
        sText = Space$(lLength + 1)

        Call SendMessageW(lhWnd, WM_GETTEXT, lLength + 1, StrPtr(sText))
        TextBox_GetText = Left$(sText, lLength)
    End Function

    '======================================================================
    ' Subclasificacion (reemplaza a clsSubClass / WndProc)
    '======================================================================
    Private Sub EnsureSubclass()
        Dim h As LongPtr
        If m_hWndSubclassed <> 0 Then Exit Sub
        If Not Ambient.UserMode Then Exit Sub
        h = UserControl.hWnd
        If h = 0 Then Exit Sub
        If UCL_SubclassList(h, ObjPtr(Me), ObjPtr(Me)) Then
            m_hWndSubclassed = h
            m_TimerActive = 0
            Timer1_Apply
            Edit_Create
        End If
    End Sub

    Private Sub RemoveSubclasses()
        Edit_Destroy
        If m_hWndSubclassed <> 0 Then
            KillTimer m_hWndSubclassed, TIMER_MAIN
            KillTimer m_hWndSubclassed, TIMER_SCROLL
            m_TimerActive = 0
            UnRegisterHotsKeys
            UCL_UnsubclassList m_hWndSubclassed, ObjPtr(Me)
            m_hWndSubclassed = 0
        End If
        If m_SrcSubclassed <> 0 Then
            UCL_UnsubclassList m_SrcSubclassed, ObjPtr(Me) + 1
            m_SrcSubclassed = 0
        End If
    End Sub

    ' LOWORD de un WPARAM como Integer (con signo, sin desbordamiento)
    Private Function WordToInteger(ByVal Value As LongPtr) As Integer
        Dim w(1) As Integer
        CopyMemory w(0), Value, 4
        WordToInteger = w(0)
    End Function

    ' Signed HIWORD de un WPARAM (para WM_MOUSEWHEEL)
    Private Function HiWordSigned(ByVal Value As LongPtr) As Long
        Dim w(1) As Integer
        CopyMemory w(0), Value, 4
        HiWordSigned = w(1)
    End Function

    ' Llamado desde mUcListHelpers.UCL_ListProc
    Friend Function zzSubclassProc(ByVal lhWnd As LongPtr, ByVal uMsg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr, ByVal uIdSubclass As LongPtr) As LongPtr
        Dim KeyCode As Integer
        Dim bHandled As Boolean
        Dim lRet As LongPtr
        Dim sBefore As String
        Dim PT As POINTAPI

        On Error Resume Next

        If lhWnd = m_hEdit And m_hEdit <> 0 Then
            lRet = Edit_WndProc(lhWnd, uMsg, wParam, lParam, bHandled)
            If bHandled Then
                zzSubclassProc = lRet
                Exit Function
            End If

        ElseIf lhWnd = m_hWndSubclassed And m_hWndSubclassed <> 0 Then
            Select Case uMsg
                Case WM_COMMAND, WM_CTLCOLOREDIT
                    lRet = Edit_ParentMsg(uMsg, wParam, lParam, bHandled)
                    If bHandled Then
                        zzSubclassProc = lRet
                        Exit Function
                    End If

                Case WM_TIMER
                    Select Case CLng(wParam)
                        Case TIMER_MAIN
                            Timer1_Timer
                            Exit Function
                        Case TIMER_SCROLL
                            SB_RepeatTick
                            Exit Function
                    End Select

                Case WM_HOTKEY
                    If bShow Then
                        KeyCode = CInt(wParam)
                        Text1_KeyDown KeyCode, 0
                        Exit Function   'bHandled = True
                    End If

                Case WM_MOUSELEAVE
                    ' Solo si el cursor salio de verdad de la ventana (en twinBASIC
                    ' puede llegar un WM_MOUSELEAVE con el cursor dentro).
                    GetCursorPos PT
                    If bShow And Not PointInWindow(lhWnd, PT) Then
                        m_HotItem = -1
                        bHideSubMenu = False
                        bShowSubMenu = False
                        SB.HotPart = sbpNone
                        Draw
                    End If

                Case WM_MOUSEWHEEL
                    If SB.Visible And SB.WheelEnabled Then
                        SB_MouseWheel HiWordSigned(wParam)
                        Exit Function
                    End If

                Case WM_IME_SETCONTEXT
                    ' Solo al PERDER la activacion (wParam = 0), p. ej. Alt+Tab. En
                    ' twinBASIC el propio clic sobre la lista le da el foco y genera
                    ' WM_IME_SETCONTEXT(TRUE); en VB6 la lista ya tenia el foco y el
                    ' original la cerraba con cualquier WM_IME_SETCONTEXT.
                    If bShow And wParam = 0 Then
                        If m_ListStyle = StyleDropDown Then HideList
                    End If

                Case WM_NCDESTROY
                    zzSubclassProc = UCL_DefProc(lhWnd, uMsg, wParam, lParam)
                    m_hEdit = 0   'el EDIT hijo ya fue destruido junto con el control
                    KillTimer lhWnd, TIMER_MAIN
                    KillTimer lhWnd, TIMER_SCROLL
                    m_TimerActive = 0
                    UCL_UnsubclassList lhWnd, ObjPtr(Me)
                    m_hWndSubclassed = 0
                    Exit Function
            End Select

        ElseIf lhWnd = m_SrcSubclassed And m_SrcSubclassed <> 0 Then
            Select Case uMsg
                Case WM_CHAR
                    ' En twinBASIC el TextBox recibe tambien el WM_CHAR del Tab (9), Esc,
                    ' Ctrl+tecla... (en VB6 el formulario se los quedaba). Si se tratara
                    ' como un cambio, con la lista cerrada se buscaba de nuevo el texto
                    ' recien elegido y la lista se abria otra vez en ESTE TextBox (el
                    ' anterior) justo antes de que el foco pasara al siguiente.
                    ' Por eso solo se procesa si el texto cambio de verdad.
                    ' Ademas se ignoran los caracteres de control (salvo Backspace) y los
                    ' mensajes que llegan cuando este TextBox ya no tiene el foco.
                    sBefore = TextBox_GetText(lhWnd)
                    zzSubclassProc = UCL_DefProc(lhWnd, uMsg, wParam, lParam)   'MSG_AFTER
                    If (CLng(wParam) >= 32 Or CLng(wParam) = vbKeyBack) And GetFocus() = lhWnd Then
                        If TextBox_GetText(lhWnd) <> sBefore Then SrcTextBox_Change
                    End If
                    Exit Function

                Case WM_NCDESTROY
                    zzSubclassProc = UCL_DefProc(lhWnd, uMsg, wParam, lParam)
                    UCL_UnsubclassList lhWnd, ObjPtr(Me) + 1
                    m_SrcSubclassed = 0
                    SrcTextBox = 0
                    Exit Function
            End Select
        End If

        zzSubclassProc = UCL_DefProc(lhWnd, uMsg, wParam, lParam)
    End Function

End Class
