    '======================================================================
    ' Tipos
    '======================================================================
    Private Type RECT
        Left    As Long
        Top     As Long
        Right   As Long
        Bottom  As Long
    End Type

    Private Type POINTAPI
        X As Long
        Y As Long
    End Type

    Private Type SIZEAPI
        cx As Long
        cy As Long
    End Type

    Private Type GPRECT
        X       As Long
        Y       As Long
        Width   As Long
        Height  As Long
    End Type

    Private Type PAINTSTRUCT
        hDC         As LongPtr
        fErase      As Long
        rcPaint     As RECT
        fRestore    As Long
        fIncUpdate  As Long
        rgbReserved(31) As Byte
    End Type

    Private Type TRACKMOUSEEVENTSTRUCT
        cbSize      As Long
        dwFlags     As Long
        hwndTrack   As LongPtr
        dwHoverTime As Long
    End Type

    Private Type MONITORINFO
        cbSize      As Long
        rcMonitor   As RECT
        rcWork      As RECT
        dwFlags     As Long
    End Type

    Private Type LOGFONTW
        lfHeight         As Long
        lfWidth          As Long
        lfEscapement     As Long
        lfOrientation    As Long
        lfWeight         As Long
        lfItalic         As Byte
        lfUnderline      As Byte
        lfStrikeOut      As Byte
        lfCharSet        As Byte
        lfOutPrecision   As Byte
        lfClipPrecision  As Byte
        lfQuality        As Byte
        lfPitchAndFamily As Byte
        lfFaceName(0 To 63) As Byte
    End Type

    Private Type COLORMATRIX
        M(0 To 4, 0 To 4) As Single
    End Type

    Private Type tItem
        Text            As String
        SubText         As String
        Icon            As Long
        Data            As Variant
        Separator       As Boolean
        Checked         As Boolean
        IsChild         As Boolean
        IsGroup         As Boolean
        Disabled        As Boolean
        Visible         As Boolean
        SubMenu         As ucList
        TextColor       As Long
        SubTextColor    As Long
        BackColor       As Long
        ItemBold        As Boolean
    End Type

    '======================================================================
    ' Enumeraciones publicas (iguales al original)
    '======================================================================
    Public Enum eListDesign
        GoogleDesign
        MicrosoftDesign
    End Enum

    Public Enum eListStyle
        StyleDropDown
        StyleListBox
        StyleMenu
    End Enum

    Public Enum eSortOrder
        SortAscendant
        SortDescendant
    End Enum

    Public Enum ListPlusOLEDropModeConstants
        OLEDropModeNone = 0
        OLEDropModeManual = 1
    End Enum

    '======================================================================
    ' Eventos (iguales al original; los hDC son LongPtr por 64 bits)
    '======================================================================
    Public Event IndexChange()
    Public Event ItemClick()
    Public Event HideList()
    Public Event ScrollBottom()
    Public Event PostAutoComplete()
    Public Event DblClick()
    Public Event MouseDown(Button As Integer, Shift As Integer, X As Single, Y As Single)
    Public Event MouseMove(Button As Integer, Shift As Integer, X As Single, Y As Single)
    Public Event MouseUp(Button As Integer, Shift As Integer, X As Single, Y As Single)
    Public Event PostPaint(ByVal hdc As LongPtr)
    Public Event ItemCustomDraw(Index As Long, ByVal hdc As LongPtr, Left As Long, Top As Long, Width As Long, Height As Long)
    Public Event KeyPress(KeyAscii As Integer)
    Public Event KeyUp(KeyCode As Integer, Shift As Integer)
    Public Event KeyDown(KeyCode As Integer, Shift As Integer)
    Public Event OLECompleteDrag(Effect As Long)
    Public Event OLEDragDrop(Data As DataObject, Effect As Long, Button As Integer, Shift As Integer, X As Single, Y As Single)
    Public Event OLEDragOver(Data As DataObject, Effect As Long, Button As Integer, Shift As Integer, X As Single, Y As Single, State As Integer)
    Public Event OLEGiveFeedback(Effect As Long, DefaultCursors As Boolean)
    Public Event OLESetData(Data As DataObject, DataFormat As Integer)
    Public Event OLEStartDrag(Data As DataObject, AllowedEffects As Long)

