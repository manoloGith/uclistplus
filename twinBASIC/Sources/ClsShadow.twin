[Description("Sombra y borde redondeado alrededor de una ventana")]
Class ClsShadow

    '==========================================================================
    ' ClsShadow (twinBASIC, 32/64 bits) - reescrito desde cero.
    ' Misma interfaz publica que el ClsShadow de ucListPlus (Leandro Ascierto).
    '
    ' ShowBorders hWnd, isWinChild
    '  - isWinChild = False (ventana de nivel superior / popup): ventana capa
    '    (WS_EX_LAYERED) con alfa por pixel, transparente al raton, colocada
    '    justo debajo de la ventana destino.
    '  - isWinChild = True (control dentro de un formulario): ventana hija del
    '    mismo padre, debajo del control en el orden Z, con una region que
    '    excluye al control (nunca pinta encima de el) y transparente al raton.
    ' La sombra sigue a la ventana destino (WM_WINDOWPOSCHANGED): se mueve,
    ' cambia de tamano, se oculta y se muestra con ella. Solo vuelve a
    ' aparecer si se llamo a ShowBorders y no a HideBorders.
    '==========================================================================

    Option Explicit

    Private Declare PtrSafe Function CreateWindowExW Lib "user32" (ByVal dwExStyle As Long, ByVal lpClassName As LongPtr, ByVal lpWindowName As LongPtr, ByVal dwStyle As Long, ByVal X As Long, ByVal Y As Long, ByVal nWidth As Long, ByVal nHeight As Long, ByVal hWndParent As LongPtr, ByVal hMenu As LongPtr, ByVal hInstance As LongPtr, ByVal lpParam As LongPtr) As LongPtr
    Private Declare PtrSafe Function DestroyWindow Lib "user32" (ByVal hWnd As LongPtr) As Long
    Private Declare PtrSafe Function IsWindow Lib "user32" (ByVal hWnd As LongPtr) As Long
    Private Declare PtrSafe Function IsWindowVisible Lib "user32" (ByVal hWnd As LongPtr) As Long
    Private Declare PtrSafe Function ShowWindow Lib "user32" (ByVal hWnd As LongPtr, ByVal nCmdShow As Long) As Long
    Private Declare PtrSafe Function SetWindowPos Lib "user32" (ByVal hWnd As LongPtr, ByVal hWndInsertAfter As LongPtr, ByVal X As Long, ByVal Y As Long, ByVal cx As Long, ByVal cy As Long, ByVal wFlags As Long) As Long
    Private Declare PtrSafe Function GetWindowRect Lib "user32" (ByVal hWnd As LongPtr, ByRef lpRect As RECT) As Long
    Private Declare PtrSafe Function GetParent Lib "user32" (ByVal hWnd As LongPtr) As LongPtr
    Private Declare PtrSafe Function GetWindow Lib "user32" (ByVal hWnd As LongPtr, ByVal uCmd As Long) As LongPtr
    Private Declare PtrSafe Function MapWindowPoints Lib "user32" (ByVal hWndFrom As LongPtr, ByVal hWndTo As LongPtr, ByRef lppt As RECT, ByVal cPoints As Long) As Long
    #If Win64 Then
    Private Declare PtrSafe Function GetWindowLongPtrW Lib "user32" (ByVal hWnd As LongPtr, ByVal nIndex As Long) As LongPtr
    #Else
    Private Declare PtrSafe Function GetWindowLongPtrW Lib "user32" Alias "GetWindowLongW" (ByVal hWnd As LongPtr, ByVal nIndex As Long) As LongPtr
    #End If
    Private Declare PtrSafe Function GetWindowRgn Lib "user32" (ByVal hWnd As LongPtr, ByVal hRgn As LongPtr) As Long
    Private Declare PtrSafe Function SetWindowRgn Lib "user32" (ByVal hWnd As LongPtr, ByVal hRgn As LongPtr, ByVal bRedraw As Long) As Long
    Private Declare PtrSafe Function InvalidateRect Lib "user32" (ByVal hWnd As LongPtr, ByVal lpRect As LongPtr, ByVal bErase As Long) As Long
    Private Declare PtrSafe Function UpdateLayeredWindow Lib "user32" (ByVal hWnd As LongPtr, ByVal hdcDst As LongPtr, ByRef pptDst As POINTAPI, ByRef psize As SIZEAPI, ByVal hdcSrc As LongPtr, ByRef pptSrc As POINTAPI, ByVal crKey As Long, ByRef pblend As BLENDFUNCTION, ByVal dwFlags As Long) As Long
    Private Declare PtrSafe Function BeginPaint Lib "user32" (ByVal hWnd As LongPtr, ByRef lpPaint As PAINTSTRUCT) As LongPtr
    Private Declare PtrSafe Function EndPaint Lib "user32" (ByVal hWnd As LongPtr, ByRef lpPaint As PAINTSTRUCT) As Long
    Private Declare PtrSafe Function GetDC Lib "user32" (ByVal hWnd As LongPtr) As LongPtr
    Private Declare PtrSafe Function ReleaseDC Lib "user32" (ByVal hWnd As LongPtr, ByVal hDC As LongPtr) As Long
    Private Declare PtrSafe Function GetSysColor Lib "user32" (ByVal nIndex As Long) As Long
    Private Declare PtrSafe Function FillRect Lib "user32" (ByVal hDC As LongPtr, ByRef lpRect As RECT, ByVal hBrush As LongPtr) As Long
    Private Declare PtrSafe Function CreateSolidBrush Lib "gdi32" (ByVal crColor As Long) As LongPtr
    Private Declare PtrSafe Function CreateCompatibleDC Lib "gdi32" (ByVal hDC As LongPtr) As LongPtr
    Private Declare PtrSafe Function CreateDIBSection Lib "gdi32" (ByVal hDC As LongPtr, ByRef pbmi As BITMAPINFOHEADER, ByVal iUsage As Long, ByRef ppvBits As LongPtr, ByVal hSection As LongPtr, ByVal dwOffset As Long) As LongPtr
    Private Declare PtrSafe Function SelectObject Lib "gdi32" (ByVal hDC As LongPtr, ByVal hObject As LongPtr) As LongPtr
    Private Declare PtrSafe Function DeleteObject Lib "gdi32" (ByVal hObject As LongPtr) As Long
    Private Declare PtrSafe Function DeleteDC Lib "gdi32" (ByVal hDC As LongPtr) As Long
    Private Declare PtrSafe Function BitBlt Lib "gdi32" (ByVal hDestDC As LongPtr, ByVal X As Long, ByVal Y As Long, ByVal nWidth As Long, ByVal nHeight As Long, ByVal hSrcDC As LongPtr, ByVal xSrc As Long, ByVal ySrc As Long, ByVal dwRop As Long) As Long
    Private Declare PtrSafe Function GetDeviceCaps Lib "gdi32" (ByVal hDC As LongPtr, ByVal nIndex As Long) As Long
    Private Declare PtrSafe Function GetBkColor Lib "gdi32" (ByVal hDC As LongPtr) As Long
    Private Declare PtrSafe Function CreateRectRgn Lib "gdi32" (ByVal X1 As Long, ByVal Y1 As Long, ByVal X2 As Long, ByVal Y2 As Long) As LongPtr
    Private Declare PtrSafe Function CombineRgn Lib "gdi32" (ByVal hrgnDst As LongPtr, ByVal hrgnSrc1 As LongPtr, ByVal hrgnSrc2 As LongPtr, ByVal iMode As Long) As Long
    Private Declare PtrSafe Function OffsetRgn Lib "gdi32" (ByVal hRgn As LongPtr, ByVal X As Long, ByVal Y As Long) As Long
    Private Declare PtrSafe Function DrawThemeParentBackground Lib "uxtheme" (ByVal hWnd As LongPtr, ByVal hDC As LongPtr, ByVal prc As LongPtr) As Long
    Private Declare PtrSafe Function GdipCreateFromHDC Lib "gdiplus" (ByVal hDC As LongPtr, ByRef graphics As LongPtr) As Long
    Private Declare PtrSafe Function GdipDeleteGraphics Lib "gdiplus" (ByVal graphics As LongPtr) As Long
    Private Declare PtrSafe Function GdipSetSmoothingMode Lib "gdiplus" (ByVal graphics As LongPtr, ByVal SmoothingMode As Long) As Long
    Private Declare PtrSafe Function GdipCreatePath Lib "gdiplus" (ByVal brushMode As Long, ByRef path As LongPtr) As Long
    Private Declare PtrSafe Function GdipDeletePath Lib "gdiplus" (ByVal path As LongPtr) As Long
    Private Declare PtrSafe Function GdipAddPathArcI Lib "gdiplus" (ByVal path As LongPtr, ByVal X As Long, ByVal Y As Long, ByVal Width As Long, ByVal Height As Long, ByVal startAngle As Single, ByVal sweepAngle As Single) As Long
    Private Declare PtrSafe Function GdipAddPathRectangleI Lib "gdiplus" (ByVal path As LongPtr, ByVal X As Long, ByVal Y As Long, ByVal Width As Long, ByVal Height As Long) As Long
    Private Declare PtrSafe Function GdipClosePathFigure Lib "gdiplus" (ByVal path As LongPtr) As Long
    Private Declare PtrSafe Function GdipCreateSolidFill Lib "gdiplus" (ByVal argb As Long, ByRef brush As LongPtr) As Long
    Private Declare PtrSafe Function GdipDeleteBrush Lib "gdiplus" (ByVal brush As LongPtr) As Long
    Private Declare PtrSafe Function GdipFillPath Lib "gdiplus" (ByVal graphics As LongPtr, ByVal brush As LongPtr, ByVal path As LongPtr) As Long
    Private Declare PtrSafe Function GdipCreatePen1 Lib "gdiplus" (ByVal argb As Long, ByVal Width As Single, ByVal unit As Long, ByRef pen As LongPtr) As Long
    Private Declare PtrSafe Function GdipDeletePen Lib "gdiplus" (ByVal pen As LongPtr) As Long
    Private Declare PtrSafe Function GdipDrawPath Lib "gdiplus" (ByVal graphics As LongPtr, ByVal pen As LongPtr, ByVal path As LongPtr) As Long
    Private Declare PtrSafe Function GdipSetClipPath Lib "gdiplus" (ByVal graphics As LongPtr, ByVal path As LongPtr, ByVal combineMode As Long) As Long
    Private Declare PtrSafe Function GdipSetClipHrgn Lib "gdiplus" (ByVal graphics As LongPtr, ByVal hRgn As LongPtr, ByVal combineMode As Long) As Long
    Private Declare PtrSafe Function GdipResetClip Lib "gdiplus" (ByVal graphics As LongPtr) As Long
    Private Declare PtrSafe Function GdipCreateBitmapFromHBITMAP Lib "gdiplus" (ByVal hbm As LongPtr, ByVal hpal As LongPtr, ByRef bitmap As LongPtr) As Long
    Private Declare PtrSafe Function GdipDrawImageRectRectI Lib "gdiplus" (ByVal graphics As LongPtr, ByVal image As LongPtr, ByVal dstx As Long, ByVal dsty As Long, ByVal dstwidth As Long, ByVal dstheight As Long, ByVal srcx As Long, ByVal srcy As Long, ByVal srcwidth As Long, ByVal srcheight As Long, ByVal srcUnit As Long, ByVal imageAttributes As LongPtr, ByVal callback As LongPtr, ByVal callbackData As LongPtr) As Long
    Private Declare PtrSafe Function GdipDisposeImage Lib "gdiplus" (ByVal image As LongPtr) As Long
    Private Declare PtrSafe Sub CopyMemoryAny Lib "kernel32" Alias "RtlMoveMemory" (ByRef Destination As Any, ByVal Source As LongPtr, ByVal Length As LongPtr)

    Private Type RECT
        Left    As Long
        Top     As Long
        Right   As Long
        Bottom  As Long
    End Type

    Private Type POINTAPI
        X As Long
        Y As Long
    End Type

    Private Type SIZEAPI
        cx As Long
        cy As Long
    End Type

    Private Type BLENDFUNCTION
        BlendOp             As Byte
        BlendFlags          As Byte
        SourceConstantAlpha As Byte
        AlphaFormat         As Byte
    End Type

    Private Type BITMAPINFOHEADER
        biSize          As Long
        biWidth         As Long
        biHeight        As Long
        biPlanes        As Integer
        biBitCount      As Integer
        biCompression   As Long
        biSizeImage     As Long
        biXPelsPerMeter As Long
        biYPelsPerMeter As Long
        biClrUsed       As Long
        biClrImportant  As Long
    End Type

    Private Type PAINTSTRUCT
        hDC         As LongPtr
        fErase      As Long
        rcPaint     As RECT
        fRestore    As Long
        fIncUpdate  As Long
        rgbReserved(31) As Byte
    End Type

    Private Const WS_POPUP          As Long = &H80000000
    Private Const WS_CHILD          As Long = &H40000000
    Private Const WS_CLIPSIBLINGS   As Long = &H4000000
    Private Const WS_EX_LAYERED     As Long = &H80000
    Private Const WS_EX_TRANSPARENT As Long = &H20&
    Private Const WS_EX_TOOLWINDOW  As Long = &H80&
    Private Const WS_EX_NOACTIVATE  As Long = &H8000000
    Private Const WS_EX_TOPMOST     As Long = &H8&
    Private Const GWL_EXSTYLE       As Long = -20
    Private Const GW_OWNER          As Long = 4
    Private Const SW_HIDE           As Long = 0
    Private Const SWP_NOSIZE        As Long = &H1
    Private Const SWP_NOMOVE        As Long = &H2
    Private Const SWP_NOZORDER      As Long = &H4
    Private Const SWP_NOACTIVATE    As Long = &H10
    Private Const SWP_SHOWWINDOW    As Long = &H40
    Private Const SWP_HIDEWINDOW    As Long = &H80
    Private Const HWND_TOPMOST      As LongPtr = -1
    Private Const WM_DESTROY        As Long = &H2
    Private Const WM_PAINT          As Long = &HF
    Private Const WM_ERASEBKGND     As Long = &H14
    Private Const WM_NCHITTEST      As Long = &H84
    Private Const WM_MOUSEACTIVATE  As Long = &H21
    Private Const WM_WINDOWPOSCHANGED As Long = &H47
    Private Const WM_NCDESTROY      As Long = &H82
    Private Const HTTRANSPARENT     As Long = -1
    Private Const MA_NOACTIVATE     As Long = 3
    Private Const ULW_ALPHA         As Long = &H2
    Private Const AC_SRC_ALPHA      As Long = &H1
    Private Const RGN_DIFF          As Long = 4
    Private Const ERROR_RGN         As Long = 0
    Private Const LOGPIXELSX        As Long = 88
    Private Const CLR_NONE          As Long = &HFFFFFFFF
    Private Const SmoothingModeAntiAlias As Long = 4
    Private Const CombineModeExclude As Long = 4
    Private Const CombineModeIntersect As Long = 1
    Private Const UnitPixel         As Long = 2

    ' Propiedades
    Private m_Margin            As Integer
    Private m_BackColor         As OLE_COLOR
    Private m_BackColorOpacity  As Integer
    Private m_BorderColor       As OLE_COLOR
    Private m_BorderOpacity     As Integer
    Private m_BorderWidth       As Integer
    Private m_ShadowColor       As OLE_COLOR
    Private m_ShadowOpacity     As Integer
    Private m_ShadowSize        As Integer
    Private m_ShadowOffsetX     As Integer
    Private m_ShadowOffsetY     As Integer
    Private m_BorderRadius      As Long
    Private m_ContainerBkColor  As Long

    ' Estado
    Private m_hTarget       As LongPtr  'ventana a la que se pone sombra
    Private m_hShadow       As LongPtr  'ventana de la sombra
    Private m_bChild        As Boolean
    Private m_bShown        As Boolean  'ShowBorders llamado (y no HideBorders)
    Private m_bInPos        As Boolean  'evita reentradas al recolocar
    Private m_Dpi           As Single
    Private m_rcShadow      As RECT     'posicion de la sombra (pantalla o cliente del padre)
    Private m_dx            As Long     'origen de la ventana destino dentro de la sombra
    Private m_dy            As Long
    Private m_tW            As Long     'tamano de la ventana destino
    Private m_tH            As Long

    '==========================================================================
    ' Propiedades publicas
    '==========================================================================
    Public Property Let ContainerBkColor(ByVal new_value As Long)
        m_ContainerBkColor = new_value
    End Property

    Public Property Get hWnd() As LongPtr
        hWnd = m_hShadow
    End Property

    Public Property Get Margin() As Integer
        Margin = m_Margin
    End Property

    Public Property Let Margin(ByVal new_value As Integer)
        m_Margin = new_value
    End Property

    Public Property Get BackColor() As OLE_COLOR
        BackColor = m_BackColor
    End Property

    Public Property Let BackColor(ByVal new_value As OLE_COLOR)
        m_BackColor = new_value
    End Property

    Public Property Get BackColorOpacity() As Integer
        BackColorOpacity = m_BackColorOpacity
    End Property

    Public Property Let BackColorOpacity(ByVal new_value As Integer)
        m_BackColorOpacity = new_value
    End Property

    Public Property Get BorderColor() As OLE_COLOR
        BorderColor = m_BorderColor
    End Property

    Public Property Let BorderColor(ByVal new_value As OLE_COLOR)
        m_BorderColor = new_value
    End Property

    Public Property Get BorderOpacity() As Integer
        BorderOpacity = m_BorderOpacity
    End Property

    Public Property Let BorderOpacity(ByVal new_value As Integer)
        m_BorderOpacity = new_value
    End Property

    Public Property Get ShadowColor() As OLE_COLOR
        ShadowColor = m_ShadowColor
    End Property

    Public Property Let ShadowColor(ByVal new_value As OLE_COLOR)
        m_ShadowColor = new_value
    End Property

    Public Property Get ShadowOpacity() As Integer
        ShadowOpacity = m_ShadowOpacity
    End Property

    Public Property Let ShadowOpacity(ByVal new_value As Integer)
        m_ShadowOpacity = new_value
    End Property

    Public Property Get BorderWidth() As Integer
        BorderWidth = m_BorderWidth
    End Property

    Public Property Let BorderWidth(ByVal new_value As Integer)
        m_BorderWidth = new_value
    End Property

    Public Property Get ShadowSize() As Integer
        ShadowSize = m_ShadowSize
    End Property

    Public Property Let ShadowSize(ByVal new_value As Integer)
        m_ShadowSize = new_value
    End Property

    Public Property Get ShadowOffsetX() As Integer
        ShadowOffsetX = m_ShadowOffsetX
    End Property

    Public Property Let ShadowOffsetX(ByVal new_value As Integer)
        m_ShadowOffsetX = new_value
    End Property

    Public Property Get ShadowOffsetY() As Integer
        ShadowOffsetY = m_ShadowOffsetY
    End Property

    Public Property Let ShadowOffsetY(ByVal new_value As Integer)
        m_ShadowOffsetY = new_value
    End Property

    Public Property Get BorderRadius() As Long
        BorderRadius = m_BorderRadius
    End Property

    Public Property Let BorderRadius(ByVal new_value As Long)
        m_BorderRadius = new_value
    End Property

    '==========================================================================
    ' Metodos publicos
    '==========================================================================

    ' Muestra (o reposiciona y redibuja) la sombra de hWnd.
    Public Sub ShowBorders(ByVal hWnd As LongPtr, ByVal isWinChild As Boolean)
        If hWnd = 0 Then Exit Sub
        If IsWindow(hWnd) = 0 Then Exit Sub
        If hWnd <> m_hTarget Or isWinChild <> m_bChild Or m_hShadow = 0 Then
            Detach
            If Not Attach(hWnd, isWinChild) Then Exit Sub
        End If
        m_bShown = True
        Reposition True
    End Sub

    Public Sub HideBorders()
        m_bShown = False
        If m_hShadow <> 0 Then ShowWindow m_hShadow, SW_HIDE
    End Sub

    ' Vuelve a calcular y dibujar la sombra. No la muestra si esta oculta.
    Public Sub Refresh()
        If m_bShown And m_hTarget <> 0 Then Reposition True
    End Sub

    ' Redibuja el contenido de la sombra en su posicion actual.
    Public Sub Update()
        If m_hShadow = 0 Then Exit Sub
        If m_bChild Then
            InvalidateRect m_hShadow, 0, 0
        Else
            RenderLayered 0, 0, 0, 0
        End If
    End Sub

    ' Pinta hBmp (de Width x Height) en el hueco de la ventana destino. Solo tiene
    ' efecto con sombras de ventanas de nivel superior (isWinChild = False).
    Public Sub DrawBitmap(ByVal hBmp As LongPtr, ByVal hWnd As LongPtr, ByVal Width As Long, ByVal Height As Long)
        If m_hShadow = 0 Or m_bChild Then Exit Sub
        If hWnd <> m_hTarget Then Exit Sub
        RenderLayered hBmp, Width, Height, 1
    End Sub

    Public Function GetWindowsDPI() As Double
        Dim hDC As LongPtr, lpx As Long
        hDC = GetDC(0)
        lpx = GetDeviceCaps(hDC, LOGPIXELSX)
        ReleaseDC 0, hDC
        If lpx = 0 Then
            GetWindowsDPI = 1#
        Else
            GetWindowsDPI = lpx / 96#
        End If
    End Function

    '==========================================================================
    ' Ciclo de vida
    '==========================================================================
    Private Sub Class_Initialize()
        UCL_GdipStart
        m_Dpi = GetWindowsDPI
        m_BorderColor = vbActiveBorder
        m_BackColor = vbWindowBackground
        m_BorderWidth = 1
        m_BorderRadius = 10
        m_ShadowOpacity = 8
        m_BackColorOpacity = 100
        m_BorderOpacity = 100
        m_ShadowSize = 3
        m_ContainerBkColor = CLR_NONE
    End Sub

    Private Sub Class_Terminate()
        Detach
        UCL_GdipStop
    End Sub

    Private Function Attach(ByVal hWnd As LongPtr, ByVal isWinChild As Boolean) As Boolean
        Dim sClass As String
        Dim hOwner As LongPtr, lEx As Long
        If Not UCL_RegisterClass(App.hInstance) Then Exit Function
        sClass = UCL_CLASSNAME
        m_hTarget = hWnd
        m_bChild = isWinChild
        If isWinChild Then
            m_hShadow = CreateWindowExW(0, StrPtr(sClass), 0, WS_CHILD Or WS_CLIPSIBLINGS, 0, 0, 0, 0, GetParent(hWnd), 0, App.hInstance, 0)
        Else
            hOwner = GetWindow(hWnd, GW_OWNER)
            lEx = WS_EX_LAYERED Or WS_EX_TRANSPARENT Or WS_EX_TOOLWINDOW Or WS_EX_NOACTIVATE
            If (CLng(GetWindowLongPtrW(hWnd, GWL_EXSTYLE)) And WS_EX_TOPMOST) <> 0 Then lEx = lEx Or WS_EX_TOPMOST
            m_hShadow = CreateWindowExW(lEx, StrPtr(sClass), 0, WS_POPUP, 0, 0, 0, 0, hOwner, 0, App.hInstance, 0)
        End If
        If m_hShadow = 0 Then
            m_hTarget = 0
            Exit Function
        End If
        UCL_SubclassShadow m_hShadow, ObjPtr(Me)
        UCL_SubclassShadow m_hTarget, ObjPtr(Me)
        Attach = True
    End Function

    Private Sub Detach()
        If m_hTarget <> 0 Then UCL_UnsubclassShadow m_hTarget, ObjPtr(Me)
        If m_hShadow <> 0 Then
            UCL_UnsubclassShadow m_hShadow, ObjPtr(Me)
            DestroyWindow m_hShadow
        End If
        m_hTarget = 0
        m_hShadow = 0
        m_bShown = False
    End Sub

    '==========================================================================
    ' Posicion y dibujo
    '==========================================================================
    Private Function Px(ByVal v As Double) As Long
        Px = CLng(v * m_Dpi)
    End Function

    ' Calcula la posicion de la sombra a partir de la ventana destino, la coloca
    ' debajo de ella y la redibuja. bShow: mostrarla si el destino es visible.
    Private Sub Reposition(ByVal bShow As Boolean)
        Dim rt As RECT, rs As RECT
        Dim TM As Long, ox As Long, oy As Long
        Dim lFlags As Long
        Dim bSized As Boolean

        If m_hShadow = 0 Or m_hTarget = 0 Then Exit Sub
        If m_bInPos Then Exit Sub
        m_bInPos = True

        GetWindowRect m_hTarget, rt
        If m_bChild Then MapWindowPoints 0, GetParent(m_hTarget), rt, 2

        TM = Px(m_ShadowSize * 2 + m_BorderWidth + m_Margin)
        ox = Px(m_ShadowOffsetX)
        oy = Px(m_ShadowOffsetY)

        rs.Left = rt.Left - TM
        rs.Top = rt.Top - TM
        If ox < 0 Then rs.Left = rs.Left + ox
        If oy < 0 Then rs.Top = rs.Top + oy
        rs.Right = rt.Right + TM
        rs.Bottom = rt.Bottom + TM
        If ox > 0 Then rs.Right = rs.Right + ox
        If oy > 0 Then rs.Bottom = rs.Bottom + oy

        bSized = (rs.Right - rs.Left <> m_rcShadow.Right - m_rcShadow.Left) Or (rs.Bottom - rs.Top <> m_rcShadow.Bottom - m_rcShadow.Top)
        m_rcShadow = rs
        m_dx = rt.Left - rs.Left
        m_dy = rt.Top - rs.Top
        m_tW = rt.Right - rt.Left
        m_tH = rt.Bottom - rt.Top

        lFlags = SWP_NOACTIVATE
        If bShow And m_bShown And IsWindowVisible(m_hTarget) <> 0 Then lFlags = lFlags Or SWP_SHOWWINDOW

        If m_bChild Then
            ApplyChildRegion
            SetWindowPos m_hShadow, m_hTarget, rs.Left, rs.Top, rs.Right - rs.Left, rs.Bottom - rs.Top, lFlags
            InvalidateRect m_hShadow, 0, 0
        Else
            If (CLng(GetWindowLongPtrW(m_hTarget, GWL_EXSTYLE)) And WS_EX_TOPMOST) <> 0 Then
                SetWindowPos m_hShadow, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOMOVE Or SWP_NOSIZE Or SWP_NOACTIVATE
            End If
            RenderLayered 0, 0, 0, 0
            SetWindowPos m_hShadow, m_hTarget, rs.Left, rs.Top, rs.Right - rs.Left, rs.Bottom - rs.Top, lFlags
        End If
        m_bInPos = False
    End Sub

    ' Region de la sombra hija: todo menos la ventana destino (asi nunca la tapa).
    Private Sub ApplyChildRegion()
        Dim hRgn As LongPtr, hHole As LongPtr
        hRgn = CreateRectRgn(0, 0, m_rcShadow.Right - m_rcShadow.Left, m_rcShadow.Bottom - m_rcShadow.Top)
        hHole = TargetRegion()
        CombineRgn hRgn, hRgn, hHole, RGN_DIFF
        DeleteObject hHole
        SetWindowRgn m_hShadow, hRgn, 1     'el sistema pasa a ser propietario de hRgn
    End Sub

    ' Region de la ventana destino en coordenadas de la sombra.
    Private Function TargetRegion() As LongPtr
        Dim hRgn As LongPtr
        hRgn = CreateRectRgn(0, 0, m_tW, m_tH)
        If GetWindowRgn(m_hTarget, hRgn) = ERROR_RGN Then
            DeleteObject hRgn
            hRgn = CreateRectRgn(0, 0, m_tW, m_tH)
        End If
        OffsetRgn hRgn, m_dx, m_dy
        TargetRegion = hRgn
    End Function

    Private Function ARGB(ByVal Color As Long, ByVal Opacity As Long) As Long
        Dim a As Long
        If (Color And &H80000000) <> 0 Then Color = GetSysColor(Color And &HFF&)
        If Opacity < 0 Then Opacity = 0
        If Opacity > 100 Then Opacity = 100
        a = (Opacity * 255) \ 100
        ARGB = (Color And &HFF00&) Or ((Color And &HFF&) * &H10000) Or ((Color And &HFF0000) \ &H10000)
        If a > 127 Then
            ARGB = ARGB Or ((a - 128) * &H1000000) Or &H80000000
        Else
            ARGB = ARGB Or (a * &H1000000)
        End If
    End Function

    Private Function RoundPath(ByVal X As Long, ByVal Y As Long, ByVal W As Long, ByVal H As Long, ByVal D As Long) As LongPtr
        Dim p As LongPtr
        If W < 1 Then W = 1
        If H < 1 Then H = 1
        If D * 2 > W Then D = W \ 2
        If D * 2 > H Then D = H \ 2
        If GdipCreatePath(0, p) <> 0 Then Exit Function
        If D <= 0 Then
            GdipAddPathRectangleI p, X, Y, W, H
        Else
            GdipAddPathArcI p, X, Y, D, D, 180, 90
            GdipAddPathArcI p, X + W - D, Y, D, D, 270, 90
            GdipAddPathArcI p, X + W - D, Y + H - D, D, D, 0, 90
            GdipAddPathArcI p, X, Y + H - D, D, D, 90, 90
            GdipClosePathFigure p
        End If
        RoundPath = p
    End Function

    ' Dibuja sombra + fondo + borde con GDI+ sobre hDC (W x H, coordenadas de la sombra).
    Private Sub RenderShape(ByVal hDC As LongPtr, ByVal W As Long, ByVal H As Long)
        Dim g As LongPtr, pth As LongPtr, ps As LongPtr
        Dim br As LongPtr, pn As LongPtr
        Dim I As Long, D As Long, S As Long, k As Long
        Dim ox As Long, oy As Long
        Dim px0 As Long, py0 As Long, pw As Long, ph As Long
        Dim dAlpha As Double, lA As Long
        Dim hHole As LongPtr

        If GdipCreateFromHDC(hDC, g) <> 0 Then Exit Sub
        GdipSetSmoothingMode g, SmoothingModeAntiAlias

        I = Px(m_Margin) + Px(m_BorderWidth) \ 2
        D = Px(m_BorderRadius)
        px0 = m_dx - I: py0 = m_dy - I
        pw = m_tW + I * 2: ph = m_tH + I * 2
        pth = RoundPath(px0, py0, pw, ph, D)

        ' Sombra: capas concentricas cuya opacidad acumulada en el borde de la
        ' figura es ShadowOpacity y cae hasta 0 en ShadowSize*2.
        S = Px(m_ShadowSize * 2)
        If S > 0 And m_ShadowOpacity > 0 And pth <> 0 Then
            ox = Px(m_ShadowOffsetX): oy = Px(m_ShadowOffsetY)
            GdipSetClipPath g, pth, CombineModeExclude
            dAlpha = 1 - (1 - m_ShadowOpacity / 100#) ^ (1 / S)
            lA = CLng(dAlpha * 100)
            If lA < 1 Then lA = 1
            For k = S To 1 Step -1
                ps = RoundPath(px0 + ox - k, py0 + oy - k, pw + k * 2, ph + k * 2, D + k * 2)
                If ps <> 0 Then
                    GdipCreateSolidFill ARGB(m_ShadowColor, lA), br
                    GdipFillPath g, br, ps
                    GdipDeleteBrush br
                    GdipDeletePath ps
                End If
            Next
            GdipResetClip g
        End If

        ' Fondo (franja Margin) y borde, sin pintar encima de la ventana destino
        If pth <> 0 Then
            hHole = TargetRegion()
            GdipSetClipHrgn g, hHole, CombineModeExclude
            DeleteObject hHole
            If m_BackColorOpacity > 0 Then
                GdipCreateSolidFill ARGB(m_BackColor, m_BackColorOpacity), br
                GdipFillPath g, br, pth
                GdipDeleteBrush br
            End If
            GdipResetClip g
            If m_BorderWidth > 0 And m_BorderOpacity > 0 Then
                GdipCreatePen1 ARGB(m_BorderColor, m_BorderOpacity), Px(m_BorderWidth), UnitPixel, pn
                GdipDrawPath g, pn, pth
                GdipDeletePen pn
            End If
            GdipDeletePath pth
        End If
        GdipDeleteGraphics g
    End Sub

    ' Crea un DIB de 32 bits (W x H) seleccionado en un DC nuevo.
    Private Function CreateDIB32(ByVal W As Long, ByVal H As Long, ByRef hMemDC As LongPtr, ByRef hOldBmp As LongPtr) As LongPtr
        Dim bi As BITMAPINFOHEADER
        Dim pBits As LongPtr
        bi.biSize = 40
        bi.biWidth = W
        bi.biHeight = -H
        bi.biPlanes = 1
        bi.biBitCount = 32
        hMemDC = CreateCompatibleDC(0)
        CreateDIB32 = CreateDIBSection(hMemDC, bi, 0, pBits, 0, 0)
        hOldBmp = SelectObject(hMemDC, CreateDIB32)
    End Function

    ' Sombra de ventana de nivel superior: ventana capa con alfa por pixel.
    ' lMode = 1: ademas pinta hBmp en el hueco de la ventana destino (DrawBitmap).
    Private Sub RenderLayered(ByVal hBmp As LongPtr, ByVal bW As Long, ByVal bH As Long, ByVal lMode As Long)
        Dim W As Long, H As Long
        Dim hMemDC As LongPtr, hDIB As LongPtr, hOld As LongPtr
        Dim ptDst As POINTAPI, ptSrc As POINTAPI, sz As SIZEAPI
        Dim bf As BLENDFUNCTION
        Dim g As LongPtr, img As LongPtr, hHole As LongPtr

        If m_hShadow = 0 Or m_bChild Then Exit Sub
        W = m_rcShadow.Right - m_rcShadow.Left
        H = m_rcShadow.Bottom - m_rcShadow.Top
        If W <= 0 Or H <= 0 Then Exit Sub

        hDIB = CreateDIB32(W, H, hMemDC, hOld)
        If hDIB = 0 Then
            DeleteDC hMemDC
            Exit Sub
        End If
        RenderShape hMemDC, W, H

        If lMode = 1 And hBmp <> 0 Then
            If GdipCreateFromHDC(hMemDC, g) = 0 Then
                hHole = TargetRegion()
                GdipSetClipHrgn g, hHole, CombineModeIntersect
                DeleteObject hHole
                If GdipCreateBitmapFromHBITMAP(hBmp, 0, img) = 0 Then
                    GdipDrawImageRectRectI g, img, m_dx, m_dy, bW, bH, 0, 0, bW, bH, UnitPixel, 0, 0, 0
                    GdipDisposeImage img
                End If
                GdipDeleteGraphics g
            End If
        End If

        ptDst.X = m_rcShadow.Left: ptDst.Y = m_rcShadow.Top
        sz.cx = W: sz.cy = H
        bf.SourceConstantAlpha = 255
        bf.AlphaFormat = AC_SRC_ALPHA
        UpdateLayeredWindow m_hShadow, 0, ptDst, sz, hMemDC, ptSrc, 0, bf, ULW_ALPHA

        SelectObject hMemDC, hOld
        DeleteObject hDIB
        DeleteDC hMemDC
    End Sub

    ' Sombra hija: se pinta en WM_PAINT sobre el fondo del contenedor.
    Private Sub PaintChild()
        Dim ps As PAINTSTRUCT
        Dim hDC As LongPtr, hMemDC As LongPtr, hDIB As LongPtr, hOld As LongPtr
        Dim W As Long, H As Long
        Dim rc As RECT
        Dim hBr As LongPtr, lBk As Long, hParentDC As LongPtr

        hDC = BeginPaint(m_hShadow, ps)
        W = m_rcShadow.Right - m_rcShadow.Left
        H = m_rcShadow.Bottom - m_rcShadow.Top
        If W > 0 And H > 0 Then
            hDIB = CreateDIB32(W, H, hMemDC, hOld)
            If hDIB <> 0 Then
                rc.Right = W: rc.Bottom = H
                If m_ContainerBkColor <> CLR_NONE Then
                    lBk = m_ContainerBkColor
                    If (lBk And &H80000000) <> 0 Then lBk = GetSysColor(lBk And &HFF&)
                    hBr = CreateSolidBrush(lBk)
                    FillRect hMemDC, rc, hBr
                    DeleteObject hBr
                ElseIf DrawThemeParentBackground(m_hShadow, hMemDC, 0) <> 0 Then
                    ' el contenedor no pinta su fondo: usar su color de fondo de DC
                    hParentDC = GetDC(GetParent(m_hShadow))
                    lBk = GetBkColor(hParentDC)
                    ReleaseDC GetParent(m_hShadow), hParentDC
                    hBr = CreateSolidBrush(lBk)
                    FillRect hMemDC, rc, hBr
                    DeleteObject hBr
                End If
                RenderShape hMemDC, W, H
                BitBlt hDC, 0, 0, W, H, hMemDC, 0, 0, vbSrcCopy
                SelectObject hMemDC, hOld
                DeleteObject hDIB
            End If
            DeleteDC hMemDC
        End If
        EndPaint m_hShadow, ps
    End Sub

    '==========================================================================
    ' Mensajes (llamado desde mUcListHelpers.UCL_ShadowProc)
    '==========================================================================
    Public Function zzWndProc(ByVal hWnd As LongPtr, ByVal uMsg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr
        Dim lFlags As Long
        Dim lPtr As Long

        If hWnd = m_hShadow And m_hShadow <> 0 Then
            Select Case uMsg
                Case WM_PAINT
                    If m_bChild Then
                        PaintChild
                        Exit Function
                    End If
                Case WM_ERASEBKGND
                    zzWndProc = 1
                    Exit Function
                Case WM_NCHITTEST
                    zzWndProc = HTTRANSPARENT
                    Exit Function
                Case WM_MOUSEACTIVATE
                    zzWndProc = MA_NOACTIVATE
                    Exit Function
                Case WM_NCDESTROY
                    zzWndProc = UCL_DefProc(hWnd, uMsg, wParam, lParam)
                    UCL_UnsubclassShadow hWnd, ObjPtr(Me)
                    m_hShadow = 0
                    Exit Function
            End Select

        ElseIf hWnd = m_hTarget And m_hTarget <> 0 Then
            Select Case uMsg
                Case WM_WINDOWPOSCHANGED
                    zzWndProc = UCL_DefProc(hWnd, uMsg, wParam, lParam)
                    If lParam <> 0 And m_hShadow <> 0 Then
                        ' WINDOWPOS: hwnd, hwndInsertAfter, x, y, cx, cy, flags
                        lPtr = LenB(lParam)
                        CopyFlags lFlags, lParam + lPtr * 2 + 16
                        If (lFlags And SWP_HIDEWINDOW) <> 0 Then
                            ShowWindow m_hShadow, SW_HIDE
                        ElseIf m_bShown Then
                            If (lFlags And SWP_SHOWWINDOW) <> 0 Then
                                Reposition True
                            ElseIf (lFlags And (SWP_NOMOVE Or SWP_NOSIZE)) <> (SWP_NOMOVE Or SWP_NOSIZE) Or (lFlags And SWP_NOZORDER) = 0 Then
                                Reposition (IsWindowVisible(m_hShadow) <> 0)
                            End If
                        End If
                    End If
                    Exit Function
                Case WM_DESTROY
                    zzWndProc = UCL_DefProc(hWnd, uMsg, wParam, lParam)
                    Detach
                    Exit Function
                Case WM_NCDESTROY
                    zzWndProc = UCL_DefProc(hWnd, uMsg, wParam, lParam)
                    UCL_UnsubclassShadow hWnd, ObjPtr(Me)
                    m_hTarget = 0
                    Exit Function
            End Select
        End If

        zzWndProc = UCL_DefProc(hWnd, uMsg, wParam, lParam)
    End Function

    Private Sub CopyFlags(ByRef lFlags As Long, ByVal pAddr As LongPtr)
        CopyMemoryAny lFlags, pAddr, 4
    End Sub


End Class
