[Description("")]
[FormDesignerId("9DB1B47A-FFD5-5276-BDDF-63F266ABFB10")]
[PredeclaredId]
Class FrmDragDrop

    Option Explicit

    Private Declare PtrSafe Function OleTranslateColor Lib "oleaut32" (ByVal lOleColor As Long, ByVal lHPalette As LongPtr, ByRef lColorRef As Long) As Long
    Private Declare PtrSafe Function CreatePen Lib "gdi32" (ByVal nPenStyle As Long, ByVal nWidth As Long, ByVal crColor As Long) As LongPtr
    Private Declare PtrSafe Function MoveToEx Lib "gdi32" (ByVal hDC As LongPtr, ByVal X As Long, ByVal Y As Long, ByVal lpPoint As LongPtr) As Long
    Private Declare PtrSafe Function DeleteObject Lib "gdi32" (ByVal hObject As LongPtr) As Long
    Private Declare PtrSafe Function SelectObject Lib "gdi32" (ByVal hDC As LongPtr, ByVal hObject As LongPtr) As LongPtr
    Private Declare PtrSafe Function LineTo Lib "gdi32" (ByVal hDC As LongPtr, ByVal X As Long, ByVal Y As Long) As Long
    Private Declare PtrSafe Function Polygon Lib "gdi32" (ByVal hDC As LongPtr, ByRef lpPoint As POINTAPI, ByVal nCount As Long) As Long
    Private Declare PtrSafe Function CreateSolidBrush Lib "gdi32" (ByVal crColor As Long) As LongPtr

    Private Type POINTAPI
        X As Long
        Y As Long
    End Type

    Private DragPos1 As Long
    Private DragPos2 As Long
    Private CtlID As Long

    ' Propiedades de diseno de los ucList (en VB6 estaban en el .frm).
    Private Sub ApplyDesignProperties()
        With ucList1
            .ListStyle = StyleListBox
            .FindTextColor = vbHighlight
            .LineColor = 13487565
        End With
        With ucList2
            .ListStyle = StyleListBox
            .FindTextColor = vbHighlight
            .LineColor = 13487565
        End With
    End Sub

    Private Sub Form_Load()
        ApplyDesignProperties

        ucList1.AddItem "James"
        ucList1.AddItem "Frederick"
        ucList1.AddItem "Ann"
        ucList1.AddItem "Paul"
        ucList1.AddItem "Sarah"
        ucList1.OLEDropMode = OLEDropModeManual
        ucList2.OLEDropMode = OLEDropModeManual
        ucList1.Update
        DragPos1 = -2
        DragPos2 = -2
    End Sub

    Private Sub ucList1_ItemCustomDraw(Index As Long, ByVal hdc As LongPtr, Left As Long, Top As Long, Width As Long, Height As Long) Handles ucList1.ItemCustomDraw
        If Not CtlID = 1 Then
            If DragPos1 = -1 And Index = ucList1.ListCount - 1 Then
                DrawLine hdc, 0, Top + Height, Width - 2, Top + Height, vbRed, 1
            ElseIf Index = DragPos1 Then
                DrawLine hdc, 0, Top, Width - 2, Top, vbRed, 1
            End If
        End If
    End Sub

    Private Sub ucList1_MouseDown(Button As Integer, Shift As Integer, X As Single, Y As Single) Handles ucList1.MouseDown
        If ucList1.ListIndex = -1 Then Exit Sub
        ucList1.OLEDrag
    End Sub

    Private Sub ucList1_OLEDragOver(Data As DataObject, Effect As Long, Button As Integer, Shift As Integer, X As Single, Y As Single, State As Integer) Handles ucList1.OLEDragOver
        If State = vbLeave Then
            DragPos1 = -2
        Else
            DragPos1 = ucList1.ItemHitest(Y / Screen.TwipsPerPixelY)
        End If
        ucList1.Refresh
    End Sub

    Private Sub ucList1_OLEStartDrag(Data As DataObject, AllowedEffects As Long) Handles ucList1.OLEStartDrag
        AllowedEffects = vbDropEffectMove
        CtlID = 1
        DragPos2 = -2
        Data.SetData ucList1.Text
    End Sub

    Private Sub ucList2_ItemCustomDraw(Index As Long, ByVal hdc As LongPtr, Left As Long, Top As Long, Width As Long, Height As Long) Handles ucList2.ItemCustomDraw
        If Not CtlID = 2 Then
            If DragPos2 = -1 And Index = ucList2.ListCount - 1 Then
                DrawLine hdc, 0, Top + Height, Width - 2, Top + Height, vbRed, 1
            ElseIf Index = DragPos2 Then
                DrawLine hdc, 0, Top, Width - 2, Top, vbRed, 1
            End If
        End If
    End Sub

    Private Sub ucList2_OLEDragDrop(Data As DataObject, Effect As Long, Button As Integer, Shift As Integer, X As Single, Y As Single) Handles ucList2.OLEDragDrop
        Dim strList As String
        If Not Data.GetFormat(vbCFText) Then Exit Sub
        strList = Data.GetData(vbCFText)
        If Not CtlID = 2 Then

            ucList2.AddItem strList, , , , , , DragPos2
            DragPos2 = -2
            ucList2.Update
            ucList1.RemoveItem ucList1.ListIndex
            ucList1.Update
        End If
    End Sub

    Private Sub ucList2_OLEDragOver(Data As DataObject, Effect As Long, Button As Integer, Shift As Integer, X As Single, Y As Single, State As Integer) Handles ucList2.OLEDragOver
        If State = vbLeave Then
            DragPos2 = -2
        Else
            DragPos2 = ucList2.ItemHitest(Y / Screen.TwipsPerPixelY)
        End If
        ucList2.Refresh
    End Sub

    Private Sub ucList2_MouseDown(Button As Integer, Shift As Integer, X As Single, Y As Single) Handles ucList2.MouseDown
        If ucList2.ListIndex = -1 Then Exit Sub
        ucList2.OLEDrag    ' Comienza el arrastre
    End Sub

    Private Sub ucList2_OLEStartDrag(Data As DataObject, AllowedEffects As Long) Handles ucList2.OLEStartDrag
        ' Solo permitir mover
        AllowedEffects = vbDropEffectMove
        CtlID = 2
        DragPos1 = -2
        Data.SetData ucList2.Text
    End Sub

    Private Sub ucList1_OLEDragDrop(Data As DataObject, Effect As Long, Button As Integer, Shift As Integer, X As Single, Y As Single) Handles ucList1.OLEDragDrop
        Dim strList As String
        ' Comprobar el formato del DataObject
        If Not Data.GetFormat(vbCFText) Then Exit Sub
        ' Obtener el texto del DataObject
        strList = Data.GetData(vbCFText)
        ' Si el elemento no se solto sobre si mismo
        If Not CtlID = 1 Then
            ucList1.AddItem strList, , , , , , DragPos1
            DragPos1 = -2
            ucList1.Update
            ' Quitar el elemento de la otra lista
            ucList2.RemoveItem ucList2.ListIndex
            ucList2.Update
        End If
    End Sub

    Public Sub DrawLine(ByVal lHdc As LongPtr, _
                        ByVal X1 As Long, _
                        ByVal Y1 As Long, _
                        ByVal X2 As Long, _
                        ByVal Y2 As Long, _
                        Optional ByVal Color As Long = -1, _
                        Optional ByVal BorderWidth As Long = 1)

        Dim hPen As LongPtr, hBrush As LongPtr
        Dim TransColor As Long
        Dim OldPen As LongPtr, OldBrush As LongPtr
        Dim PT(2) As POINTAPI

        Call OleTranslateColor(Color, 0, TransColor)
        hPen = CreatePen(0, BorderWidth, TransColor)
        hBrush = CreateSolidBrush(TransColor)

        OldPen = SelectObject(lHdc, hPen)
        OldBrush = SelectObject(lHdc, hBrush)

        If X1 >= 0 Then
            MoveToEx lHdc, X1, Y1, 0
        End If

        LineTo lHdc, X2, Y2

        PT(0).X = 0: PT(0).Y = Y1 - 3
        PT(1).X = 0: PT(1).Y = Y1 + 3
        PT(2).X = 3: PT(2).Y = Y1

        Polygon lHdc, PT(0), 3

        PT(0).X = X2: PT(0).Y = Y1 - 3
        PT(1).X = X2: PT(1).Y = Y1 + 3
        PT(2).X = X2 - 3: PT(2).Y = Y1

        Polygon lHdc, PT(0), 3

        DeleteObject SelectObject(lHdc, OldPen)
        DeleteObject SelectObject(lHdc, OldBrush)

    End Sub

End Class
